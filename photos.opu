// Photo wall: five generated gradient images, one enlarged at a time.
// Next/Prev switch the selected image by setting string/int state and
// mutually exclusive bool gates; the software raster draws Image as a
// gradient placeholder (it does not decode PNG resources).
component Nav(label: string, t: string, src: string, n: int, b1: bool, b2: bool, b3: bool, b4: bool, b5: bool) {
  Button(label, p: 12, rounded: 12, shadow: 2, bg: "#097FEB",
         fontScale: 1.1, animate: spring) {
    title = t
    hero = src
    sel = n
    s1 = b1
    s2 = b2
    s3 = b3
    s4 = b4
    s5 = b5
  }
}

app PhotoWall {
  theme { accent: "#097FEB", radius: 14 }

  state title = "Dawn"
  state hero = "assets/photo1.png"
  state sel = 1
  state s1 = true
  state s2 = false
  state s3 = false
  state s4 = false
  state s5 = false

  // Scroll keeps children at natural size and clips, so compact frames
  // show a clean top slice instead of squeezing the whole layout.
  Scroll(height: 640, bg: "#EDF2FA", border: "#EDF2FA", rounded: 14, animate: ease) {
  Column(p: 18, gap: 14, width: 800) {
    Container(p: 22, rounded: 18, shadow: 4, gradient: "#097FEB,#043B70", animate: ease) {
      Text("OPUROM Photo Wall", size: 22, color: "#FFFFFF")
      Text("Selected: {title} - photo {sel} of 5", size: 12, color: "#D6E8FF")
    }
    Card(p: 10, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2", animate: ease) {
      Column(gap: 10, align: center) {
        if (s1) {
          Image(src: "assets/photo1.png", width: 360, height: 270, gradient: "#FFBE5A,#D6486E", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s2) {
          Image(src: "assets/photo2.png", width: 360, height: 270, gradient: "#40E0D0,#0B488C", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s3) {
          Image(src: "assets/photo3.png", width: 360, height: 270, gradient: "#A878FF,#242060", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s4) {
          Image(src: "assets/photo4.png", width: 360, height: 270, gradient: "#7EE896,#0C4060", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s5) {
          Image(src: "assets/photo5.png", width: 360, height: 270, gradient: "#FF7848,#781C40", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        Text("{title}", size: 20, color: "#101828")
      }
    }
    Container(p: 14, rounded: 14, shadow: 3, bg: "#F4F7FB") {
      Text("Gallery", size: 15, color: "#101828")
      Row(gap: 10, bg: "#F4F7FB") {
        Image(src: "assets/photo1.png", width: 112, height: 84, gradient: "#FFBE5A,#D6486E", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
        Image(src: "assets/photo2.png", width: 112, height: 84, gradient: "#40E0D0,#0B488C", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
        Image(src: "assets/photo3.png", width: 112, height: 84, gradient: "#A878FF,#242060", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
        Image(src: "assets/photo4.png", width: 112, height: 84, gradient: "#7EE896,#0C4060", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
        Image(src: "assets/photo5.png", width: 112, height: 84, gradient: "#FF7848,#781C40", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
      }
    }
    Row(gap: 10) {
      if (s1) {
        Nav("Prev", "Bloom", "assets/photo5.png", 5, false, false, false, false, true)
        Nav("Next", "Tide", "assets/photo2.png", 2, false, true, false, false, false)
      }
      if (s2) {
        Nav("Prev", "Dawn", "assets/photo1.png", 1, true, false, false, false, false)
        Nav("Next", "Dunes", "assets/photo3.png", 3, false, false, true, false, false)
      }
      if (s3) {
        Nav("Prev", "Tide", "assets/photo2.png", 2, false, true, false, false, false)
        Nav("Next", "Lattice", "assets/photo4.png", 4, false, false, false, true, false)
      }
      if (s4) {
        Nav("Prev", "Dunes", "assets/photo3.png", 3, false, false, true, false, false)
        Nav("Next", "Bloom", "assets/photo5.png", 5, false, false, false, false, true)
      }
      if (s5) {
        Nav("Prev", "Lattice", "assets/photo4.png", 4, false, false, false, true, false)
        Nav("Next", "Dawn", "assets/photo1.png", 1, true, false, false, false, false)
      }
    }
    Text("Use Prev and Next to change the enlarged photo", size: 12, color: "#667085")
  }
  }
}
