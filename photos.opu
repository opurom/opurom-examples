// Photo wall: five generated gradient images, one enlarged at a time.
// Next/Prev switch the selected image by setting string/int state and
// mutually exclusive bool gates; the software raster draws Image as a
// gradient placeholder (it does not decode PNG resources).
import "pkg-theme/default.opu";
import "components/empty_state.opu";
import "components/skeleton.opu";
import "components/banner.opu";

// Flutter photo apps show a placeholder while the images load, a message when
// the list is empty and an error banner when the fetch fails. Source:
// flutter-samples/desktop_photo_search/material/lib/src/model/photo_search_model.dart:33-46
// (async search fills the list, then notifies) and
// flutter-samples/desktop_photo_search/material/lib/src/widgets/unsplash_search_content.dart:47-74
// (empty selection renders a placeholder container instead of content).
// Pure display: business state updates live in each use-site block (lang
// 4994b47 adopts them into the tap handler; no callbacks needed).
component Nav(label: string) {
  Button(label, p: 12, rounded: 12, shadow: 2, bg: "#097FEB",
         fontScale: 1.1, animate: spring, gesture: "tap") {}
}

app PhotoWall {
  state title = "Dawn"
  state hero = "assets/photo1.png"
  state sel = 1
  state s1 = true
  state s2 = false
  state s3 = false
  state s4 = false
  state s5 = false
  // Three states of the photo list: loading before the assets resolve, empty
  // when nothing was picked and error when the source folder is unreadable.
  state loading: bool = false
  state empty: bool = false
  state failed: bool = false
  // Mutually exclusive gate for the loaded, non-empty, non-failed grid.
  state idle: bool = true

  // Scroll keeps children at natural size and clips, so compact frames
  // show a clean top slice instead of squeezing the whole layout.
  Scroll(height: 640, bg: "#F9FAFB", border: "#F9FAFB", rounded: 14, animate: ease) {
  Column(p: 18, gap: 14, width: 800) {
    Container(p: 22, rounded: 18, shadow: 4, gradient: "#097FEB,#005FCC", animate: ease) {
      Text("Opurom Photo Wall", size: 22, color: "#FFFFFF")
      Text("Selected: {title} - photo {sel} of 5", size: 12, color: "#FFFFFF")
    }
    Card(p: 10, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2", animate: ease) {
      Column(gap: 10, align: center) {
        if (s1) {
          Image(src: "assets/photo1.png", width: 360, height: 270, gradient: "#FFBE5A,#D6486E", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s2) {
          Image(src: "assets/photo2.png", width: 360, height: 270, gradient: "#40E0D0,#0B488C", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s3) {
          Image(src: "assets/photo3.png", width: 360, height: 270, gradient: "#A878FF,#242060", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s4) {
          Image(src: "assets/photo4.png", width: 360, height: 270, gradient: "#7EE896,#0C4060", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        if (s5) {
          Image(src: "assets/photo5.png", width: 360, height: 270, gradient: "#FF7848,#781C40", rounded: 14, shadow: 2, animate: ease, label: "media/Image")
        }
        Text("{title}", size: 20, color: "#111827")
      }
    }
    Container(p: 14, rounded: 14, shadow: 3, bg: "#F9FAFB") {
      Text("Gallery", size: 15, color: "#111827")
      if (failed) {
        Banner("Cannot read the photo folder", "The gallery source is not readable on this device", "error")
      }
      if (loading) {
        Skeleton(112, 84)
        Skeleton(112, 84)
      }
      if (empty) {
        EmptyState("folder", "No photos yet", "Add images to the gallery folder to see them here")
      }
      if (idle) {
        Row(gap: 10, bg: "#F9FAFB") {
          Image(src: "assets/photo1.png", width: 112, height: 84, gradient: "#FFBE5A,#D6486E", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
          Image(src: "assets/photo2.png", width: 112, height: 84, gradient: "#40E0D0,#0B488C", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
          Image(src: "assets/photo3.png", width: 112, height: 84, gradient: "#A878FF,#242060", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
          Image(src: "assets/photo4.png", width: 112, height: 84, gradient: "#7EE896,#0C4060", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
          Image(src: "assets/photo5.png", width: 112, height: 84, gradient: "#FF7848,#781C40", rounded: 10, shadow: 2, animate: ease, label: "media/Image")
        }
      }
    }
    Row(gap: 10) {
      if (s1) {
        Nav("Prev") { title = "Bloom"; hero = "assets/photo5.png"; sel = 5; s1 = false; s2 = false; s3 = false; s4 = false; s5 = true }
        Nav("Next") { title = "Tide"; hero = "assets/photo2.png"; sel = 2; s1 = false; s2 = true; s3 = false; s4 = false; s5 = false }
      }
      if (s2) {
        Nav("Prev") { title = "Dawn"; hero = "assets/photo1.png"; sel = 1; s1 = true; s2 = false; s3 = false; s4 = false; s5 = false }
        Nav("Next") { title = "Dunes"; hero = "assets/photo3.png"; sel = 3; s1 = false; s2 = false; s3 = true; s4 = false; s5 = false }
      }
      if (s3) {
        Nav("Prev") { title = "Tide"; hero = "assets/photo2.png"; sel = 2; s1 = false; s2 = true; s3 = false; s4 = false; s5 = false }
        Nav("Next") { title = "Lattice"; hero = "assets/photo4.png"; sel = 4; s1 = false; s2 = false; s3 = false; s4 = true; s5 = false }
      }
      if (s4) {
        Nav("Prev") { title = "Dunes"; hero = "assets/photo3.png"; sel = 3; s1 = false; s2 = false; s3 = true; s4 = false; s5 = false }
        Nav("Next") { title = "Bloom"; hero = "assets/photo5.png"; sel = 5; s1 = false; s2 = false; s3 = false; s4 = false; s5 = true }
      }
      if (s5) {
        Nav("Prev") { title = "Lattice"; hero = "assets/photo4.png"; sel = 4; s1 = false; s2 = false; s3 = false; s4 = true; s5 = false }
        Nav("Next") { title = "Dawn"; hero = "assets/photo1.png"; sel = 1; s1 = true; s2 = false; s3 = false; s4 = false; s5 = false }
      }
    }
    Text("Use Prev and Next to change the enlarged photo", size: 12, color: "#667085")
  }
  }
}
