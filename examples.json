{
  "version": 1,
  "apps": [
    {
      "name": "counter",
      "source": "counter.opu",
      "required": true,
      "targets": [
        "web",
        "native"
      ],
      "tests": [
        {
          "id": "counter.check",
          "cmd": [
            "opuromc",
            "check",
            "{source}"
          ],
          "description": "type-check the source with opuromc"
        },
        {
          "id": "counter.compile",
          "cmd": [
            "opuromc",
            "compile",
            "{source}",
            "-o",
            "{tmp}/app.opuir.json"
          ],
          "description": "compile the source to IR in a temp dir"
        },
        {
          "id": "counter.render",
          "cmd": [
            "opurom-render",
            "{tmp}/app.opuir.json",
            "320",
            "240",
            "{tmp}/frame.ppm"
          ],
          "description": "render the compiled IR to a PPM frame"
        }
      ]
    },
