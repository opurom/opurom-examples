// Deterministic entry animation: the same tick always yields the same frame.
import "pkg-theme/default.opu";

app Animation {

  ScrollView(p: 16) {
    Column(gap: 14, align: center) {
      Container(p: 20, rounded: 18, shadow: 4, gradient: "#097FEB,#005FCC", animate: ease) {
        Text("Animation", size: 22, color: "#FFFFFF")
        Text("Spring, ease and static share one fixed-timestep clock", size: 11, color: "#FFFFFF")
      }
      Container(width: 260, height: 58, p: 14, rounded: 14, shadow: 3,
                gradient: "#097FEB,#005FCC", bg: "#005FCC", animate: spring) {
        Text("spring", size: 18, color: "#FFFFFF")
      }
      Container(width: 260, height: 58, p: 14, rounded: 14, shadow: 3,
                gradient: "#097FEB,#005FCC", bg: "#097FEB", animate: ease) {
        Text("ease", size: 18, color: "#FFFFFF")
      }
      Container(width: 260, height: 58, p: 14, rounded: 14, shadow: 3,
                gradient: "#101828,#101828", bg: "#111827", animate: none) {
        Text("static", size: 18, color: "#FFFFFF")
      }
    }
  }
}
