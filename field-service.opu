// Full-stack field-service board: UI, data model and HTTP API in one source file.
// The same IR adapts to phone and tablet widths: the header Row collapses to a
// column on compact viewports and the task Grid reflows its fluid columns.
import "pkg-theme/default.opu";
// The task list is served by /tasks; show loading, empty and error states for
// its async fetch, as Flutter's photo search sample does around its model:
// flutter-samples/desktop_photo_search/material/lib/src/model/photo_search_model.dart:33-46.
import "components/empty_state.opu";
import "components/skeleton.opu";
import "components/banner.opu";

app FieldService {
  model Task {
    id: int primary
    title: string
    done: bool = false
  }

  api "/tasks" {
    list Task
    create Task
  }

  api "/tasks/:id" {
    get Task
    update Task
    delete Task
  }

  state open = 3
  state crew = "Rivera"
  state dark = false
  // Mutually exclusive boundary states for the /tasks list.
  state loading: bool = false
  state empty: bool = false
  state failed: bool = false

  computed remaining = open * 2


  ScrollView(p: 14) {
    Column(gap: 12) {
      Container(p: 16, rounded: 18, shadow: 4, bg: "#0B3E86", animate: ease) {
        Row(gap: 10, align: center, bg: "#0B3E86") {
          Avatar(label: "R")
          Column(gap: 2, bg: "#0B3E86") {
            Text("Field Service", size: 20, color: "#FFFFFF")
            Text("Crew {crew} - open cases: {open}", size: 11, color: "#FFFFFF")
          }
          Spacer(width: 8)
          Badge(label: "{remaining} due")
          Switch(bind: dark)
        }
      }

      Container(p: 12, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
        Progress(value: 3)
      }

      Grid(columns: 2) {
        Card(p: 12, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
          Text("triage", size: 15, color: "#111827")
        }
        Card(p: 12, rounded: 14, shadow: 3, bg: "#F9FAFB") {
          Text("dispatch", size: 15, color: "#111827")
        }
        Card(p: 12, rounded: 14, shadow: 3, bg: "#F9FAFB") {
          Text("close", size: 15, color: "#111827")
        }
        Card(p: 12, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
          Text("review", size: 15, color: "#111827")
        }
      }

      Container(p: 12, rounded: 16, shadow: 3, bg: "#F9FAFB") {
        Row(gap: 10, bg: "#F9FAFB") {
          Button("Dispatch crew", p: 12, rounded: 12, shadow: 2, bg: "#097FEB",
                 fontScale: 1.1, animate: spring) {
            open += 1
          }
        }
      }

      if (dark) {
        Container(p: 14, rounded: 14, shadow: 3, bg: "#111827", animate: ease) {
          Text("Night shift active for {crew}", size: 15, color: "#FFFFFF")
        }
      }

      // Boundary states of the task board.
      if (loading) {
        Skeleton(240, 20)
        Skeleton(240, 20)
      }
      if (empty) {
        EmptyState("folder", "No open cases", "New assignments appear here when dispatched")
      }
      if (failed) {
        Banner("Tasks unavailable", "The task service did not answer the last request", "error")
      }
    }
  }
}
