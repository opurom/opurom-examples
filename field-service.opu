// Full-stack field-service board: UI, data model and HTTP API in one source file.
// The same IR adapts to phone and tablet widths: the header Row collapses to a
// column on compact viewports and the task Grid reflows its fluid columns.
app FieldService {
  model Task {
    id: int primary
    title: string
    done: bool = false
  }

  api "/tasks" {
    list Task
    create Task
  }

  api "/tasks/:id" {
    get Task
    update Task
    delete Task
  }

  state open = 3
  state crew = "Rivera"
  state dark = false

  computed remaining = open * 2

  theme { accent: "#097FEB", radius: 14, fontScale: 1.0 , stage: "#EDF0F7" }

  ScrollView(p: 14) {
    Column(gap: 12) {
      Container(p: 16, rounded: 18, shadow: 4, bg: "#0B3E86", animate: ease) {
        Row(gap: 10, align: center, bg: "#0B3E86") {
          Avatar(label: "R")
          Column(gap: 2, bg: "#0B3E86") {
            Text("Field Service", size: 20, color: "#FFFFFF")
            Text("Crew {crew} - open cases: {open}", size: 11, color: "#D6E8FF")
          }
          Spacer(width: 8)
          Badge(label: "{remaining} due")
          Switch(bind: dark)
        }
      }

      Container(p: 12, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
        Progress(value: 3)
      }

      Grid(columns: 2) {
        Card(p: 12, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
          Text("triage", size: 15, color: "#101828")
        }
        Card(p: 12, rounded: 14, shadow: 3, bg: "#F4F7FB") {
          Text("dispatch", size: 15, color: "#101828")
        }
        Card(p: 12, rounded: 14, shadow: 3, bg: "#F4F7FB") {
          Text("close", size: 15, color: "#101828")
        }
        Card(p: 12, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
          Text("review", size: 15, color: "#101828")
        }
      }

      Container(p: 12, rounded: 16, shadow: 3, bg: "#F4F7FB") {
        Row(gap: 10, bg: "#F4F7FB") {
          Button("Dispatch crew", p: 12, rounded: 12, shadow: 2, bg: "#097FEB",
                 fontScale: 1.1, animate: spring) {
            open += 1
          }
        }
      }

      if (dark) {
        Container(p: 14, rounded: 14, shadow: 3, bg: "#101828", animate: ease) {
          Text("Night shift active for {crew}", size: 15, color: "#FFFFFF")
        }
      }
    }
  }
}
