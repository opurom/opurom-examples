// Dashboard presentation state and the shared palette. An imported module may
// declare only state, model, api, theme and imports, so the components that
// use these values live in the importing entry file.
// md-sys-color-primary
// md-shape-large = 16dp -> 48px; card radius 36px set per page spec
theme { mode: light, accent: "#6200EE", radius: 36, fontScale: 1.0 }

model ServiceTarget {
  id: int primary
  region: string
  healthy: bool = true
}

api "/dashboard/services" {
  list ServiceTarget
}

state liveFeed = "live"
state incidents = 2
state scalingEnabled = true
