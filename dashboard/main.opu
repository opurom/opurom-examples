// Standardized Material 3 Telemetry Console dashboard.
import "models/metrics.opu";
import "views/cards.opu";
// Telemetry lists need the three boundary states Flutter's Material widgets
// expect: a loading skeleton, an empty placeholder and an error notice.
// Source: flutter-samples/desktop_photo_search/material/lib/src/model/photo_search_model.dart:33-46,
// widgets/unsplash_search_content.dart:47-74.
import "components/empty_state.opu";
import "components/skeleton.opu";
import "components/banner.opu";

component KpiCard(label: string, metric: string, delta: string, icon: string, tone: string) {
  // md-sys-color-surface-container-low; two-layer elevation = gap M2
  Card(p: 48, rounded: 36, shadow: 1, bg: "#FFFFFF", border: "#FFFFFF") {
    Column(gap: 12, bg: "#FFFFFF") {
      // md-sys-color-on-surface-variant
      Text("{label}", size: 36, fontPx: 36, weight: "normal", color: "#000000", label: "dash/kpi_label")
      // md-sys-color-on-surface
      Text("{metric}", size: 72, fontPx: 72, weight: "bold", color: "#000000", label: "dash/kpi_value")
      Row(gap: 12, align: start) {
        Icon(name: "{icon}", width: 33, height: 33, color: "{tone}", label: "dash/kpi_trend_icon")
        // md-sys-color-success / md-sys-color-error by tone
        Text("{delta}", size: 33, fontPx: 33, weight: "normal", color: "{tone}", label: "dash/kpi_delta")
      }
    }
  }
}

component StatusPill(text: string, tone: string) {
  Container(p: 12, rounded: 24, color: "{tone}", border: "{tone}") {
    Text("{text}", size: 33, fontPx: 33, weight: "normal", color: "#FFFFFF", label: "dash/status_pill")
  }
}

component ServiceRow(name: string, role: string, state: string, tone: string) {
  Column(gap: 12, bg: "#FFFFFF") {
    Row(gap: 24, align: center) {
      Container(width: 48, height: 48, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Icon(name: "server", width: 48, height: 48, color: "#000000", label: "dash/service_icon")
      }
      Column(gap: 6, bg: "#FFFFFF") {
        // md-sys-color-on-surface
        Text("{name}", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "dash/service_name")
        // md-sys-color-on-surface-variant
        Text("{role}", size: 33, fontPx: 33, weight: "normal", color: "#000000", opacity: 0.6, label: "dash/service_role")
      }
      Spacer(width: 120)
      StatusPill("{state}", "{tone}")
    }
    // md-sys-color-outline-variant
    Container(width: 984, height: 3, color: "#000000", border: "#000000", opacity: 0.12, p: 0)
  }
}

app Dashboard {
  state window = "24h"
  state autoscaling = true
  state alerts = true
  state load = 64
  state refreshed = 0
  // Mutually exclusive boundary states; default is the loaded dashboard.
  state loading: bool = false
  state empty: bool = false
  state failed: bool = false
  state idle: bool = true

  computed throughput = doneTasks - openTasks
  computed health = 100 - errorRate

  // md-sys-color-surface
  Container(width: 1080, height: 2400, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
    Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
      // md-sys-color-surface
      Container(width: 1080, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "arrow-left", width: 72, height: 72, color: "#000000", label: "dash/topbar_back")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "info-circle", width: 72, height: 72, color: "#000000", label: "dash/topbar_info")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "code", width: 72, height: 72, color: "#000000", label: "dash/topbar_code")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "devices", width: 72, height: 72, color: "#000000", label: "dash/topbar_devices")
            }
          }
          Spacer(width: 24)
          Container(width: 648, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Text("Telemetry Console", size: 66, fontPx: 66, weight: "bold", color: "#000000", label: "dash/title")
            }
          }
        }
      }
      Scroll(height: 2232) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          Container(width: 984, height: 2232, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-surface-container-low; two-layer elevation = gap M2
              Card(p: 48, rounded: 36, shadow: 1, bg: "#FFFFFF", border: "#FFFFFF", gesture: "tap") {
                Row(gap: 24, align: center) {
                  // md-sys-color-primary
                  Text("Filters", size: 42, fontPx: 42, weight: "bold", color: "#6200EE", label: "dash/filters")
                  Spacer(width: 180)
                  Switch(bind: autoscaling)
                  Switch(bind: alerts)
                }
              }
              // A4/overlay gap: bottom-sheet filter drawer is a static placeholder
              Spacer(height: 72)
              // md-sys-color-on-surface
              Text("Overview", size: 66, fontPx: 66, weight: "bold", color: "#000000", label: "dash/overview")
              Spacer(height: 36)
              Grid(columns: 2) {
                KpiCard("Requests", "{doneTasks}", "12%", "trending-up", "#386E38")
                KpiCard("Open", "{openTasks}", "4%", "trending-up", "#386E38")
                KpiCard("Errors", "{errorRate}", "2%", "trending-down", "#B00020")
                KpiCard("Health", "{health}", "steady", "activity", "#6200EE")
              }
              Spacer(height: 72)
              // md-sys-color-surface-container-low; two-layer elevation = gap M2
              Card(p: 48, rounded: 36, shadow: 1, bg: "#FFFFFF", border: "#FFFFFF") {
                Column(gap: 24, bg: "#FFFFFF") {
                  Text("Service status", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "dash/status_title")
                  // B2 gap: scroll inertia is not implemented; static drag only
                  Progress(value: 64, rounded: 6, color: "#386E38")
                  StatusPill("healthy", "#386E38")
                  StatusPill("degraded", "#7A5900")
                  StatusPill("error", "#B00020")
                }
              }
              Spacer(height: 72)
              ServiceRow("Edge", "gateway", "healthy", "#386E38")
              Spacer(height: 36)
              ServiceRow("Ingest", "collector", "healthy", "#386E38")
              Spacer(height: 36)
              ServiceRow("Warehouse", "storage", "degraded", "#7A5900")
              Spacer(height: 72)
              // md-sys-color-surface-container-low; two-layer elevation = gap M2
              Card(p: 48, rounded: 36, shadow: 1, bg: "#FFFFFF", border: "#FFFFFF") {
                Column(gap: 24, bg: "#FFFFFF") {
                  // md-sys-color-on-surface
                  Text("Run a deploy", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "dash/deploy_title")
                  Button("Deploy now", rounded: 60, bg: "#6200EE", gesture: "tap") {
                    refreshed += 1
                    load += 4
                    doneTasks += 3
                  }
                  Button("Cancel", rounded: 60, border: "#000000", gesture: "tap") { }
                }
              }
              Spacer(height: 72)
              // md-sys-color-error-container; on-error-container text
              Container(width: 984, height: 120, color: "#B00020", border: "#B00020", rounded: 24, p: 24) {
                Row(gap: 24, align: center) {
                  Icon(name: "alert-triangle", width: 48, height: 48, color: "#FFFFFF", label: "dash/alert_icon")
                  Text("{incidents} incidents need attention", size: 33, fontPx: 33, weight: "normal", color: "#FFFFFF", label: "dash/alert_text")
                }
              }
              Spacer(height: 72)
              // Boundary states follow the Material loading/empty/error contract.
              if (loading) {
                Skeleton(984, 24)
                Skeleton(984, 24)
              }
              if (empty) {
                EmptyState("folder", "No telemetry yet", "Connect a source to populate the console")
              }
              if (failed) {
                Banner("Telemetry unavailable", "The service did not answer the last request", "error")
              }
              Spacer(height: 72)
            }
          }
        }
      }
    }
  }
}
