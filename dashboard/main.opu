import "models/metrics.opu";
import "views/cards.opu";

// Components stay in the entry file: an imported module may declare only
// state, model, api, theme and imports.
component KpiCard(label: string, metric: string, trend: string) {
  Card(p: 16, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#D7E3E0") {
    Column(gap: 6, bg: "#FFFFFF") {
      Text("{label}", size: 12, color: "#4B6B67")
      Text("{metric}", size: 26, color: "#0B2E2A")
      Text("{trend}", size: 11, color: "#0F766E")
    }
  }
}

component ServiceRow(name: string, role: string, rate: int, state: string) {
  Card(p: 14, rounded: 14, shadow: 2, bg: "#FFFFFF", border: "#D7E3E0") {
    Grid(columns: 4) {
      Container(width: 26, height: 26) {
        Avatar(label: "{name}")
      }
      Column(gap: 2, bg: "#FFFFFF") {
        Text("{name}", size: 14, color: "#0B2E2A")
        Text("{role}", size: 11, color: "#4B6B67")
      }
      Container(width: 62) {
        Badge(label: "{state}")
      }
      Container(width: 190) {
        Progress(value: rate)
      }
    }
  }
}

component SectionTitle(title: string, note: string) {
  Row(gap: 8, align: center) {
    Text("{title}", size: 18, color: "#0B2E2A")
    Text("{note}", size: 11, color: "#4B6B67")
  }
}

app Dashboard {
  state window = "24h"
  state autoscaling = true
  state alerts = true
  state load = 64
  state refreshed = 0

  computed throughput = doneTasks - openTasks
  computed health = 100 - errorRate

  // One shell for every width: the outer Row lays out a sidebar and a content
  // column on a wide viewport and stacks them on a compact one.
  Column(p: 0, gap: 0) {
    Container(height: 92, p: 20, shadow: 4, gradient: "#0F766E,#053D38",
              particles: "count=40,seed=13,radius=2,alpha=760,color=#CFF3EE") {
      Column(gap: 4, bg: "#0F766E") {
        Text("Telemetry Console", size: 26, color: "#FFFFFF")
        Text("crew {crew} - feed {liveFeed} - {window} window", size: 12, color: "#CFF3EE")
      }
    }

    Row(gap: 16, p: 16) {
      // Sidebar: filter controls that only make sense beside the content.
      Column(width: 240, gap: 12, p: 14) {
        Card(p: 16, rounded: 14, shadow: 3, bg: "#FFFFFF", border: "#D7E3E0") {
          Column(gap: 10, bg: "#FFFFFF") {
            Row(gap: 8, align: center) {
              Container(width: 22, height: 22, rounded: 6, bg: "#EAF6F4") {
                Icon(name: "settings", color: "#0F766E")
              }
              Text("Filters", size: 16, color: "#0B2E2A")
            }
            Input(bind: window, placeholder: "time window")
            Slider(bind: load, min: 0, max: 100)
            Text("load {load}%", size: 12, color: "#4B6B67")
            Switch(bind: autoscaling)
            Text("autoscaling on", size: 12, color: "#4B6B67")
            Switch(bind: alerts)
            Text("alerts on", size: 12, color: "#4B6B67")
          }
        }
        Card(p: 16, rounded: 14, shadow: 2, bg: "#EAF6F4") {
          Column(gap: 6, bg: "#EAF6F4") {
            Text("Refreshed", size: 12, color: "#4B6B67")
            Text("{refreshed} cycles", size: 18, color: "#0B2E2A")
          }
        }
      }

      // Content: KPI cards, a status panel, a service list and a footer action.
      Column(width: 1000, gap: 14) {
        SectionTitle("Overview", "live telemetry")
        Grid(columns: 4) {
          KpiCard("Requests", "{doneTasks}", "up 12%")
          KpiCard("Open", "{openTasks}", "up 4%")
          KpiCard("Throughput", "{throughput}", "steady")
          KpiCard("Health", "{health}", "nominal")
        }

        Card(p: 18, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#D7E3E0") {
          Column(gap: 12, bg: "#FFFFFF") {
            Row(gap: 8, align: center) {
              Container(width: 22, height: 22, rounded: 6, bg: "#EAF6F4") {
                Icon(name: "info", color: "#0F766E")
              }
              SectionTitle("Service status", "{liveFeed}")
            }
            Row(gap: 12, align: center) {
              Progress(value: 64)
              Text("{load}% capacity - {incidents} incidents", size: 12, color: "#4B6B67")
            }
            Divider()
            Row(gap: 10, align: center) {
              Row(gap: 4, align: center) {
                Icon(name: "check", color: "#0F766E")
                Badge(label: "{openTasks} open")
              }
              Badge(label: "{doneTasks} done")
              Row(gap: 4, align: center) {
                Icon(name: "warning", color: "#B45309")
                Badge(label: "{errorRate}% errors")
              }
            }
          }
        }

        SectionTitle("Services", "{crew} on call")
        ServiceRow("Edge", "gateway", 82, "healthy")
        ServiceRow("Ingest", "collector", 64, "healthy")
        ServiceRow("Warehouse", "storage", 41, "degraded")

        Card(p: 18, rounded: 16, shadow: 3, gradient: "#0F766E,#053D38",
              particles: "count=24,seed=5,radius=2,alpha=880,color=#FFFFFF") {
          Row(gap: 12, align: center, bg: "#0F766E") {
            Container(width: 26, height: 26, rounded: 8, bg: "#053D38") {
              Icon(name: "upload", color: "#FFFFFF")
            }
            Column(gap: 4, bg: "#0F766E") {
              Text("Run a deploy", size: 16, color: "#FFFFFF")
              Text("{refreshed} cycles elapsed", size: 11, color: "#CFF3EE")
            }
            Spacer(width: 12)
            Button("Deploy now", p: 12, rounded: 12, shadow: 2, bg: "#FFFFFF", animate: spring) {
              refreshed += 1
              load += 4
              doneTasks += 3
            }
          }
        }

        if (autoscaling) {
          Container(p: 16, rounded: 14, shadow: 2, bg: "#EAF6F4") {
            Text("Autoscaling is on for {crew}", size: 14, color: "#0B2E2A")
          }
        }
        if (alerts) {
          Container(p: 16, rounded: 14, shadow: 3, gradient: "#7C2D12,#3B1206") {
            Text("{incidents} incidents need attention", size: 14, color: "#FFFFFF")
          }
        }
      }
    }
  }
}
