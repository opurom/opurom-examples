app Media {
  theme { mode: light, accent: "#4F46E5", radius: 12, stage: "#EDF0F7" }
  Column(p: 10, gap: 6) {
    Text("Scene study", size: 18)
    Grid(columns: 2) {
      Image(fit: "cover", rounded: 8, src: "assets/photo1.png", width: 150, height: 54)
      Image(fit: "cover", rounded: 8, src: "assets/photo2.png", width: 150, height: 54)
      Image(fit: "cover", rounded: 8, src: "assets/photo3.png", width: 150, height: 54)
      Image(fit: "cover", rounded: 8, src: "assets/photo4.png", width: 150, height: 54)
      Image(fit: "cover", rounded: 8, src: "assets/photo5.png", width: 150, height: 54)
    }
  }
}
