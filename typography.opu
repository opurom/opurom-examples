// Global theme fontScale with a per-node override.
import "pkg-theme/default.opu";

app Typography {
  state count = 0


  ScrollView(p: 16) {
    Column(gap: 14) {
      Container(p: 20, rounded: 18, shadow: 4, gradient: "#097FEB,#005FCC", animate: ease) {
        Text("Typography", size: 20, color: "#FFFFFF")
        Text("Global 1.5x scale, local 0.75x override", size: 11, color: "#FFFFFF")
      }
      Container(p: 18, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
        Column(gap: 10, bg: "#FFFFFF") {
          Text("Scaled: {count}", size: 18, color: "#111827")
          Text("Local 0.75x override", size: 18, color: "#6B7280", fontScale: 0.75)
        }
      }
      Container(p: 12, rounded: 16, shadow: 3, bg: "#F9FAFB") {
        Row(gap: 10, bg: "#F9FAFB") {
          Button("Increment", p: 12, rounded: 12, shadow: 2, bg: "#097FEB",
                 fontScale: 1.1, animate: spring) { count += 1 }
        }
      }
    }
  }
}
