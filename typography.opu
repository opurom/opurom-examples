// Global theme fontScale with a per-node override.
app Typography {
  state count = 0

  theme { accent: "#097FEB", radius: 14, fontScale: 1.5 , stage: "#EDF0F7" }

  ScrollView(p: 16) {
    Column(gap: 14) {
      Container(p: 20, rounded: 18, shadow: 4, gradient: "#097FEB,#043B70", animate: ease) {
        Text("Typography", size: 20, color: "#FFFFFF")
        Text("Global 1.5x scale, local 0.75x override", size: 11, color: "#D6E8FF")
      }
      Container(p: 18, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
        Column(gap: 10, bg: "#FFFFFF") {
          Text("Scaled: {count}", size: 18, color: "#101828")
          Text("Local 0.75x override", size: 18, color: "#667085", fontScale: 0.75)
        }
      }
      Container(p: 12, rounded: 16, shadow: 3, bg: "#F4F7FB") {
        Row(gap: 10, bg: "#F4F7FB") {
          Button("Increment", p: 12, rounded: 12, shadow: 2, bg: "#097FEB",
                 fontScale: 1.1, animate: spring) { count += 1 }
        }
      }
    }
  }
}
