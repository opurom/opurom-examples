// A minimal full-stack OPUROM program.
app Counter {
  state count = 0

  theme { mode: light, accent: "#097FEB", radius: 14 }

  ScrollView(p: 16) {
    Column(gap: 14) {
      Container(p: 20, rounded: 18, shadow: 4, gradient: "#097FEB,#043B70", animate: ease) {
        Text("OPUROM Counter", size: 22, color: "#FFFFFF")
        Text("Deterministic integer state, tap to change", size: 12, color: "#D6E8FF")
      }
      Container(p: 20, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#E4E9F2") {
        Column(gap: 6, align: center, bg: "#FFFFFF") {
          Text("Count", size: 12, color: "#667085")
          Text("{count}", size: 40, color: "#101828")
        }
      }
      Container(p: 13, rounded: 16, shadow: 3, bg: "#F4F7FB") {
        Row(gap: 12, align: center, bg: "#F4F7FB") {
          Button("-", p: 12, rounded: 12, shadow: 2, bg: "#097FEB", fontScale: 1.25, animate: spring) {
            count -= 1
          }
          Button("+", p: 12, rounded: 12, shadow: 2, bg: "#097FEB", fontScale: 1.25, animate: spring) {
            count += 1
          }
        }
      }
    }
  }
}
