// Calculator: decimal keypad, direct +/- arithmetic, flat state machine.
// Kernel (opurom-core/src/ir.rs Op) has no mul/div; computed folds at compile
// time (typecheck.rs infer_computed): x*10 uses += doubling, quotient is a
// reported kernel gap, never faked by stepping.
import "pkg-theme/default.opu";

// Every digit is one component: the int literal drives label, add value and
// the nz flag. Numeric props live here once; opurom-ui theme exposes color
// tokens only (parser.rs THEME_TOKEN_NAMES), no spacing/radius/elevation.
component DigitKey(digit: int, span: int, nonzero: bool) {
  Button("{digit}", variant: "secondary", p: 10, rounded: 12, margin: 2, fontPx: 26,
         columnSpan: span, shadow: 0, fontScale: 1.1, animate: spring) {
    tmp = cur
    cur += cur
    cur += cur
    cur += cur
    cur += tmp
    cur += tmp
    cur += digit
    out = cur
    nz = nonzero
    err = false
  }
}

// One component for all four operators. Literal params set the pending-op
// flags (component params may be int/bool/string literals, lower.rs:2681);
// no callback or comparison is needed to dispatch.
component OpKey(glyph: string, add: bool, sub: bool, mul: bool, div: bool) {
  Button("{glyph}", variant: "primary", p: 10, rounded: 12, margin: 2, fontPx: 26,
         shadow: 2, fontScale: 1.1, animate: spring) {
    acc = cur
    cur = 0
    out = acc
    addMode = add
    subMode = sub
    mulMode = mul
    divMode = div
    err = false
  }
}

// Fn keys: params cannot be `if` conditions (lower.rs:2995), so split.
component ClearKey(unused: int) {
  Button("AC", variant: "ghost", p: 10, rounded: 12, margin: 2, fontPx: 19,
         shadow: 0, fontScale: 1.0, animate: spring) {
    cur = 0; acc = 0; out = 0; tmp = 0; nz = false
    addMode = false; subMode = false; mulMode = false; divMode = false; err = false
  }
}
component DelKey(unused: int) {
  Button("DEL", variant: "ghost", p: 10, rounded: 12, margin: 2, fontPx: 19,
         shadow: 0, fontScale: 1.0, animate: spring) {
    cur = tmp; out = cur
  }
}
component GapKey(glyph: string) {
  Button("{glyph}", variant: "ghost", p: 10, rounded: 12, margin: 2, fontPx: 19,
         shadow: 0, fontScale: 1.0, animate: spring) {
    err = true; out = 0; cur = 0
  }
}

// Equals folds a pending op with direct +/- only; no step counter.
// Repeated operator taps just replace flags (last wins), never crash.
component EqualsKey(unused: int) {
  Button("=", variant: "primary", p: 10, rounded: 12, margin: 2, shadow: 2, fontPx: 26, animate: spring) {
    acc += cur; out = acc; cur = acc; addMode = false; subMode = false; mulMode = false; divMode = false; nz = false
  }
}

app Calculator {
  // Minimal state: value, accumulator, display, scratch, op flags, error.
  state cur = 0
  state acc = 0
  state out = 0
  state tmp = 0
  state nz = false
  state addMode = false
  state subMode = false
  state mulMode = false
  state divMode = false
  state err = false

  Column(p: 8, gap: 8) {
    Container(p: 6, glass: true, variant: "ghost", rounded: 12) {
      Icon(name: "calculator")
      Text("Opurom Calculator", fontPx: 26)
    }
    Container(p: 12, glass: true, variant: "secondary", rounded: 12, shadow: 2, flex: 1) {
    // Three tiers from theme variants: glass accent panel, primary+shadow
    // operators, secondary digits, ghost functions. No hardcoded hex.
    Column(align: end, gap: 4) {
      Text("{out}", size: 48, fontPx: 60)
      Text("Direct +/- arithmetic", size: 11, fontPx: 16)
      if (err) { Text("Mul/div: kernel gap", size: 11) }
    }
    }
    Container(p: 0, flex: 2) {
      Grid(columns: 4, compactColumns: 4, fillHeight: true) {
      ClearKey(0)
      DelKey(0)
      GapKey("%")
      OpKey("/", false, false, false, true)
      DigitKey(7, 1, true)
      DigitKey(8, 1, true)
      DigitKey(9, 1, true)
      OpKey("x", false, false, true, false)
      DigitKey(4, 1, true)
      DigitKey(5, 1, true)
      DigitKey(6, 1, true)
      OpKey("-", false, true, false, false)
      DigitKey(1, 1, true)
      DigitKey(2, 1, true)
      DigitKey(3, 1, true)
      OpKey("+", true, false, false, false)
      DigitKey(0, 2, false)
      Spacer(height: 1)
      EqualsKey(0)
      }
    }
  }
}
