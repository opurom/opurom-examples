// Calculator: phone-portrait glass keypad with official icon glyphs.
// Glass key components carry tap handlers inside their bodies: component
// use-site blocks are discarded by the compiler, so handlers live inside.
// shortcut: division advances one quotient step per "=" press; the kernel
// has no division operator or comparison for an automatic stop.
import "pkg-theme/default.opu";
import "components/glass_card.opu";
import "components/glass_primary_button.opu";
import "components/glass_secondary_button.opu";
import "components/glass_ghost_button.opu";

component GlassDigit0(unused: int) {
  if (sMul) {
    Button("0", variant: "secondary", glass: true, state: "default", p: 26, rounded: 12, shadow: 2, fontScale: 1.2, animate: "spring") {
      tmp = mulProd; mulProd += mulProd; mulProd += mulProd; mulProd += mulProd; mulProd += tmp; mulProd += tmp; h6 = h5; h5 = h4; h4 = h3; h3 = h2; h2 = h1; h1 = cur; tmp = cur; cur += cur; cur += cur; cur += cur; cur += tmp; cur += tmp; out = mulProd; err = false; dReady = false; dZero = sDiv
    }
  } else {
    Button("0", variant: "secondary", glass: true, state: "default", p: 26, rounded: 12, shadow: 2, fontScale: 1.2, animate: "spring") {
      h6 = h5; h5 = h4; h4 = h3; h3 = h2; h2 = h1; h1 = cur; tmp = cur; cur += cur; cur += cur; cur += cur; cur += tmp; cur += tmp; out = cur; err = false; dReady = false; dZero = sDiv
    }
  }
}

