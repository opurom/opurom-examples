component GlassClear(unused: int) {
  Container(p: 2, glass: true, variant: "ghost", rounded: 12) {
    Icon(name: "refresh")
    Button("AC", variant: "ghost", glass: true, state: "default", width: 72, p: 12, rounded: 12, fontScale: 1.0, animate: "spring") {
      cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; tmp = 0; acc = 0; mulProd = 0; divRem = 0; divQ = 0; out = 0; sAdd = false; sSub = false; sMul = false; sDiv = false; normalMode = true; nz = false; z = true; err = false; dReady = false; dZero = false; dot = false; opLabel = ""
    }
  }
}

component GlassDelete(unused: int) {
  Container(p: 2, glass: true, variant: "ghost", rounded: 12) {
    Icon(name: "backspace")
    Button("DEL", variant: "ghost", glass: true, state: "default", width: 72, p: 12, rounded: 12, fontScale: 1.0, animate: "spring") {
      cur = h1; h1 = h2; h2 = h3; h3 = h4; h4 = h5; h5 = h6; h6 = 0; out = cur; err = false
    }
  }
}

component GlassPercent(unused: int) {
  Container(p: 2, glass: true, variant: "ghost", rounded: 12) {
    Icon(name: "percentage")
    Button("%", variant: "ghost", glass: true, state: "default", width: 72, p: 12, rounded: 12, fontScale: 1.0, animate: "spring") {
      cur = h2; out = cur; err = false
    }
  }
}

component GlassOpPlus(unused: int) {
  if (normalMode) {
    Button("+", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = cur; out = acc; sAdd = true; sSub = false; sMul = false; sDiv = false; normalMode = false; opLabel = "+"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sAdd) {
    Button("+", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc += cur; out = acc; sAdd = true; sSub = false; sMul = false; sDiv = false; normalMode = false; opLabel = "+"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sSub) {
    Button("+", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc -= cur; out = acc; sAdd = true; sSub = false; sMul = false; sDiv = false; normalMode = false; opLabel = "+"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sMul) {
    Button("+", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = mulProd; out = acc; sAdd = true; sSub = false; sMul = false; sDiv = false; normalMode = false; opLabel = "+"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
}

component GlassOpMinus(unused: int) {
  if (normalMode) {
    Button("-", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = cur; out = acc; sAdd = false; sSub = true; sMul = false; sDiv = false; normalMode = false; opLabel = "-"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sAdd) {
    Button("-", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc += cur; out = acc; sAdd = false; sSub = true; sMul = false; sDiv = false; normalMode = false; opLabel = "-"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sSub) {
    Button("-", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc -= cur; out = acc; sAdd = false; sSub = true; sMul = false; sDiv = false; normalMode = false; opLabel = "-"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sMul) {
    Button("-", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = mulProd; out = acc; sAdd = false; sSub = true; sMul = false; sDiv = false; normalMode = false; opLabel = "-"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
}

component GlassOpMul(unused: int) {
  if (normalMode) {
    Button("x", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = cur; out = acc; sAdd = false; sSub = false; sMul = true; sDiv = false; normalMode = false; opLabel = "x"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sAdd) {
    Button("x", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc += cur; out = acc; sAdd = false; sSub = false; sMul = true; sDiv = false; normalMode = false; opLabel = "x"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sSub) {
    Button("x", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc -= cur; out = acc; sAdd = false; sSub = false; sMul = true; sDiv = false; normalMode = false; opLabel = "x"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
  if (sMul) {
    Button("x", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = mulProd; out = acc; sAdd = false; sSub = false; sMul = true; sDiv = false; normalMode = false; opLabel = "x"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = false
    }
  }
}

component GlassDivide(unused: int) {
  if (nz) {
    Button("/", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = cur; divRem = acc; divQ = 0; out = acc; sAdd = false; sSub = false; sMul = false; sDiv = true; normalMode = false; opLabel = "/"; cur = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; mulProd = 0; dReady = false; dZero = true
    }
  } else {
    Button("/", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      err = true; opLabel = "/"; dReady = false; dZero = true
    }
  }
}

component GlassEquals(unused: int) {
  if (sAdd) {
    Button("=", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc += cur; out = acc; cur = acc; sAdd = false; sSub = false; sMul = false; sDiv = false; normalMode = true; opLabel = "="; mulProd = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; dReady = false; dZero = false; dot = false
    }
  }
  if (sSub) {
    Button("=", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc -= cur; out = acc; cur = acc; sAdd = false; sSub = false; sMul = false; sDiv = false; normalMode = true; opLabel = "="; mulProd = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; dReady = false; dZero = false; dot = false
    }
  }
  if (sMul) {
    Button("=", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      acc = mulProd; out = acc; cur = acc; sAdd = false; sSub = false; sMul = false; sDiv = false; normalMode = true; opLabel = "="; mulProd = 0; h1 = 0; h2 = 0; h3 = 0; h4 = 0; h5 = 0; h6 = 0; nz = false; z = true; err = false; dReady = false; dZero = false; dot = false
    }
  }
  if (dReady) {
    Button("=", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      divQ += 1; divRem -= cur; out = divQ; opLabel = "/"; err = false; dReady = true; dZero = false
    }
  }
  if (dZero) {
    Button("=", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      err = true; opLabel = "/ error"; dReady = false; dZero = true
    }
  }
  if (normalMode) {
    Button("=", variant: "primary", glass: true, state: "default", p: 26, rounded: 12, shadow: 3, fontScale: 1.2, animate: "spring") {
      out = cur
    }
  }
}

component GlassDot(unused: int) {
  Button(".", variant: "secondary", glass: true, state: "default", p: 26, rounded: 12, shadow: 2, fontScale: 1.2, animate: "spring") {
    dot = true
  }
}

app Calculator {
  state cur = 0
  state h1 = 0
  state h2 = 0
  state h3 = 0
  state h4 = 0
  state h5 = 0
  state h6 = 0
  state tmp = 0
  state acc = 0
  state mulProd = 0
  state divRem = 0
  state divQ = 0
  state out = 0
  state sAdd = false
  state sSub = false
  state sMul = false
  state sDiv = false
  state normalMode = true
  state nz = false
  state z = true
  state err = false
  state dReady = false
  state dZero = false
  state dot = false
  state opLabel = ""

  Column(p: 8, gap: 8) {
    Container(p: 6, glass: true, variant: "ghost", rounded: 12) {
      Icon(name: "calculator")
      GlassCard("Opurom Calculator", "default")
    }
    Container(p: 8, glass: true, variant: "secondary", rounded: 14, shadow: 2) {
      Icon(name: "equal")
      GlassPrimaryButton("Result", "default")
      Text("{out}", size: 44)
      Text("Process: {acc} {opLabel}", size: 12)
      if (sDiv) { Text("Quotient {divQ}   Remainder {divRem}", size: 11) }
      if (err) { Text("Error: divide by zero", size: 12) }
      if (dot) { Text("Decimal entry", size: 11) }
    }
    Grid(columns: 4, compactColumns: 4) {
      GlassClear(0)
