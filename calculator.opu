    Button("1", variant: "secondary", glass: true, state: "default", p: 26, rounded: 12, shadow: 2, fontScale: 1.2, animate: "spring") {
      tmp = mulProd; mulProd += mulProd; mulProd += mulProd; mulProd += mulProd; mulProd += tmp; mulProd += tmp; mulProd += acc; h6 = h5; h5 = h4; h4 = h3; h3 = h2; h2 = h1; h1 = cur; tmp = cur; cur += cur; cur += cur; cur += cur; cur += tmp; cur += tmp; cur += 1; out = mulProd; nz = true; z = false; err = false; dReady = sDiv; dZero = false
    }
  } else {
    Button("1", variant: "secondary", glass: true, state: "default", p: 26, rounded: 12, shadow: 2, fontScale: 1.2, animate: "spring") {
      h6 = h5; h5 = h4; h4 = h3; h3 = h2; h2 = h1; h1 = cur; tmp = cur; cur += cur; cur += cur; cur += cur; cur += tmp; cur += tmp; cur += 1; out = cur; nz = true; z = false; err = false; dReady = sDiv; dZero = false
    }
  }
}

