              Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
                // md-sys-color-on-surface-variant (JSON equals onSurface; opacity gives visible hierarchy)
                Text("Display Large", size: 42, fontPx: 42, weight: "normal", opacity: 0.6, color: "#000000", label: "typography/name_1")
                Spacer(width: 48)
                // md-sys-color-on-surface-variant
                Text("57 / 400 / 64", size: 33, fontPx: 33, weight: "bold", opacity: 0.6, color: "#000000", label: "typography/param_1")
