// Standardized Material 3 Typography page. Token values are in 3x canvas px.
app GalleryTypography {
  // md-sys-color-surface
  Container(width: 1080, height: 2400, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
    Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
      // md-sys-color-surface
      Container(width: 1080, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "arrow-left", width: 72, height: 72, color: "#000000", label: "typography/topbar_back")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "info-circle", width: 72, height: 72, color: "#000000", label: "typography/topbar_info")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "code", width: 72, height: 72, color: "#000000", label: "typography/topbar_code")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "devices", width: 72, height: 72, color: "#000000", label: "typography/topbar_devices")
            }
          }
          Spacer(width: 24)
          Container(width: 648, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              // engLike2021 uses w400, brief says 500
              Text("Typography", size: 66, fontPx: 66, weight: "bold", color: "#000000", label: "typography/title")
            }
          }
        }
      }
      Scroll(height: 2232) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          Container(width: 984, height: 2232, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
