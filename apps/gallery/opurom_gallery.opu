// Opurom Gallery single-app replica: Home plus the MATERIAL route group.
// Route trees reuse the measured gallery_home and gallery_cards sources; the
// MATERIAL list rows are rendered from runtime list state via For nodes.
component Swatch(tone: string, bg: string, hexText: string, safeGap: int, ink: string) {
  // Each swatch carries its own bg and label; 48px right safety margin.
  Container(width: 1080, height: 144, color: "{bg}", border: "{bg}", p: 0, gesture: "tap") {
    Row(p: 0, gap: 0, align: start, color: "{bg}", border: "{bg}") {
      Spacer(width: 48)
      Text("{tone}", size: 42, fontPx: 42, weight: "normal", color: "{ink}", label: "colors/name_{tone}")
      Spacer(width: safeGap)
      Text("{hexText}", size: 42, fontPx: 42, weight: "normal", color: "{ink}", label: "colors/hex_{tone}")
    }
  }
}

component DarkHome(stage: string, hero: string, card: string, ink: string, label: string, muted: string, rose: string) {
    Container(width: 1080, height: 2200, color: "{stage}", border: "{stage}", p: 0) {
      Column(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
        Spacer(height: 66)
        Container(width: 1080, height: 70, color: "{stage}", border: "{stage}", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
            Spacer(width: 84)
            Text("Gallery", size: 56, fontPx: 45, weight: "bold", color: "{label}", label: "gallery/title")
          }
        }
        Spacer(height: 38)
        Container(width: 1080, height: 524, color: "{stage}", border: "{stage}", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
            Spacer(width: 84)
            Container(width: 912, height: 524, color: "{hero}", border: "{hero}", rounded: 26, p: 0) {
              Column(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                Container(width: 912, height: 180, color: "{hero}", border: "{hero}", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                    Spacer(width: 45)
                    Image(src: "data:image/png;base64,", width: 220, height: 180, border: "{hero}", label: "hero/gold_shape")
                    Spacer(width: 289)
                    Image(src: "data:image/png;base64,", width: 358, height: 180, border: "{hero}", label: "hero/right_0")
                  }
                }
                Container(width: 912, height: 170, color: "{hero}", border: "{hero}", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                    Spacer(width: 364)
                    Image(src: "data:image/png;base64,", width: 178, height: 170, border: "{hero}", label: "hero/reply_icon")
                    Spacer(width: 12)
                    Image(src: "data:image/png;base64,", width: 358, height: 170, border: "{hero}", label: "hero/right_1")
                  }
                }
                Container(width: 912, height: 46, color: "{hero}", border: "{hero}", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                    Spacer(width: 554)
                    Image(src: "data:image/png;base64,", width: 358, height: 46, border: "{hero}", label: "hero/right_2")
                  }
                }
                Container(width: 912, height: 54, color: "{hero}", border: "{hero}", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                    Spacer(width: 45)
                    Container(width: 509, height: 54, color: "{hero}", border: "{hero}", p: 0) {
                      Row(p: 0, gap: 0, align: center, color: "{hero}", border: "{hero}") {
                        Text("Reply", size: 49, fontPx: 39, weight: "bold", color: "{ink}", label: "hero/reply_title")
                      }
                    }
                    Image(src: "data:image/png;base64,", width: 358, height: 54, border: "{hero}", label: "hero/right_3")
                  }
                }
                Container(width: 912, height: 74, color: "{hero}", border: "{hero}", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                    Spacer(width: 45)
                    Container(width: 509, height: 74, color: "{hero}", border: "{hero}", p: 0) {
                      Row(p: 0, gap: 0, align: start, color: "{hero}", border: "{hero}") {
                        Text("An efficient, focused email app", size: 35, fontPx: 28, weight: "normal", color: "{ink}", label: "hero/reply_subtitle")
                      }
                    }
                    Image(src: "data:image/png;base64,", width: 358, height: 74, border: "{hero}", label: "hero/right_4")
                  }
                }
              }
            }
            Spacer(width: 42)
            Image(src: "data:image/png;base64,", width: 42, height: 421, border: "{stage}", label: "hero/next_card_corner")
          }
        }
        Spacer(height: 69)
        Container(width: 1080, height: 72, color: "{stage}", border: "{stage}", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
            Spacer(width: 84)
            Text("Categories", size: 56, fontPx: 48, weight: "bold", color: "{rose}", label: "gallery/categories")
          }
        }
        Spacer(height: 37)
        Container(width: 1080, height: 201, color: "{stage}", border: "{stage}", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
            Spacer(width: 84)
            Container(width: 912, height: 201, color: "{card}", border: "{card}", rounded: 20, p: 0, animate: "ease", animClock: "home", duration: 800, animInterval: [0, 400]) {
              Column(p: 0, gap: 0, align: start, color: "{card}", border: "{card}") {
                Spacer(height: 29)
                Container(width: 912, height: 150, color: "{card}", border: "{card}", p: 0) {
                  Row(p: 0, gap: 0, align: center, color: "{card}", border: "{card}") {
                    Spacer(width: 28)
                    Image(src: "data:image/png;base64,", width: 156, height: 150, border: "{card}", label: "category/material_icon")
                    Spacer(width: 42)
                    Container(width: 600, height: 150, color: "{card}", border: "{card}", p: 0) {
                      Column(p: 0, gap: 0, align: start, color: "{card}", border: "{card}") {
                        Spacer(height: 12)
                        Container(width: 600, height: 138, color: "{card}", border: "{card}", p: 0) {
                          Row(p: 0, gap: 0, align: center, color: "{card}", border: "{card}") {
                            Text("MATERIAL", size: 40, fontPx: 32, weight: "bold", color: "{ink}", label: "category/material_label")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Spacer(height: 52)
        Container(width: 1080, height: 201, color: "{stage}", border: "{stage}", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
            Spacer(width: 84)
            Container(width: 912, height: 201, color: "{card}", border: "{card}", rounded: 20, p: 0, animate: "ease", animClock: "home", duration: 800, animInterval: [50, 450]) {
              Column(p: 0, gap: 0, align: start, color: "{card}", border: "{card}") {
                Spacer(height: 29)
                Container(width: 912, height: 150, color: "{card}", border: "{card}", p: 0) {
                  Row(p: 0, gap: 0, align: center, color: "{card}", border: "{card}") {
                    Spacer(width: 26)
                    Image(src: "data:image/png;base64,", width: 168, height: 154, border: "{card}", label: "category/cupertino_icon")
                    Spacer(width: 32)
                    Container(width: 600, height: 150, color: "{card}", border: "{card}", p: 0) {
                      Column(p: 0, gap: 0, align: start, color: "{card}", border: "{card}") {
                        Spacer(height: 12)
                        Container(width: 600, height: 138, color: "{card}", border: "{card}", p: 0) {
                          Row(p: 0, gap: 0, align: center, color: "{card}", border: "{card}") {
                            Text("CUPERTINO", size: 40, fontPx: 32, weight: "bold", color: "{ink}", label: "category/cupertino_label")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Spacer(height: 52)
        Container(width: 1080, height: 201, color: "{stage}", border: "{stage}", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "{stage}", border: "{stage}") {
            Spacer(width: 84)
            Container(width: 912, height: 201, color: "{card}", border: "{card}", rounded: 20, p: 0, animate: "ease", animClock: "home", duration: 800, animInterval: [100, 500]) {
              Column(p: 0, gap: 0, align: start, color: "{card}", border: "{card}") {
                Spacer(height: 29)
                Container(width: 912, height: 150, color: "{card}", border: "{card}", p: 0) {
                  Row(p: 0, gap: 0, align: center, color: "{card}", border: "{card}") {
                    Spacer(width: 23)
                    Image(src: "data:image/png;base64,", width: 163, height: 109, border: "{card}", label: "category/styles_icon")
                    Spacer(width: 39)
                    Container(width: 600, height: 150, color: "{card}", border: "{card}", p: 0) {
                      Column(p: 0, gap: 0, align: start, color: "{card}", border: "{card}") {
                        Spacer(height: 12)
                        Container(width: 600, height: 138, color: "{card}", border: "{card}", p: 0) {
                          Row(p: 0, gap: 0, align: center, color: "{card}", border: "{card}") {
                            Text("STYLES & OTHER", size: 40, fontPx: 32, weight: "bold", color: "{ink}", label: "category/styles_label")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        Spacer(height: 486)
      }
    }
}

// GalleryAppBar: M3 Gallery detail-page title band. Copied from opurom-ui
// c980040 as a self-contained local component (no package import in this app).
// Golden geometry: x=42..1037 (996px), y=275..421 (147px), #6200EE band,
// white bold ~64px title. IR rounds all four corners; top-only is gap M1.
component GalleryAppBar(title: string, bg: string, textColor: string, radius: int, height: int, state: string) {
  Container(width: 996, height: height, rounded: radius, color: "{bg}", border: "{bg}", p: 0, state: "{state}", gesture: "tap", label: "gallery app bar") {
    Text("{title}", size: 64, weight: "bold", color: "{textColor}", label: "gallery/title")
  }
}

app OpuromGallery {
  quality { msaa: 4 }
  theme { fontMetrics: proportional }

  // MATERIAL list rows: one element per row, bound at view time in For nodes.
  state matIcons = ["layout-navbar", "layout-list", "layout-bottombar", "navigation", "box-align-bottom", "square-rounded", "cards", "checklist", "table", "alert-square", "border-horizontal", "layout-grid", "list", "menu-2", "menu", "navigation", "calendar-event", "progress", "checkbox", "adjustments", "message", "tabs", "cursor-text", "help-circle"]
  state matTitles = ["App bar", "Banner", "Bottom app bar", "Bottom navigation", "Bottom sheet", "Buttons", "Cards", "Chips", "Data Tables", "Dialogs", "Divider", "Grid Lists", "Lists", "Menu", "Navigation Drawer", "Navigation Rail", "Pickers", "Progress indicators", "Selection controls", "Sliders", "Snackbars", "Tabs", "Text fields", "Tooltips"]
  state matSubs = ["Displays information and actions relating to the current screen", "Displaying a banner within a list", "Displays navigation and actions at the bottom", "Bottom navigation with cross-fading views", "Persistent and modal bottom sheets", "Text, elevated, outlined, and more", "Baseline cards with rounded corners", "Compact elements that represent an input, attribute, or action", "Rows and columns of information", "Simple, alert, and fullscreen", "A divider is a thin line that groups content in lists and layouts.", "Row and column layout", "Scrolling list layouts", "Menu buttons and simple menus", "Displaying a drawer within appbar", "Displaying a Navigation Rail within an app", "Date and time selection", "Linear, circular, indeterminate", "Checkboxes, radio buttons, and switches", "Widgets for selecting a value by swiping", "Snackbars show messages at the bottom of the screen", "Tabs with independently scrollable views", "Single line of editable text and numbers", "Short message displayed on long press or hover"]

  // Scroll windows: the same row vocabulary at three recorded scroll offsets.
  state scroll1Icons = ["square-rounded", "cards", "checklist", "alert-square"]
  state scroll1Titles = ["Buttons", "Cards", "Chips", "Dialogs"]
  state scroll1Subs = ["Text, elevated, outlined, and more", "Baseline cards with rounded corners", "Compact elements that represent an input, attribute, or action", "Simple, alert, and fullscreen"]
  state scroll2Icons = ["border-horizontal", "layout-grid", "list", "menu-2", "menu", "navigation"]
  state scroll2Titles = ["Divider", "Grid Lists", "Lists", "Menu", "Navigation Drawer", "Navigation Rail"]
  state scroll2Subs = ["A divider is a thin line that groups content in lists and layouts.", "Row and column layout", "Scrolling list layouts", "Menu buttons and simple menus", "Displaying a drawer within appbar", "Displaying a Navigation Rail within an app"]
  state scroll3Icons = ["calendar-event", "progress", "checkbox", "adjustments", "message", "tabs", "cursor-text", "help-circle"]
  state scroll3Titles = ["Pickers", "Progress indicators", "Selection controls", "Sliders", "Snackbars", "Tabs", "Text fields", "Tooltips"]
  state scroll3Subs = ["Date and time selection", "Linear, circular, indeterminate", "Checkboxes, radio buttons, and switches", "Widgets for selecting a value by swiping", "Snackbars show messages at the bottom of the screen", "Tabs with independently scrollable views", "Single line of editable text and numbers", "Short message displayed on long press or hover"]

  state navComments = true
  state navCalendar = false
  state navAccount = false
  state themeSelection = "System"
  state textScaling = "System"
  state textDirection = "Based on locale"
  state localeValue = "System - English (United States)"
  state platformMechanics = "Android"
  state slowMotion = false
  state drawerOpen = false
  state item = "one"
  state tabRed = true
  state tabPink = false
  state tabPurple = false
  state tabDeep = false
  state styleRows = ["Motion", "Colors", "Typography", "2D transformations"]
  state styleSubs = ["All of the predefined transition patterns", "All of the predefined colors", "All of the predefined text styles", "Pan, zoom, rotate"]
  state styleIcons = ["transition-right", "color-picker", "text-caption", "grid-3x3"]
  state bodyRoles = ["Headline 2", "Headline 3", "Headline 4", "Headline 5", "Headline 6", "Subtitle 1", "Subtitle 2", "Body Text 1", "Body Text 2", "Button", "Caption", "Overline"]
  state bodySamples = ["Light 60sp", "Regular 48sp", "Regular 34sp", "Regular 24sp", "Medium 20sp", "Regular 16sp", "Medium 14sp", "Regular 16sp", "Regular 14sp", "MEDIUM (ALL CAPS) 14sp", "Regular 12sp", "REGULAR (ALL CAPS) 10sp"]

  route Home {
    Container(width: 1080, height: 2200, color: "#E6EBEB", border: "#E6EBEB", p: 0) {
      Column(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
        Spacer(height: 66)
        Container(width: 1080, height: 70, color: "#E6EBEB", border: "#E6EBEB", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
            Spacer(width: 84)
            Text("Gallery", size: 56, fontPx: 45, weight: "bold", color: "#117378", label: "gallery/title")
          }
        }
        Spacer(height: 38)
        Container(width: 1080, height: 524, color: "#E6EBEB", border: "#E6EBEB", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
            Spacer(width: 84)
            Container(width: 912, height: 524, color: "#314754", border: "#314754", rounded: 26, p: 0) {
              Column(p: 0, gap: 0, align: start, color: "#314754", border: "#314754") {
                Container(width: 912, height: 180, color: "#314754", border: "#314754", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "#314754", border: "#314754") {
                    Spacer(width: 45)
                    Text("Reply", size: 60, fontPx: 60, weight: "bold", letterSpacing: -18, color: "#FFFFFF", label: "hero/reply_title")
                  }
                }
                Container(width: 912, height: 74, color: "#314754", border: "#314754", p: 0) {
                  Row(p: 0, gap: 0, align: start, color: "#314754", border: "#314754") {
                    Spacer(width: 45)
                    Text("An efficient, focused email app", size: 35, fontPx: 28, weight: "normal", color: "#FFFFFF", label: "hero/reply_subtitle")
                  }
                }
              }
            }
          }
        }
        Spacer(height: 69)
        Container(width: 1080, height: 72, color: "#E6EBEB", border: "#E6EBEB", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
            Spacer(width: 84)
            Text("Categories", size: 56, fontPx: 48, weight: "bold", color: "#B93C5D", label: "gallery/categories")
          }
        }
        Spacer(height: 11)
        Container(width: 1080, height: 209, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
            Spacer(width: 84)
            Container(width: 150, height: 140, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
              Icon(name: "layout-grid", width: 150, height: 140, color: "#B93C5D", label: "category/material_icon")
            }
            Spacer(width: 42)
            Button("MATERIAL", width: 600) { push: MaterialList }
          }
        }
        Spacer(height: 52)
        Container(width: 1080, height: 201, color: "#E6EBEB", border: "#E6EBEB", p: 0) {
          Row(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
            Spacer(width: 84)
            Container(width: 912, height: 201, color: "#FFFFFF", border: "#FFFFFF", rounded: 20, p: 0) {
              Row(p: 0, gap: 0, align: center, color: "#FFFFFF", border: "#FFFFFF") {
                Spacer(width: 26)
                Text("STYLES & OTHER", size: 40, fontPx: 32, weight: "bold", color: "#241E30", label: "category/styles_label")
              }
            }
          }
        }
      }
    }
  }

  route MaterialList {
    Column(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
      Container(width: 1080, height: 72, color: "#E6EBEB", border: "#E6EBEB", p: 0) {
        Row(p: 0, gap: 0, align: start, color: "#E6EBEB", border: "#E6EBEB") {
          Spacer(width: 84)
          Text("Gallery", size: 56, fontPx: 45, weight: "bold", color: "#117378", label: "gallery/title")
        }
      }
      Container(width: 1080, height: 209, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Row(p: 0, gap: 0, align: center, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 84)
          Text("MATERIAL", size: 52, fontPx: 40, weight: "bold", color: "#241E30", label: "components/header_title")
        }
      }
      Container(width: 1080, height: 1900, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
        Column(p: 0, gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "layout-navbar", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
              }
              Column(gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
                Text("App bar", size: 52, fontPx: 52, weight: "normal", color: "#241E30", label: "components/title")
                Text("Displays information and actions relating to the current screen", size: 28, fontPx: 28, weight: "normal", color: "#8F8C95", label: "components/subtitle")
              }
            }
          }
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "layout-list", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
              }
              Column(gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
                Text("Banner", size: 52, fontPx: 52, weight: "normal", color: "#241E30", label: "components/title")
                Text("Displaying a banner within a list", size: 28, fontPx: 28, weight: "normal", color: "#8F8C95", label: "components/subtitle")
              }
            }
          }
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "layout-bottombar", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
              }
              Column(gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
                Text("Bottom app bar", size: 52, fontPx: 52, weight: "normal", color: "#241E30", label: "components/title")
                Text("Displays navigation and actions at the bottom", size: 28, fontPx: 28, weight: "normal", color: "#8F8C95", label: "components/subtitle")
              }
            }
          }
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0, gesture: "tap") {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "navigation", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
              }
              Column(gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
                Text("Bottom navigation", size: 52, fontPx: 52, weight: "normal", color: "#241E30", label: "components/title")
                Text("Bottom navigation with cross-fading views", size: 28, fontPx: 28, weight: "normal", color: "#8F8C95", label: "components/subtitle")
              }
            }
            Button(" ", variant: "ghost", color: "#FAFBFB", p: 0) { push: BottomNav }
          }
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "box-align-bottom", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
              }
              Column(gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
                Text("Bottom sheet", size: 52, fontPx: 52, weight: "normal", color: "#241E30", label: "components/title")
                Text("Persistent and modal bottom sheets", size: 28, fontPx: 28, weight: "normal", color: "#8F8C95", label: "components/subtitle")
              }
            }
          }
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0, gesture: "tap") {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "square-rounded", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
              }
              Column(gap: 0, align: start, color: "#FAFBFB", border: "#FAFBFB") {
                Text("Buttons", size: 52, fontPx: 52, weight: "normal", color: "#241E30", label: "components/title")
                Text("Text, elevated, outlined, and more", size: 28, fontPx: 28, weight: "normal", color: "#8F8C95", label: "components/subtitle")
              }
            }
            Button(" ", variant: "ghost", color: "#FAFBFB", p: 0) { push: Buttons }
          }
          Container(width: 1080, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0, gesture: "tap") {
            Row(gap: 0, align: center, color: "#FAFBFB", border: "#FAFBFB") {
              Spacer(width: 84)
              Container(width: 168, height: 198, color: "#FAFBFB", border: "#FAFBFB", p: 0) {
                Icon(name: "cards", width: 48, height: 48, color: "#B93C5D", label: "components/icon")
