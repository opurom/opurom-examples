// Relay entry: reusable nodes and the app tree. An imported module may declare
// only state, model, api, theme and imports, so every component lives here.
import "models/forum.opu";
import "views/state.opu";
import "views/theme.opu";

// Brand mark shared by the header and footer so the identity stays one glyph.
component BrandMark(size: int, ink: string, accent: string, tile: string) {
  Row(gap: 10, align: center) {
    Container(width: 34, height: 34, rounded: 10, bg: "{accent}") {
      Icon(name: "chat", color: "{tile}")
    }
    Text("Relay", size: size, color: "{ink}")
  }
}

// Section heading closes every grouped surface with one type scale.
component SectionHead(title: string, detail: string) {
  Column(gap: 4) {
    Text("{title}", size: 26, color: "#111827")
    Text("{detail}", size: 13, color: "#6B7280")
  }
}

// Small running dot marks the active presence list without a heavy fill.
component Dot(color: string) {
  Container(width: 8, height: 8, rounded: 4, bg: "{color}") {}
}

// Sidebar tag line sets the feed filter and returns to the top of the paged feed.
component SideTag(label: string, slug: string, count: string) {
  Button("{label}   {count}", p: 10, rounded: 10, bg: "#F5F6F8") {
    tagFilter = slug
    page = 1
    hasMore = true
    view = "feed"
    viewFeedDetail = false
    showFeed = true
    showLogin = false
    showRegister = false
    showProfile = false
    showNotifications = false
    showSearch = false
    showCompose = false
    showModeration = false
  }
}

// Feed tag row switches the filter; the accent already names the active tag.
component FilterTag(label: string, slug: string) {
  Button("{label}", p: 8, rounded: 10, bg: "#FFFFFF") {
    tagFilter = slug
    page = 1
    hasMore = true
  }
}

// Soft tag pill: a light wash with an explicitly dark label, never a full fill.
component TagPill(label: string) {
  Container(p: 6, rounded: 10, bg: "#EEF0FF") {
    Text("{label}", size: 11, color: "#4F46E5")
  }
}

// Stat unit inside the footer strip of a discussion card.
// Cap the unit so its nested row hugs inline instead of claiming a full row line.
component StatUnit(icon: string, label: string) {
  Row(gap: 5, align: center, width: 120) {
    Icon(name: "{icon}", color: "#9CA3AF")
    Text("{label}", size: 12, color: "#6B7280")
  }
}

// One discussion card: identity row, tag pill, title, engagement counts and open action.
component DiscussionCard(title: string, author: string, tag: string, likes: string, replies: string, views: string, when: string) {
  Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
    Column(gap: 10) {
      Row(gap: 10, align: center) {
        Avatar(label: "{author}")
        Text("{author}", size: 13, color: "#111827")
        Text("{when}", size: 12, color: "#9CA3AF")
        Spacer(width: 1)
        TagPill("{tag}")
      }
      Text("{title}", size: 17, color: "#111827")
      Divider()
      Row(gap: 18, align: center) {
        StatUnit("heart", "{likes}")
        StatUnit("chat", "{replies} replies")
        StatUnit("eye", "{views} views")
        Spacer(width: 1)
        Button("Open", p: 8, rounded: 10, bg: "#EEF0FF") {
          selectedTitle = title
          selectedAuthor = author
          selectedTag = tag
          selectedBody = "A discussion opened from the Relay feed. The body, reactions and replies are shown on this surface."
          selectedLikes = 12
          selectedReplies = 3
          selectedViews = 210
          replying = false
          view = "feed"
          viewFeedDetail = true
          showFeed = false
          showProfile = false
          showNotifications = false
          showSearch = false
          showCompose = false
          showModeration = false
        }
      }
    }
  }
}

// Reply row renders author, body and a compact like control.
component ReplyRow(author: string, body: string, likes: string) {
  Card(p: 14, rounded: 14, glass: true, border: "#ECEEF2") {
    Row(gap: 12, align: start) {
      Avatar(label: "{author}")
      Column(gap: 6) {
        Row(gap: 8, align: center) {
          Text("{author}", size: 13, color: "#111827")
          Text("{likes} likes", size: 12, color: "#9CA3AF")
        }
        Text("{body}", size: 14, color: "#374151")
        Row(gap: 8, align: center) {
          Button("Like", p: 6, rounded: 8, bg: "#F5F6F8") {
            selectedLikes += 1
          }
          Button("Reply", p: 6, rounded: 8, bg: "#F5F6F8") {
            replying = true
          }
        }
      }
    }
  }
}

// Stat tile gives the feed and profile a shared metric treatment.
component StatTile(label: string, metric: string) {
  Card(p: 16, rounded: 14, glass: true, border: "#ECEEF2") {
    Column(gap: 4) {
      Text("{label}", size: 12, color: "#6B7280")
      Text("{metric}", size: 24, color: "#111827")
    }
  }
}

// Member row in the side panel opens that member's profile.
component MemberRow(handle: string) {
  Row(gap: 10, align: center) {
    Avatar(label: "{handle}")
    Text("{handle}", size: 13, color: "#111827")
    Dot("#22C55E")
    Spacer(width: 1)
    Button("View", p: 6, rounded: 8, bg: "#F5F6F8") {
      profileHandle = handle
      profileName = handle
      view = "profile"
      viewFeedDetail = false
      showProfile = true
      showFeed = false
      showNotifications = false
      showSearch = false
      showCompose = false
      showModeration = false
    }
  }
}

// Sidebar quick link switches the main surface through one state.
component NavButton(label: string, surface: string) {
  Button("{label}", p: 10, rounded: 10, bg: "#F5F6F8") {
    view = surface
    viewFeedDetail = false
    showFeed = false
    showLogin = false
    showRegister = false
    showProfile = false
    showNotifications = false
    showSearch = false
    showCompose = false
    showModeration = false
  }
}

// Notification line with kind chip, actor and mark-read action.
component NotificationRow(kind: string, actor: string, text: string, when: string) {
  Card(p: 14, rounded: 14, glass: true, border: "#ECEEF2") {
    Row(gap: 12, align: center) {
      Container(width: 36, height: 36, rounded: 10, bg: "#EEF0FF") {
        Icon(name: "bell", color: "#4F46E5")
      }
      Column(gap: 2) {
        Row(gap: 6, align: center) {
          Text("{actor}", size: 13, color: "#111827")
          TagPill("{kind}")
        }
        Text("{text}", size: 13, color: "#4B5563")
        Text("{when}", size: 11, color: "#9CA3AF")
      }
      Spacer(width: 1)
      Button("Mark read", p: 6, rounded: 8, bg: "#F5F6F8") {
        unreadCount -= 1
      }
    }
  }
}

// Search result line routes a discussion result to its detail composition.
component ResultRow(title: string, kind: string, meta: string) {
  Card(p: 14, rounded: 14, glass: true, border: "#ECEEF2") {
    Row(gap: 12, align: center) {
      Container(width: 32, height: 32, rounded: 10, bg: "#EEF0FF") {
        Icon(name: "search", color: "#4F46E5")
      }
      Column(gap: 2) {
        Text("{title}", size: 14, color: "#111827")
        Text("{kind} - {meta}", size: 12, color: "#6B7280")
      }
    }
  }
}

// Activity line for the profile feed keeps the timeline scannable.
component ActivityRow(text: string, when: string) {
  Row(gap: 10, align: center) {
    Dot("#4F46E5")
    Text("{text}", size: 13, color: "#374151")
    Spacer(width: 1)
    Text("{when}", size: 12, color: "#9CA3AF")
  }
}

// Flag row in the moderation panel exposes the delete and dismiss actions.
component FlagRow(author: string, title: string, reason: string) {
  Card(p: 14, rounded: 14, shadow: 1, bg: "#FEF2F2", border: "#FBD5D5") {
    Column(gap: 8) {
      Row(gap: 8, align: center) {
        Avatar(label: "{author}")
        Text("{title}", size: 14, color: "#7F1D1D")
        Spacer(width: 1)
        Icon(name: "warning", color: "#B91C1C")
      }
      Text("reason: {reason}", size: 12, color: "#9A3412")
      Row(gap: 8, align: center) {
        Button("Delete", p: 6, rounded: 8, bg: "#B91C1C") {
          flaggedCount -= 1
          moderatorNote = "Item removed from the queue."
        }
        Button("Dismiss", p: 6, rounded: 8, bg: "#F5F6F8") {
          flaggedCount -= 1
          moderatorNote = "Flag dismissed as unfounded."
        }
        Button("Mute user", p: 6, rounded: 8, bg: "#F5F6F8") {
          mutedCount += 1
          moderatorNote = "Author muted for 24 hours."
        }
      }
    }
  }
}

// Inline validation note for the composer and auth forms.
component FormNote(text: string) {
  Row(gap: 6, align: center) {
    Icon(name: "info", color: "#B83E1C")
    Text("{text}", size: 12, color: "#B83E1C")
  }
}

app Relay {
  // Derived header badge keeps the unread count and flag queue in one place.
  computed noticeTotal = unreadCount + flaggedCount
  computed engagement = selectedLikes + selectedReplies + selectedViews

  // One shell for every width: the outer Row lays the side panel beside the main
  // column. A start alignment keeps the sidebar pinned to the top beside the tall feed.
  // No shell fill: the theme stage tints the page, so glass laminas refract it.
  Column(p: 0, gap: 0) {
    // Persistent header: brand, search box, notification bell and user menu.
    Container(p: 16, glass: true, border: "#ECEEF2") {
      Row(gap: 12, align: center) {
        // Cap the brand block so its inner row hugs and the toolbar stays one line.
        Column(width: 100) {
          BrandMark(19, "#111827", "#4F46E5", "#FFFFFF")
        }
        Spacer(width: 1)
        Input(bind: searchText, placeholder: "Search discussions and members")
        Button("Search", p: 8, rounded: 10, bg: "#F5F6F8") {
          searchQuery = searchText
          view = "search"
          viewFeedDetail = false
          showFeed = false
          showLogin = false
          showRegister = false
          showProfile = false
          showNotifications = false
          showSearch = true
          showCompose = false
          showModeration = false
        }
        Button("Bell {unreadCount}", p: 8, rounded: 10, bg: "#F5F6F8") {
          view = "notifications"
          viewFeedDetail = false
          showFeed = false
          showLogin = false
          showRegister = false
          showProfile = false
          showNotifications = true
          showSearch = false
          showCompose = false
          showModeration = false
        }
        Button("New discussion", p: 10, rounded: 10, bg: "#4F46E5") {
          view = "compose"
          viewFeedDetail = false
          showFeed = false
          showLogin = false
          showRegister = false
          showProfile = false
          showNotifications = false
          showSearch = false
          showCompose = true
          showModeration = false
        }
        if (sessionActive) {
          Button("@{meHandle}", p: 8, rounded: 10, bg: "#F5F6F8") {
            view = "profile"
            viewFeedDetail = false
            showFeed = false
            showLogin = false
            showRegister = false
            showProfile = true
            showNotifications = false
            showSearch = false
            showCompose = false
            showModeration = false
          }
          Button("Sign out", p: 8, rounded: 10, bg: "#F5F6F8") {
            sessionActive = false
            role = "guest"
            isModerator = false
            view = "login"
            viewFeedDetail = false
            showFeed = false
            showLogin = true
            showRegister = false
            showProfile = false
            showNotifications = false
            showSearch = false
            showCompose = false
            showModeration = false
          }
        }
      }
    }

    Row(gap: 16, p: 24, align: start) {
      // Side panel: community stats, tags, active members, quick links.
      // Width caps at 260px on wide screens; at narrow the Row stacks it full-width.
      Column(width: 260, gap: 14) {
        Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
          Column(gap: 8) {
            Text("Community", size: 13, color: "#6B7280")
            Row(gap: 8, align: center) {
              Dot("#22C55E")
              Text("5 active members", size: 17, color: "#111827")
            }
            Text("128 discussions - 317 replies", size: 12, color: "#6B7280")
          }
        }

        Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
          Column(gap: 8) {
            Text("Tags", size: 13, color: "#111827")
            SideTag("Announcements", "announcements", "9")
            SideTag("General", "general", "41")
            SideTag("Help", "help", "22")
            SideTag("Showcase", "showcase", "18")
            SideTag("Design", "design", "14")
            SideTag("Build", "build", "24")
          }
        }

        Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
          Column(gap: 10) {
            Text("Active now", size: 13, color: "#111827")
            for (m in activeMembers) {
              MemberRow("{m}")
            }
          }
        }

        Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
          Column(gap: 8) {
            Text("Quick links", size: 13, color: "#111827")
            NavButton("Feed", "feed")
            NavButton("Notifications", "notifications")
            NavButton("My profile", "profile")
            NavButton("Moderation", "moderation")
          }
        }
      }

      // Main column: one screen at a time driven by the view flag.
      // Width caps at 880px on wide screens so the shell reads as a centred two-column page.
      Column(width: 880, gap: 16) {
        // Feed: section head, sort, tag strip, stats, discussion cards, load-more.
        if (showFeed) {
          Column(gap: 14) {
            SectionHead("Discussions", "for a calm, thoughtful community")
            Row(gap: 10, align: center) {
              Text("Sort by", size: 13, color: "#6B7280")
              FilterTag("Latest", "all")
              FilterTag("Announcements", "announcements")
              FilterTag("General", "general")
              FilterTag("Help", "help")
              FilterTag("Showcase", "showcase")
              Spacer(width: 1)
              Text("Showing: {tagFilter}", size: 12, color: "#4F46E5")
            }
            Grid(columns: 3) {
              StatTile("Discussions", "128")
              StatTile("Members", "42")
              StatTile("Replies", "317")
            }
            Column(gap: 12) {
              for (i in 8) {
                DiscussionCard("{feedTitles[i]}", "{feedAuthors[i]}", "{feedTags[i]}", "{feedLikes[i]}", "{feedReplies[i]}", "{feedViews[i]}", "{feedTimes[i]}")
              }
            }
            Row(gap: 10, align: center) {
              if (hasMore) {
                Button("Load more discussions", p: 10, rounded: 10, bg: "#FFFFFF") {
                  page += 1
                  hasMore = false
                }
              } else {
                Text("Page {page} - end of feed", size: 12, color: "#6B7280")
                Button("Back to start", p: 8, rounded: 10, bg: "#FFFFFF") {
                  page = 1
                  hasMore = true
                }
              }
            }
          }
        }

        // Discussion detail: post body, reactions, reply composer, nested replies.
        if (viewFeedDetail) {
          Column(gap: 14) {
            Row(gap: 8, align: center) {
              Button("Back to feed", p: 8, rounded: 10, bg: "#FFFFFF") {
                view = "feed"
                viewFeedDetail = false
                showFeed = true
              }
            }
            Card(p: 22, rounded: 16, glass: true, border: "#ECEEF2") {
              Column(gap: 12) {
                Row(gap: 8, align: center) {
                  TagPill("{selectedTag}")
                  if (selectedPinned) {
                    TagPill("Pinned")
                  }
                  if (selectedLocked) {
                    TagPill("Locked")
                  }
                }
                Text("{selectedTitle}", size: 28, color: "#111827")
                Row(gap: 10, align: center) {
                  Avatar(label: "{selectedAuthor}")
                  Column(gap: 2) {
                    Text("by {selectedAuthor}", size: 13, color: "#111827")
                    Text("started this discussion", size: 12, color: "#9CA3AF")
                  }
                }
                Text("{selectedBody}", size: 15, color: "#374151")
                Divider()
                Row(gap: 10, align: center) {
                  Button("Like {selectedLikes}", p: 8, rounded: 10, bg: "#4F46E5") {
                    selectedLikes += 1
                  }
                  Button("Reply", p: 8, rounded: 10, bg: "#F5F6F8") {
                    replying = true
                  }
                  Button("Save", p: 8, rounded: 10, bg: "#F5F6F8") {
                    moderatorNote = "Saved to your bookmarks."
                  }
                  Button("Edit", p: 8, rounded: 10, bg: "#F5F6F8") {
                    editingReply = true
                  }
                  Spacer(width: 1)
                  Text("{selectedViews} views - {selectedReplies} replies", size: 12, color: "#6B7280")
                }
                if (selectedLocked) {
                  TagPill("This thread is locked")
                }
                Row(gap: 8, align: center) {
                  Text("Moderator tools", size: 12, color: "#B91C1C")
                  Button("Lock thread", p: 6, rounded: 8, bg: "#FEF2F2") {
                    selectedLocked = true
                  }
                  Button("Delete thread", p: 6, rounded: 8, bg: "#FEF2F2") {
                    view = "feed"
                    viewFeedDetail = false
                    showFeed = true
                  }
                  Button("Flag post", p: 6, rounded: 8, bg: "#FEF2F2") {
                    flaggedCount += 1
                  }
                }
              }
            }
            if (replying) {
              Row(gap: 8, align: center) {
                Input(bind: replyDraft, placeholder: "Write a reply")
                Button("Post reply", p: 10, rounded: 10, bg: "#4F46E5") {
                  selectedReplies += 1
                  replyDraft = ""
                  replying = false
                }
                Button("Cancel", p: 10, rounded: 10, bg: "#FFFFFF") {
                  replying = false
                }
              }
            }
            if (editingReply) {
              Row(gap: 8, align: center) {
                Icon(name: "edit", color: "#4F46E5")
                Text("Editing your latest reply", size: 13, color: "#6B7280")
                Button("Save edit", p: 8, rounded: 10, bg: "#FFFFFF") {
                  editingReply = false
                }
              }
            }
            Text("Replies", size: 18, color: "#111827")
            for (i in 3) {
              ReplyRow("{replyAuthors[i]}", "{replyBodies[i]}", "{replyLikes[i]}")
            }
          }
        }

        // Composer: title, body, tag and validation.
        if (showCompose) {
          Column(gap: 14) {
            SectionHead("New discussion", "write a clear title, pick a tag, then publish")
            Card(p: 22, rounded: 16, glass: true, border: "#ECEEF2") {
              Column(gap: 12) {
                Input(bind: draftTitle, placeholder: "Discussion title")
                Input(bind: draftBody, placeholder: "Write the body of the discussion")
                Row(gap: 8, align: center) {
                  Text("Tag", size: 13, color: "#6B7280")
                  Radio(bind: draftTag, value: "General")
                  Text("General", size: 13, color: "#4B5563")
                  Radio(bind: draftTag, value: "Help")
                  Text("Help", size: 13, color: "#4B5563")
                  Radio(bind: draftTag, value: "Design")
                  Text("Design", size: 13, color: "#4B5563")
                }
                if (draftInvalid) {
                  FormNote("{draftError}")
                }
                Row(gap: 8, align: center) {
                  Button("Publish", p: 10, rounded: 10, bg: "#4F46E5") {
                    draftError = "Title and body are required before publishing."
                    draftInvalid = true
                    hasMore = true
                    page = 1
                    view = "feed"
                    viewFeedDetail = false
                    showCompose = false
                    showFeed = true
                  }
                  Button("Cancel", p: 10, rounded: 10, bg: "#F5F6F8") {
                    view = "feed"
                    viewFeedDetail = false
                    showCompose = false
                    showFeed = true
                  }
                }
              }
            }
          }
        }

        // Login screen.
        if (showLogin) {
          Card(p: 22, rounded: 16, glass: true, border: "#ECEEF2") {
            Column(gap: 12) {
              BrandMark(20, "#111827", "#4F46E5", "#FFFFFF")
              Text("Welcome back", size: 22, color: "#111827")
              Text("Sign in to reply, react and follow members.", size: 13, color: "#6B7280")
              Input(bind: loginHandle, placeholder: "Handle")
              Input(bind: loginPassword, placeholder: "Password")
              if (authInvalid) {
                FormNote("{authError}")
              }
              Row(gap: 8, align: center) {
                Button("Sign in", p: 10, rounded: 10, bg: "#4F46E5") {
                  authError = "Use a handle and password to continue."
                  authInvalid = true
                  sessionActive = true
                  role = "member"
                  isModerator = false
                  view = "feed"
                  viewFeedDetail = false
                  showLogin = false
                  showFeed = true
                }
                Button("Create account", p: 10, rounded: 10, bg: "#F5F6F8") {
                  view = "register"
                  viewFeedDetail = false
                  showLogin = false
                  showRegister = true
                }
              }
            }
          }
        }

        // Register screen.
        if (showRegister) {
          Card(p: 22, rounded: 16, glass: true, border: "#ECEEF2") {
            Column(gap: 12) {
              BrandMark(20, "#111827", "#4F46E5", "#FFFFFF")
              Text("Join Relay", size: 22, color: "#111827")
              Text("Create an account to start discussions and follow others.", size: 13, color: "#6B7280")
              Input(bind: registerHandle, placeholder: "Handle")
              Input(bind: registerName, placeholder: "Display name")
              Input(bind: registerEmail, placeholder: "Email")
              Input(bind: registerPassword, placeholder: "Password")
              if (authInvalid) {
                FormNote("{authError}")
              }
              Row(gap: 8, align: center) {
                Button("Create account", p: 10, rounded: 10, bg: "#4F46E5") {
                  authError = "All fields are required to register."
                  authInvalid = true
                  sessionActive = true
                  role = "member"
                  isModerator = false
                  view = "feed"
                  viewFeedDetail = false
                  showRegister = false
                  showFeed = true
                }
                Button("Back to sign in", p: 10, rounded: 10, bg: "#F5F6F8") {
                  view = "login"
                  viewFeedDetail = false
                  showRegister = false
                  showLogin = true
                }
              }
            }
          }
        }

        // User profile: identity, stats, follow/block, activity feed.
        if (showProfile) {
          Column(gap: 14) {
            Card(p: 22, rounded: 16, glass: true, border: "#ECEEF2") {
              Row(gap: 14, align: center) {
                Avatar(label: "{profileName}")
                Column(gap: 3) {
                  Text("{profileName}", size: 22, color: "#111827")
                  Text("@{profileHandle} - {profileRole}", size: 13, color: "#6B7280")
                  Text("{meJoined}", size: 12, color: "#9CA3AF")
                }
              }
            }
            Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
              Column(gap: 12) {
                Text("{profileBio}", size: 14, color: "#374151")
                Row(gap: 8, align: center) {
                  Button("Follow", p: 8, rounded: 10, bg: "#4F46E5") {
                    following = true
                    profileLikes += 1
                  }
                  Button("Block", p: 8, rounded: 10, bg: "#F5F6F8") {
                    blocked = true
                  }
                  Button("Message", p: 8, rounded: 10, bg: "#F5F6F8") {
                    moderatorNote = "Message draft opened."
                  }
                }
                Row(gap: 8, align: center) {
                  Text("following: {following}", size: 12, color: "#6B7280")
                  Text("blocked: {blocked}", size: 12, color: "#6B7280")
                }
              }
            }
            Grid(columns: 3) {
              StatTile("Discussions", "{profilePosts}")
              StatTile("Replies", "{profileReplies}")
              StatTile("Likes", "{profileLikes}")
            }
            Card(p: 18, rounded: 16, glass: true, border: "#ECEEF2") {
              Column(gap: 10) {
                Text("Activity", size: 16, color: "#111827")
                for (i in 3) {
                  ActivityRow("{activityTexts[i]}", "{activityTimes[i]}")
                }
              }
            }
          }
        }

        // Notifications list with unread badge and mark-read.
        if (showNotifications) {
          Column(gap: 14) {
            SectionHead("Notifications", "{unreadCount} unread")
            Row(gap: 8, align: center) {
              Button("Mark all read", p: 8, rounded: 10, bg: "#4F46E5") {
                unreadCount = 0
                notificationsOpen = false
              }
              Text("queue total {noticeTotal}", size: 12, color: "#6B7280")
            }
            for (i in 3) {
              NotificationRow("{notificationKinds[i]}", "{notificationActors[i]}", "{notificationTexts[i]}", "{notificationTimes[i]}")
            }
          }
        }

        // Search results across discussions and members.
        if (showSearch) {
          Column(gap: 14) {
            SectionHead("Search", "results for {searchQuery}")
            Input(bind: searchText, placeholder: "Search discussions and members")
            Row(gap: 8, align: center) {
              Button("Run search", p: 8, rounded: 10, bg: "#4F46E5") {
                searchQuery = searchText
              }
            }
            for (i in 4) {
              ResultRow("{resultTitles[i]}", "{resultKinds[i]}", "{resultMeta[i]}")
            }
          }
        }

        // Moderation panel: flagged posts with delete/lock/mute actions.
        if (showModeration) {
          Column(gap: 14) {
            SectionHead("Moderation", "{flaggedCount} flagged - {mutedCount} muted")
            Card(p: 16, rounded: 14, glass: true, border: "#FBD5D5") {
              Column(gap: 6) {
                Row(gap: 8, align: center) {
                  Icon(name: "warning", color: "#B91C1C")
                  Text("Queue note", size: 13, color: "#7F1D1D")
                }
                Text("{moderatorNote}", size: 13, color: "#9A3412")
              }
            }
            for (i in 2) {
              FlagRow("{flagAuthors[i]}", "{flagTitles[i]}", "{flagReasons[i]}")
            }
          }
        }
      }
    }

    // Footer strip closes the page with brand, tagline and links.
    Container(p: 20, glass: true, border: "#ECEEF2") {
      Row(gap: 12, align: center) {
        // Cap the brand block so its inner row hugs instead of stretching and
        // squeezing the footer texts into clipped overlaps.
        Column(width: 92) {
          BrandMark(15, "#111827", "#4F46E5", "#FFFFFF")
        }
        Text("A calm place for thoughtful discussion.", size: 12, color: "#6B7280")
        Spacer(width: 1)
        Text("Guidelines - Tags - Members - Status", size: 12, color: "#9CA3AF")
      }
    }

  }
}
