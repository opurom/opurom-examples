// Relay theme block: one place defines the demo's own palette, radius and type
// scale so every screen shares a cohesive identity independent of any reference.
theme { mode: light, accent: "#E4572E", radius: 16, fontScale: 1.0 }

// Surface and ink tokens the screens reuse as literal colors.
// Ink #1B1F2A, muted #6B7280, line #E6E4EF, surface #FFFFFF,
// wash #F6F4FB, accent #E4572E, accent-soft #FDEAE2, accent-deep #B83E1C,
// plum #5B3FD1, plum-soft #EDE8FF.
