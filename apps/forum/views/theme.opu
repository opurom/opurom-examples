// Relay theme block: one place defines the demo's own palette, radius and type
// scale so every screen shares a cohesive identity independent of any reference.
// One restrained indigo accent carries the active state; every other surface stays calm.
theme { mode: light, accent: "#4F46E5", radius: 16, fontScale: 1.0, stage: "#EEF0F8" }

// Surface and ink tokens the screens reuse as literal colors.
// Ink #111827, muted #6B7280, faint #9CA3AF, hairline #ECEEF2, surface #FFFFFF,
// wash #F5F6F8, wash-2 #F3F4F8, accent #4F46E5, accent-soft #EEF0FF,
// success #22C55E, danger-soft #FEF2F2, danger #B91C1C, stage #EEF0F8.
