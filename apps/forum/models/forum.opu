// Relay forum data contracts: one model per entity so every screen, route and
// migration reads the same field set. Modeled-only module; checked via the entry.

model User {
  id: int primary
  handle: string
  displayName: string
  role: string
  bio: string
  joined: string
  postCount: int = 0
  replyCount: int = 0
  likeCount: int = 0
  followed: bool = false
  blocked: bool = false
  muted: bool = false
}

model Tag {
  id: int primary
  slug: string
  label: string
  color: string
  discussionCount: int = 0
}

model Discussion {
  id: int primary
  tagId: int
  author: string
  title: string
  body: string
  likes: int = 0
  replies: int = 0
  views: int = 0
  pinned: bool = false
  locked: bool = false
  flagged: bool = false
  createdAt: string
}

model Reply {
  id: int primary
  discussionId: int
  parentId: int = 0
  author: string
  body: string
  likes: int = 0
  edited: bool = false
  flagged: bool = false
  createdAt: string
}

model Reaction {
  id: int primary
  targetType: string
  targetId: int
  owner: string
}

model Bookmark {
  id: int primary
  discussionId: int
  owner: string
}

model Follow {
  id: int primary
  follower: string
  following: string
}

model Notification {
  id: int primary
  owner: string
  kind: string
  actor: string
  subject: string
  read: bool = false
  createdAt: string
}

model Flag {
  id: int primary
  targetType: string
  targetId: int
  reporter: string
  reason: string
  resolved: bool = false
}

model Session {
  id: int primary
  handle: string
  token: string
  issuedAt: string
}

api "/relay/users" {
  list User
  create User
}

api "/relay/users/:id" {
  get User
  update User
}

api "/relay/tags" {
  list Tag
  create Tag
}

api "/relay/discussions" {
  list Discussion
  create Discussion
}

api "/relay/discussions/:id" {
  get Discussion
  update Discussion
  delete Discussion
}

api "/relay/discussions/:id/replies" {
  list Reply
  create Reply
}

api "/relay/replies/:id" {
  update Reply
  delete Reply
}

api "/relay/reactions" {
  create Reaction
}

api "/relay/bookmarks" {
  list Bookmark
  create Bookmark
}

api "/relay/bookmarks/:id" {
  delete Bookmark
}

api "/relay/follows" {
  create Follow
}

api "/relay/notifications" {
  list Notification
  create Notification
}

api "/relay/notifications/:id" {
  update Notification
}

api "/relay/flags" {
  list Flag
  create Flag
}

api "/relay/flags/:id" {
  update Flag
}

api "/relay/session" {
  create Session
}

api "/relay/session/:id" {
  delete Session
}
