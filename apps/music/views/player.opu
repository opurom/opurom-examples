// Transport, lyric and queue values live apart from navigation so the bar and panel share one source.

// One tab flag per panel avoids overlapping right-side surfaces.
state panelLyrics = true
state panelQueue = false

// Shared playback values let the bar and settings read one source.
state currentIndex = 0
state playing = true
state position = 42
state duration = 214
state volume = 45
state mode = "sequence"
state repeatOne = false

// Direct record fields let any play action update the bar in one tap.
state npTitle = "Aurora Lights"
state npArtist = "Northwind"
state npAlbum = "First Light"

// Presence flags let next/previous resolve without runtime list indexing.
state np0 = true
state np1 = false
state np2 = false
state np3 = false
state np4 = false
state np5 = false

// One active flag per line keeps lyric highlighting exclusive.
state lyric0 = true
state lyric1 = false
state lyric2 = false
state lyric3 = false
state lyric4 = false
state lyric5 = false

// Inclusion flags let removal and reset stay declarative.
state queueTitles = ["Aurora Lights", "Coastal Drift", "Ember Field", "Harbor Line", "Northern Mark", "Quiet Current"]
state q0 = true
state q1 = true
state q2 = true
state q3 = true
state q4 = true
state q5 = true
