// Entities live in one module so every screen reads a single canonical schema.

model Track {
  id: int primary
  title: string
  artist: string
  album: string
  duration: int
  path: string
}

model Playlist {
  id: int primary
  name: string
  owner: string
  createdAt: string
}

model PlaylistTrack {
  id: int primary
  playlistId: int
  trackId: int
  position: int
}

model Source {
  id: int primary
  name: string
  kind: string
  enabled: bool = true
}

model LyricLine {
  id: int primary
  trackId: int
  text: string
  startMs: int
}

model Favorite {
  id: int primary
  trackId: int
  owner: string
}

model HistoryEntry {
  id: int primary
  trackId: int
  playedAt: string
}

model QueueItem {
  id: int primary
  trackId: int
  position: int
}

api "/music/tracks" {
  list Track
  create Track
}

api "/music/tracks/:id" {
  get Track
  update Track
  delete Track
}

api "/music/playlists" {
  list Playlist
  create Playlist
}

api "/music/playlists/:id" {
  get Playlist
  update Playlist
  delete Playlist
}

api "/music/playlists/:id/tracks" {
  list PlaylistTrack
  create PlaylistTrack
}

api "/music/playlists/:id/tracks/:trackId" {
  update PlaylistTrack
  delete PlaylistTrack
}

api "/music/sources" {
  list Source
  create Source
}

api "/music/sources/:id" {
  get Source
  update Source
  delete Source
}

api "/music/lyrics" {
  list LyricLine
}

api "/music/favorites" {
  list Favorite
  create Favorite
}

api "/music/favorites/:id" {
  delete Favorite
}

api "/music/history" {
  list HistoryEntry
  create HistoryEntry
}

api "/music/history/:id" {
  delete HistoryEntry
}

api "/music/queue" {
  list QueueItem
  create QueueItem
}

api "/music/queue/:id" {
  update QueueItem
  delete QueueItem
}
