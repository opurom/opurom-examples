              StatTile("New", "12 drops")
              StatTile("Genres", "4")
            }
            Scroll(height: 450, rounded: 16, glass: true) {
              Column(gap: 8, p: 12) {
                Text("Featured on {onlineSource} · {onlineCategory}", size: 13, color: "#9AA3B2")
                TrackRow("Aurora Lights", "Northwind", "First Light", 214, "3:34", "A", "#39415C", 0, true, false, false, false, false, false)
                TrackRow("Coastal Drift", "Cinder Row", "Tidal", 198, "3:18", "C", "#335058", 1, false, true, false, false, false, false)
                TrackRow("Ember Field", "The Pale Choir", "Ember Field", 245, "4:05", "E", "#4E4440", 2, false, false, true, false, false, false)
                TrackRow("Harbor Line", "Harbor Light", "Harbor Line", 176, "2:56", "H", "#3A4A5E", 3, false, false, false, true, false, false)
                TrackRow("Northern Mark", "Marlowe", "Northern Mark", 232, "3:52", "N", "#44405C", 4, false, false, false, false, true, false)
                TrackRow("Quiet Current", "Sable and Co", "Quiet Current", 205, "3:25", "Q", "#35555A", 5, false, false, false, false, false, true)
                Divider(border: "#2A3040")
                Text("{sourceNames[0]} · {sourceNames[1]} · {sourceNames[2]} · {sourceNames[3]}", size: 12, color: "#7C8595")
              }
            }
          }
        }

        if (viewPlaylists) {
          Column(gap: 12) {
            Column(gap: 4) {
              Text("Local Playlists", size: 22, color: "#E6E9EF")
              Text("Create, rename and reorder your sets", size: 12, color: "#9AA3B2")
            }
            Row(gap: 8, align: center) {
              Input(bind: newPlaylistName, placeholder: "New playlist name", bg: "#171A21", border: "#2A3040")
              Button("Create", bg: "#2E3155", border: "#454B85") {
                pl0Name = newPlaylistName
                pl0Visible = true
                pl0Count = 0
                pl0HasT0 = false
                pl0T0 = ""
                pl0T1 = ""
                pl0HasT1 = false
                pl0First = true
                pl0Extra = ""
                pl0HasExtra = false
                rename0 = ""
                renameOpen0 = false
              }
            }
            Card(p: 14, rounded: 14, glass: true) {
              Column(gap: 8) {
                Text("Add a track", size: 12, color: "#9AA3B2")
                Row(gap: 6, align: center) {
                  Button("Aurora", bg: "#232833", border: "#2A3040") {
                    addPick = "Aurora Lights"
                  }
                  Button("Coastal", bg: "#232833", border: "#2A3040") {
                    addPick = "Coastal Drift"
                  }
                  Button("Ember", bg: "#232833", border: "#2A3040") {
                    addPick = "Ember Field"
                  }
                  Button("Harbor", bg: "#232833", border: "#2A3040") {
                    addPick = "Harbor Line"
                  }
                  Button("Northern", bg: "#232833", border: "#2A3040") {
                    addPick = "Northern Mark"
                  }
                  Button("Quiet", bg: "#232833", border: "#2A3040") {
                    addPick = "Quiet Current"
                  }
                  Spacer(width: 8)
                  Chip("{addPick}")
                }
              }
            }
            Scroll(height: 450, rounded: 16, glass: true) {
              Column(gap: 12, p: 12) {
                if (pl0Visible) {
                  Card(p: 14, rounded: 14, glass: true) {
                    Column(gap: 10) {
                      Row(gap: 10, align: center) {
                        Container(p: 9, rounded: 9, bg: "#2E3155") {
                          Column(align: center, width: 16) {
                            Icon(name: "folder", color: "#C7CDDC")
                          }
                        }
                        Text("{pl0Name}", size: 15, color: "#E6E9EF")
                        Spacer(width: 8)
                        Chip("{pl0Count} tracks")
                        Button("Rename", bg: "#232833", border: "#2A3040") {
                          renameOpen0 = true
                        }
                        Button("Delete", bg: "#3A2430", border: "#553540") {
                          pl0Visible = false
                        }
                      }
                      if (renameOpen0) {
                        Row(gap: 8, align: center) {
                          Input(bind: rename0, placeholder: "Playlist name", bg: "#171A21", border: "#2A3040")
                          Button("Save", bg: "#2E3155", border: "#454B85") {
                            pl0Name = rename0
                            renameOpen0 = false
                          }
                        }
                      }
                      if (pl0HasT0) {
                        Text("{pl0T0}", size: 13, color: "#E6E9EF")
                      } else {
                        Text("Empty playlist - add a track below", size: 12, color: "#7C8595")
                      }
                      if (pl0HasT1) {
                        Text("{pl0T1}", size: 13, color: "#E6E9EF")
                      }
                      if (pl0HasExtra) {
                        Text("{pl0Extra}", size: 12, color: "#9AA3B2")
                      }
                      Row(gap: 8, align: center) {
                        Button("Add track", bg: "#2E3155", border: "#454B85") {
                          pl0Extra = addPick
                          pl0HasExtra = true
                          pl0T0 = addPick
                          pl0HasT0 = true
                          pl0Count += 1
                        }
                        Button("Remove last", bg: "#232833", border: "#2A3040") {
                          pl0HasExtra = false
                          pl0Extra = ""
                          pl0Count -= 1
                        }
                        Button("Move up", bg: "#232833", border: "#2A3040") {
                          pl0First = true
                        }
                        Button("Move down", bg: "#232833", border: "#2A3040") {
                          pl0First = false
                        }
                      }
                    }
                  }
                }
                if (pl1Visible) {
                  Card(p: 14, rounded: 14, glass: true) {
                    Column(gap: 10) {
                      Row(gap: 10, align: center) {
                        Container(p: 9, rounded: 9, bg: "#2E3155") {
                          Column(align: center, width: 16) {
                            Icon(name: "folder", color: "#C7CDDC")
                          }
                        }
                        Text("{pl1Name}", size: 15, color: "#E6E9EF")
                        Spacer(width: 8)
                        Chip("{pl1Count} tracks")
                        Button("Rename", bg: "#232833", border: "#2A3040") {
                          renameOpen1 = true
                        }
                        Button("Delete", bg: "#3A2430", border: "#553540") {
                          pl1Visible = false
                        }
                      }
                      if (renameOpen1) {
                        Row(gap: 8, align: center) {
                          Input(bind: rename1, placeholder: "Playlist name", bg: "#171A21", border: "#2A3040")
                          Button("Save", bg: "#2E3155", border: "#454B85") {
                            pl1Name = rename1
                            renameOpen1 = false
                          }
                        }
                      }
                      if (pl1First) {
                        TrackRow("Aurora Lights", "Northwind", "First Light", 214, "3:34", "A", "#39415C", 0, true, false, false, false, false, false)
                        if (pl1HasT1) {
                          TrackRow("Coastal Drift", "Cinder Row", "Tidal", 198, "3:18", "C", "#335058", 1, false, true, false, false, false, false)
                        }
                      } else {
                        if (pl1HasT1) {
                          TrackRow("Coastal Drift", "Cinder Row", "Tidal", 198, "3:18", "C", "#335058", 1, false, true, false, false, false, false)
                        }
                        if (pl1HasT0) {
                          TrackRow("Aurora Lights", "Northwind", "First Light", 214, "3:34", "A", "#39415C", 0, true, false, false, false, false, false)
                        }
                      }
                      if (pl1HasExtra) {
                        Row(gap: 8, align: center) {
                          Chip("{pl1Extra}")
                          Button("Remove", bg: "#232833", border: "#2A3040") {
                            pl1HasExtra = false
                            pl1Extra = ""
                            pl1Count -= 1
                          }
                        }
                      }
                      Row(gap: 8, align: center) {
                        Button("Add track", bg: "#2E3155", border: "#454B85") {
                          pl1Extra = addPick
                          pl1HasExtra = true
                          pl1Count += 1
                        }
                        Button("Remove track", bg: "#232833", border: "#2A3040") {
                          pl1HasT1 = false
                          pl1T1 = ""
                          pl1Count -= 1
                        }
                        Button("Move up", bg: "#232833", border: "#2A3040") {
                          pl1First = true
                        }
                        Button("Move down", bg: "#232833", border: "#2A3040") {
                          pl1First = false
                        }
                      }
                    }
                  }
                }
                if (pl2Visible) {
                  Card(p: 14, rounded: 14, glass: true) {
                    Column(gap: 10) {
                      Row(gap: 10, align: center) {
                        Container(p: 9, rounded: 9, bg: "#2E3155") {
                          Column(align: center, width: 16) {
                            Icon(name: "folder", color: "#C7CDDC")
                          }
                        }
                        Text("{pl2Name}", size: 15, color: "#E6E9EF")
                        Spacer(width: 8)
                        Chip("{pl2Count} tracks")
                        Button("Rename", bg: "#232833", border: "#2A3040") {
                          renameOpen2 = true
                        }
                        Button("Delete", bg: "#3A2430", border: "#553540") {
                          pl2Visible = false
                        }
                      }
                      if (renameOpen2) {
                        Row(gap: 8, align: center) {
                          Input(bind: rename2, placeholder: "Playlist name", bg: "#171A21", border: "#2A3040")
                          Button("Save", bg: "#2E3155", border: "#454B85") {
                            pl2Name = rename2
                            renameOpen2 = false
                          }
                        }
                      }
                      if (pl2First) {
                        TrackRow("Ember Field", "The Pale Choir", "Ember Field", 245, "4:05", "E", "#4E4440", 2, false, false, true, false, false, false)
                        if (pl2HasT1) {
                          TrackRow("Harbor Line", "Harbor Light", "Harbor Line", 176, "2:56", "H", "#3A4A5E", 3, false, false, false, true, false, false)
                        }
                      } else {
                        if (pl2HasT1) {
                          TrackRow("Harbor Line", "Harbor Light", "Harbor Line", 176, "2:56", "H", "#3A4A5E", 3, false, false, false, true, false, false)
                        }
                        if (pl2HasT0) {
                          TrackRow("Ember Field", "The Pale Choir", "Ember Field", 245, "4:05", "E", "#4E4440", 2, false, false, true, false, false, false)
                        }
                      }
                      if (pl2HasExtra) {
