
// Exclusive line flags keep exactly one lyric highlighted.
component LyricsPanel() {
  Card(p: 14, rounded: 16, glass: true) {
    Column(gap: 10) {
      Text("Lyrics", size: 16, color: "#E6E9EF")
      Text("{npTitle} · {npArtist}", size: 12, color: "#9AA3B2")
      Scroll(height: 340, border: "#2A3040", rounded: 14) {
        Column(gap: 10, p: 12) {
          if (lyric0) {
            Container(p: 12, rounded: 12, bg: "#2E3155", border: "#454B85") {
              Text("Hold the light, the coast is near", size: 14, color: "#E6E9EF")
            }
          } else {
            Text("Hold the light, the coast is near", size: 13, color: "#7C8595")
          }
          if (lyric1) {
            Container(p: 12, rounded: 12, bg: "#2E3155", border: "#454B85") {
              Text("Morning moves across the floor", size: 14, color: "#E6E9EF")
            }
          } else {
            Text("Morning moves across the floor", size: 13, color: "#7C8595")
          }
          if (lyric2) {
            Container(p: 12, rounded: 12, bg: "#2E3155", border: "#454B85") {
              Text("Every window holds a name", size: 14, color: "#E6E9EF")
            }
          } else {
            Text("Every window holds a name", size: 13, color: "#7C8595")
          }
          if (lyric3) {
            Container(p: 12, rounded: 12, bg: "#2E3155", border: "#454B85") {
              Text("We drive until the signal fades", size: 14, color: "#E6E9EF")
            }
          } else {
            Text("We drive until the signal fades", size: 13, color: "#7C8595")
          }
          if (lyric4) {
            Container(p: 12, rounded: 12, bg: "#2E3155", border: "#454B85") {
              Text("Quiet current, steady hand", size: 14, color: "#E6E9EF")
            }
          } else {
            Text("Quiet current, steady hand", size: 13, color: "#7C8595")
          }
          if (lyric5) {
            Container(p: 12, rounded: 12, bg: "#2E3155", border: "#454B85") {
              Text("Carry it home, carry it on", size: 14, color: "#E6E9EF")
            }
          } else {
            Text("Carry it home, carry it on", size: 13, color: "#7C8595")
          }
        }
      }
      Text("Lines highlight as the track plays.", size: 12, color: "#7C8595")
    }
  }
}

// Inclusion flags let each queue entry be played or removed independently.
component QueuePanel() {
  Card(p: 14, rounded: 16, glass: true) {
    Column(gap: 10) {
      Text("Up next", size: 16, color: "#E6E9EF")
      Text("{mode} mode · 6 tracks", size: 12, color: "#9AA3B2")
      Row(gap: 8, align: center) {
        Button("Clear queue", bg: "#3A2430", border: "#553540") {
          q0 = false
          q1 = false
          q2 = false
          q3 = false
          q4 = false
          q5 = false
        }
        Button("Reset queue", bg: "#232833", border: "#2A3040") {
          q0 = true
          q1 = true
          q2 = true
          q3 = true
          q4 = true
          q5 = true
        }
      }
      Scroll(height: 380, border: "#2A3040", rounded: 14) {
        Column(gap: 8, p: 12) {
          if (q0) {
            Card(p: 10, rounded: 12, border: "#2A3040") {
              Column(gap: 8) {
                Row(gap: 10, align: center) {
                  MiniCover("#39415C", "A")
                  Column(gap: 2, width: 140) {
                    Text("Aurora Lights", size: 13, color: "#E6E9EF")
                    Text("Northwind · 3:34", size: 11, color: "#9AA3B2")
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Play", bg: "#2E3155", border: "#454B85") {
                    npTitle = "Aurora Lights"
                    npArtist = "Northwind"
                    npAlbum = "First Light"
                    duration = 214
                    currentIndex = 0
                    np0 = true
                    np1 = false
                    np2 = false
                    np3 = false
                    np4 = false
                    np5 = false
                    playing = true
                  }
                  Button("Remove", bg: "#232833", border: "#2A3040") {
                    q0 = false
                  }
                }
              }
            }
          }
          if (q1) {
            Card(p: 10, rounded: 12, border: "#2A3040") {
              Column(gap: 8) {
                Row(gap: 10, align: center) {
                  MiniCover("#335058", "C")
                  Column(gap: 2, width: 140) {
                    Text("Coastal Drift", size: 13, color: "#E6E9EF")
                    Text("Cinder Row · 3:18", size: 11, color: "#9AA3B2")
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Play", bg: "#2E3155", border: "#454B85") {
                    npTitle = "Coastal Drift"
                    npArtist = "Cinder Row"
                    npAlbum = "Tidal"
                    duration = 198
                    currentIndex = 1
                    np0 = false
                    np1 = true
                    np2 = false
                    np3 = false
                    np4 = false
                    np5 = false
                    playing = true
                  }
                  Button("Remove", bg: "#232833", border: "#2A3040") {
                    q1 = false
                  }
                }
              }
            }
          }
          if (q2) {
            Card(p: 10, rounded: 12, border: "#2A3040") {
              Column(gap: 8) {
                Row(gap: 10, align: center) {
                  MiniCover("#4E4440", "E")
                  Column(gap: 2, width: 140) {
                    Text("Ember Field", size: 13, color: "#E6E9EF")
                    Text("The Pale Choir · 4:05", size: 11, color: "#9AA3B2")
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Play", bg: "#2E3155", border: "#454B85") {
                    npTitle = "Ember Field"
                    npArtist = "The Pale Choir"
                    npAlbum = "Ember Field"
                    duration = 245
                    currentIndex = 2
                    np0 = false
                    np1 = false
                    np2 = true
                    np3 = false
                    np4 = false
                    np5 = false
                    playing = true
                  }
                  Button("Remove", bg: "#232833", border: "#2A3040") {
                    q2 = false
                  }
                }
              }
            }
          }
          if (q3) {
            Card(p: 10, rounded: 12, border: "#2A3040") {
              Column(gap: 8) {
                Row(gap: 10, align: center) {
                  MiniCover("#3A4A5E", "H")
                  Column(gap: 2, width: 140) {
                    Text("Harbor Line", size: 13, color: "#E6E9EF")
                    Text("Harbor Light · 2:56", size: 11, color: "#9AA3B2")
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Play", bg: "#2E3155", border: "#454B85") {
                    npTitle = "Harbor Line"
                    npArtist = "Harbor Light"
                    npAlbum = "Harbor Line"
                    duration = 176
                    currentIndex = 3
                    np0 = false
                    np1 = false
                    np2 = false
                    np3 = true
                    np4 = false
                    np5 = false
                    playing = true
                  }
                  Button("Remove", bg: "#232833", border: "#2A3040") {
                    q3 = false
                  }
                }
              }
            }
          }
          if (q4) {
            Card(p: 10, rounded: 12, border: "#2A3040") {
              Column(gap: 8) {
                Row(gap: 10, align: center) {
                  MiniCover("#44405C", "N")
                  Column(gap: 2, width: 140) {
                    Text("Northern Mark", size: 13, color: "#E6E9EF")
                    Text("Marlowe · 3:52", size: 11, color: "#9AA3B2")
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Play", bg: "#2E3155", border: "#454B85") {
                    npTitle = "Northern Mark"
                    npArtist = "Marlowe"
                    npAlbum = "Northern Mark"
                    duration = 232
                    currentIndex = 4
                    np0 = false
                    np1 = false
                    np2 = false
                    np3 = false
                    np4 = true
                    np5 = false
                    playing = true
                  }
                  Button("Remove", bg: "#232833", border: "#2A3040") {
                    q4 = false
                  }
                }
              }
            }
          }
          if (q5) {
            Card(p: 10, rounded: 12, border: "#2A3040") {
              Column(gap: 8) {
                Row(gap: 10, align: center) {
                  MiniCover("#35555A", "Q")
                  Column(gap: 2, width: 140) {
                    Text("Quiet Current", size: 13, color: "#E6E9EF")
                    Text("Sable and Co · 3:25", size: 11, color: "#9AA3B2")
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Play", bg: "#2E3155", border: "#454B85") {
                    npTitle = "Quiet Current"
                    npArtist = "Sable and Co"
                    npAlbum = "Quiet Current"
                    duration = 205
                    currentIndex = 5
                    np0 = false
                    np1 = false
                    np2 = false
                    np3 = false
                    np4 = false
                    np5 = true
                    playing = true
                  }
                  Button("Remove", bg: "#232833", border: "#2A3040") {
                    q5 = false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// The bar is a root sibling so it stays visible across every screen.
component NowBar() {
  Card(p: 14, rounded: 16, glass: true) {
    Row(gap: 14, align: center) {
      Container(p: 18, rounded: 12, bg: "#6366F1") {
        Column(align: center, width: 16) {
          Icon(name: "play", color: "#E6E9EF")
        }
      }
      Column(gap: 3, width: 220) {
        Text("{npTitle}", size: 15, color: "#E6E9EF")
        Text("{npArtist} · {npAlbum}", size: 12, color: "#9AA3B2")
        Chip("{mode} mode")
      }
      Row(gap: 8, align: center, width: 320) {
        if (np0) {
          Step("Prev", "Quiet Current", "Sable and Co", "Quiet Current", 205, 5, false, false, false, false, false, true)
        }
        if (np1) {
          Step("Prev", "Aurora Lights", "Northwind", "First Light", 214, 0, true, false, false, false, false, false)
        }
        if (np2) {
          Step("Prev", "Coastal Drift", "Cinder Row", "Tidal", 198, 1, false, true, false, false, false, false)
        }
        if (np3) {
          Step("Prev", "Ember Field", "The Pale Choir", "Ember Field", 245, 2, false, false, true, false, false, false)
        }
        if (np4) {
          Step("Prev", "Harbor Line", "Harbor Light", "Harbor Line", 176, 3, false, false, false, true, false, false)
        }
        if (np5) {
          Step("Prev", "Northern Mark", "Marlowe", "Northern Mark", 232, 4, false, false, false, false, true, false)
        }
        Button("Play / Pause", bg: "#6366F1") {
          playing.toggle()
        }
        if (np0) {
          Step("Next", "Coastal Drift", "Cinder Row", "Tidal", 198, 1, false, true, false, false, false, false)
        }
        if (np1) {
          Step("Next", "Ember Field", "The Pale Choir", "Ember Field", 245, 2, false, false, true, false, false, false)
        }
        if (np2) {
          Step("Next", "Harbor Line", "Harbor Light", "Harbor Line", 176, 3, false, false, false, true, false, false)
        }
        if (np3) {
          Step("Next", "Northern Mark", "Marlowe", "Northern Mark", 232, 4, false, false, false, false, true, false)
        }
        if (np4) {
          Step("Next", "Quiet Current", "Sable and Co", "Quiet Current", 205, 5, false, false, false, false, false, true)
        }
        if (np5) {
          Step("Next", "Aurora Lights", "Northwind", "First Light", 214, 0, true, false, false, false, false, false)
        }
      }
      Column(gap: 6, width: 340) {
        Slider(bind: position, min: 0, max: 260)
        Row(gap: 8, align: center) {
          Text("seek {position}s · {duration}s total", size: 12, color: "#9AA3B2")
          Spacer(width: 8)
          Text("{remaining}s left", size: 12, color: "#7C8595")
        }
        Row(gap: 3, align: end) {
          Image(src: "", width: 4, height: 8, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 14, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 20, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 12, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 24, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 16, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 26, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 10, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 18, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 22, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 14, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 26, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 18, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 10, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 24, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 14, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 20, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 12, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 26, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 16, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 10, rounded: 2, bg: "#3A4152")
          Image(src: "", width: 4, height: 18, rounded: 2, bg: "#3A4152")
        }
      }
      Column(gap: 8, width: 260) {
        Row(gap: 6, align: center) {
          if (modeSeq) {
            Button("Seq", bg: "#2E3155", border: "#454B85") {
              mode = "sequence"
              modeSeq = true
              modeLoop = false
              modeShuffle = false
            }
          } else {
            Button("Seq", bg: "#232833", border: "#2A3040") {
              mode = "sequence"
              modeSeq = true
              modeLoop = false
              modeShuffle = false
            }
          }
          if (modeLoop) {
            Button("Loop", bg: "#2E3155", border: "#454B85") {
              mode = "loop"
              modeSeq = false
              modeLoop = true
              modeShuffle = false
            }
          } else {
            Button("Loop", bg: "#232833", border: "#2A3040") {
              mode = "loop"
              modeSeq = false
              modeLoop = true
              modeShuffle = false
            }
          }
          if (modeShuffle) {
            Button("Mix", bg: "#2E3155", border: "#454B85") {
              mode = "shuffle"
              modeSeq = false
              modeLoop = false
              modeShuffle = true
            }
          } else {
            Button("Mix", bg: "#232833", border: "#2A3040") {
              mode = "shuffle"
              modeSeq = false
              modeLoop = false
              modeShuffle = true
            }
          }
        }
        Row(gap: 8, align: center) {
          Text("repeat one", size: 12, color: "#9AA3B2")
          if (repeatOne) {
            Button("On", bg: "#2E3155", border: "#454B85") {
              repeatOne = false
            }
          } else {
            Button("Off", bg: "#232833", border: "#2A3040") {
              repeatOne = true
            }
          }
        }
        Slider(bind: volume, min: 0, max: 100)
        Row(gap: 8, align: center) {
          Text("volume {volume}%", size: 12, color: "#9AA3B2")
          Spacer(width: 8)
          Button("Queue", bg: "#232833", border: "#2A3040") {
            panelQueue = true
            panelLyrics = false
          }
        }
      }
    }
  }
}


import "models/library.opu";
import "views/state.opu";
import "views/player.opu";

// Components stay in the entry because imported modules accept data declarations only.

// Surfaces sit close together in value so the single indigo accent stays the only loud color.

// A soft neutral chip replaces the framework badge, which paints one light fill for every label.
component Chip(text: string) {
  Container(p: 4, rounded: 999, bg: "#232833", border: "#2A3040") {
    Text("{text}", size: 12, color: "#9AA3B2")
  }
}

// Cover art is a tinted gradient tile with the track initial, so the demo needs no external images.
component Cover(tint: string, initial: string) {
  Container(p: 12, rounded: 10, gradient: "{tint},#232833") {
    Column(align: center, width: 20) {
      Text("{initial}", size: 14, color: "#B7BFCE")
    }
  }
}

component MiniCover(tint: string, initial: string) {
  Container(p: 7, rounded: 9, gradient: "{tint},#232833") {
    Column(align: center, width: 20) {
      Text("{initial}", size: 12, color: "#B7BFCE")
    }
  }
}

// Rail and panel icon tiles center a fixed 16px glyph through balanced padding.
component IconTile(icon: string) {
  Container(p: 7, rounded: 9, bg: "#232833", border: "#2A3040") {
    Column(align: center, width: 16) {
      Icon(name: "{icon}", color: "#9AA3B2")
    }
  }
}

component IconTileActive(icon: string) {
  Container(p: 7, rounded: 9, bg: "#2E3155", border: "#454B85") {
    Column(align: center, width: 16) {
      Icon(name: "{icon}", color: "#C7CDDC")
    }
  }
}

// Each play action writes the whole record so the bar updates in one tap.
component TrackRow(title: string, artist: string, album: string, dur: int, durLabel: string, initial: string, tint: string, index: int, f0: bool, f1: bool, f2: bool, f3: bool, f4: bool, f5: bool) {
  Card(p: 12, rounded: 14, glass: true) {
    Row(gap: 12, align: center) {
      Cover(tint, initial)
      Column(gap: 3, width: 400) {
        Text("{title}", size: 14, color: "#E6E9EF")
        Text("{artist} · {album}", size: 12, color: "#9AA3B2")
      }
      Spacer(width: 8)
      Text("{durLabel}", size: 12, color: "#7C8595")
      Button("Play", bg: "#2E3155", border: "#454B85") {
        npTitle = title
        npArtist = artist
        npAlbum = album
        duration = dur
        currentIndex = index
        np0 = f0
        np1 = f1
        np2 = f2
        np3 = f3
        np4 = f4
        np5 = f5
        playing = true
      }
    }
  }
}

// Literal target data keeps transport changes declarative.
component Step(label: string, title: string, artist: string, album: string, dur: int, index: int, f0: bool, f1: bool, f2: bool, f3: bool, f4: bool, f5: bool) {
  Button("{label}", bg: "#232833", border: "#2A3040") {
    npTitle = title
    npArtist = artist
    npAlbum = album
    duration = dur
    currentIndex = index
    np0 = f0
    np1 = f1
    np2 = f2
    np3 = f3
    np4 = f4
    np5 = f5
    playing = true
  }
}

component StatTile(label: string, metric: string) {
  Card(p: 14, rounded: 14, glass: true) {
    Column(gap: 4) {
      Text("{label}", size: 12, color: "#7C8595")
      Text("{metric}", size: 20, color: "#E6E9EF")
    }
  }
}

component SettingRow(label: string, value: string) {
  Row(gap: 8, align: center) {
    Text("{label}", size: 13, color: "#9AA3B2")
    Spacer(width: 8)
    Text("{value}", size: 12, color: "#E6E9EF")
  }
}

app Halcyon {
  computed remaining = duration - position

  theme { mode: dark, accent: "#6366F1", radius: 12, fontScale: 1.0, stage: "#171D2E" }

  // One shell keeps the three regions and the bar in a single tree.
  Column(p: 0, gap: 0) {
    Card(p: 14, rounded: 16, glass: true) {
      Row(gap: 12, align: center) {
        Container(p: 10, rounded: 11, bg: "#6366F1") {
          Column(align: center, width: 16) {
            Icon(name: "play", color: "#FFFFFF")
          }
        }
        Column(gap: 2, width: 200) {
          Text("Halcyon", size: 20, color: "#E6E9EF")
          Text("Desktop music player", size: 12, color: "#9AA3B2")
        }
        Spacer(width: 10)
        Chip("{mode} mode · volume {volume}%")
      }
    }

    Row(gap: 16, p: 16) {
      // Screen flags guard each rail button's active marker.
      Column(width: 236, gap: 10, p: 14) {
        Card(p: 14, rounded: 14, glass: true) {
          Column(gap: 4) {
            Text("Library", size: 16, color: "#E6E9EF")
            Text("One library, every view", size: 12, color: "#9AA3B2")
          }
        }
        Row(gap: 10, align: center) {
          if (viewSearch) {
            IconTileActive("search")
          } else {
            IconTile("search")
          }
          if (viewSearch) {
            Button("Search", bg: "#2E3155", border: "#454B85") {
              viewSearch = true
              viewOnline = false
              viewPlaylists = false
              viewFavorites = false
              viewHistory = false
              viewSettings = false
            }
          } else {
            Button("Search", bg: "#1F232C", border: "#2A3040") {
              viewSearch = true
              viewOnline = false
              viewPlaylists = false
              viewFavorites = false
              viewHistory = false
              viewSettings = false
            }
          }
        }
        Row(gap: 10, align: center) {
          if (viewOnline) {
            IconTileActive("home")
          } else {
            IconTile("home")
          }
          if (viewOnline) {
            Button("Online Library", bg: "#2E3155", border: "#454B85") {
              viewSearch = false
              viewOnline = true
              viewPlaylists = false
              viewFavorites = false
              viewHistory = false
              viewSettings = false
            }
          } else {
            Button("Online Library", bg: "#1F232C", border: "#2A3040") {
              viewSearch = false
              viewOnline = true
              viewPlaylists = false
              viewFavorites = false
              viewHistory = false
              viewSettings = false
            }
          }
        }
        Row(gap: 10, align: center) {
          if (viewPlaylists) {
            IconTileActive("folder")
          } else {
            IconTile("folder")
          }
          if (viewPlaylists) {
            Button("Local Playlists", bg: "#2E3155", border: "#454B85") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = true
              viewFavorites = false
              viewHistory = false
              viewSettings = false
            }
          } else {
            Button("Local Playlists", bg: "#1F232C", border: "#2A3040") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = true
              viewFavorites = false
              viewHistory = false
              viewSettings = false
            }
          }
        }
        Row(gap: 10, align: center) {
          if (viewFavorites) {
            IconTileActive("heart")
          } else {
            IconTile("heart")
          }
          if (viewFavorites) {
            Button("Favorites", bg: "#2E3155", border: "#454B85") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = false
              viewFavorites = true
              viewHistory = false
              viewSettings = false
            }
          } else {
            Button("Favorites", bg: "#1F232C", border: "#2A3040") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = false
              viewFavorites = true
              viewHistory = false
              viewSettings = false
            }
          }
        }
        Row(gap: 10, align: center) {
          if (viewHistory) {
            IconTileActive("bell")
          } else {
            IconTile("bell")
          }
          if (viewHistory) {
            Button("History", bg: "#2E3155", border: "#454B85") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = false
              viewFavorites = false
              viewHistory = true
              viewSettings = false
            }
          } else {
            Button("History", bg: "#1F232C", border: "#2A3040") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = false
              viewFavorites = false
              viewHistory = true
              viewSettings = false
            }
          }
        }
        Row(gap: 10, align: center) {
          if (viewSettings) {
            IconTileActive("settings")
          } else {
            IconTile("settings")
          }
          if (viewSettings) {
            Button("Settings", bg: "#2E3155", border: "#454B85") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = false
              viewFavorites = false
              viewHistory = false
              viewSettings = true
            }
          } else {
            Button("Settings", bg: "#1F232C", border: "#2A3040") {
              viewSearch = false
              viewOnline = false
              viewPlaylists = false
              viewFavorites = false
              viewHistory = false
              viewSettings = true
            }
          }
        }
        Card(p: 12, rounded: 12, glass: true) {
          Column(gap: 4) {
            Text("Now playing", size: 12, color: "#7C8595")
            Text("{npTitle}", size: 13, color: "#E6E9EF")
            Text("{npArtist}", size: 12, color: "#9AA3B2")
            Chip("{mode} mode")
          }
        }
        Card(p: 12, rounded: 12, glass: true) {
          Column(gap: 4) {
            Text("Library", size: 12, color: "#7C8595")
            Text("6 tracks", size: 13, color: "#E6E9EF")
            Text("4 sources", size: 12, color: "#9AA3B2")
          }
        }
      }

      // One branch per screen keeps every view reachable from the rail.
      Column(width: 740, gap: 14) {
        if (viewSearch) {
          Column(gap: 12) {
            Column(gap: 4) {
              Text("Search", size: 22, color: "#E6E9EF")
              Text("Find tracks across your library", size: 12, color: "#9AA3B2")
            }
            Input(bind: searchText, placeholder: "Search tracks, artists, albums", bg: "#171A21", border: "#2A3040")
            Row(gap: 8, align: center) {
              Text("Sort by", size: 12, color: "#7C8595")
              Button("Title", bg: "#232833", border: "#2A3040") {
                sortKey = "title"
              }
              Button("Artist", bg: "#232833", border: "#2A3040") {
                sortKey = "artist"
              }
              Button("Album", bg: "#232833", border: "#2A3040") {
                sortKey = "album"
              }
              Button("Duration", bg: "#232833", border: "#2A3040") {
                sortKey = "duration"
              }
              Spacer(width: 8)
              Chip("sorted by {sortKey}")
            }
            Card(p: 14, rounded: 14, glass: true) {
              Column(gap: 10) {
                Text("Select tracks", size: 12, color: "#9AA3B2")
                Row(gap: 8, align: center) {
                  if (sel0) {
                    Button("1", bg: "#2E3155", border: "#454B85") {
                      sel0 = false
                    }
                  } else {
                    Button("1", bg: "#232833", border: "#2A3040") {
                      sel0 = true
                    }
                  }
                  if (sel1) {
                    Button("2", bg: "#2E3155", border: "#454B85") {
                      sel1 = false
                    }
                  } else {
                    Button("2", bg: "#232833", border: "#2A3040") {
                      sel1 = true
                    }
                  }
                  if (sel2) {
                    Button("3", bg: "#2E3155", border: "#454B85") {
                      sel2 = false
                    }
                  } else {
                    Button("3", bg: "#232833", border: "#2A3040") {
                      sel2 = true
                    }
                  }
                  if (sel3) {
                    Button("4", bg: "#2E3155", border: "#454B85") {
                      sel3 = false
                    }
                  } else {
                    Button("4", bg: "#232833", border: "#2A3040") {
                      sel3 = true
                    }
                  }
                  if (sel4) {
                    Button("5", bg: "#2E3155", border: "#454B85") {
                      sel4 = false
                    }
                  } else {
                    Button("5", bg: "#232833", border: "#2A3040") {
                      sel4 = true
                    }
                  }
                  if (sel5) {
                    Button("6", bg: "#2E3155", border: "#454B85") {
                      sel5 = false
                    }
                  } else {
                    Button("6", bg: "#232833", border: "#2A3040") {
                      sel5 = true
                    }
                  }
                }
                Row(gap: 8, align: center) {
                  Button("Select all", bg: "#2E3155", border: "#454B85") {
                    sel0 = true
                    sel1 = true
                    sel2 = true
                    sel3 = true
                    sel4 = true
                    sel5 = true
                  }
                  Button("Clear selection", bg: "#232833", border: "#2A3040") {
                    sel0 = false
                    sel1 = false
                    sel2 = false
                    sel3 = false
                    sel4 = false
                    sel5 = false
                  }
                }
              }
            }
            Grid(columns: 3) {
              StatTile("Tracks", "6")
              StatTile("Sources", "4")
              StatTile("Playlists", "3")
            }
            Scroll(height: 470, rounded: 16, glass: true) {
              Column(gap: 8, p: 12) {
                TrackRow("Aurora Lights", "Northwind", "First Light", 214, "3:34", "A", "#39415C", 0, true, false, false, false, false, false)
                TrackRow("Coastal Drift", "Cinder Row", "Tidal", 198, "3:18", "C", "#335058", 1, false, true, false, false, false, false)
                TrackRow("Ember Field", "The Pale Choir", "Ember Field", 245, "4:05", "E", "#4E4440", 2, false, false, true, false, false, false)
                TrackRow("Harbor Line", "Harbor Light", "Harbor Line", 176, "2:56", "H", "#3A4A5E", 3, false, false, false, true, false, false)
                TrackRow("Northern Mark", "Marlowe", "Northern Mark", 232, "3:52", "N", "#44405C", 4, false, false, false, false, true, false)
                TrackRow("Quiet Current", "Sable and Co", "Quiet Current", 205, "3:25", "Q", "#35555A", 5, false, false, false, false, false, true)
              }
            }
          }
        }

        if (viewOnline) {
          Column(gap: 12) {
            Column(gap: 4) {
              Text("Online Library", size: 22, color: "#E6E9EF")
              Text("Four curated sources, one queue", size: 12, color: "#9AA3B2")
            }
            Row(gap: 8, align: center) {
              Text("Source", size: 12, color: "#7C8595")
              Button("Aurora FM", bg: "#232833", border: "#2A3040") {
                onlineSource = "Aurora FM"
              }
              Button("Lumen Sound", bg: "#232833", border: "#2A3040") {
                onlineSource = "Lumen Sound"
              }
              Button("Northwave Radio", bg: "#232833", border: "#2A3040") {
                onlineSource = "Northwave Radio"
              }
              Button("Echo Cache", bg: "#232833", border: "#2A3040") {
                onlineSource = "Echo Cache"
              }
