        if (viewSettings) {
          Column(gap: 12) {
            Column(gap: 4) {
              Text("Settings", size: 22, color: "#E6E9EF")
              Text("Playback, appearance and sources", size: 12, color: "#9AA3B2")
            }
            Scroll(height: 540, rounded: 16, glass: true) {
              Column(gap: 12, p: 12) {
                Card(p: 16, rounded: 14, glass: true) {
                  Column(gap: 10) {
                    Text("Playback defaults", size: 16, color: "#E6E9EF")
                    SettingRow("Default volume", "{settingVolume}%")
                    Slider(bind: settingVolume, min: 0, max: 100)
                    SettingRow("Startup mode", "{settingMode}")
                    Row(gap: 6, align: center) {
                      Button("Sequence", bg: "#232833", border: "#2A3040") {
                        settingMode = "sequence"
                      }
                      Button("Loop", bg: "#232833", border: "#2A3040") {
                        settingMode = "loop"
                      }
                      Button("Shuffle", bg: "#232833", border: "#2A3040") {
                        settingMode = "shuffle"
                      }
                    }
                    Row(gap: 12, align: center) {
                      Text("shuffle on startup", size: 12, color: "#9AA3B2")
                      if (settingShuffle) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          settingShuffle = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          settingShuffle = true
                        }
                      }
                      Text("crossfade", size: 12, color: "#9AA3B2")
                      if (settingCrossfade) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          settingCrossfade = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          settingCrossfade = true
                        }
                      }
                      Text("prefetch", size: 12, color: "#9AA3B2")
                      if (settingPrefetch) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          settingPrefetch = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          settingPrefetch = true
                        }
                      }
                    }
                  }
                }
                Card(p: 16, rounded: 14, glass: true) {
                  Column(gap: 10) {
                    Text("Appearance", size: 16, color: "#E6E9EF")
                    Row(gap: 12, align: center) {
                      Text("dark theme", size: 12, color: "#9AA3B2")
                      if (darkTheme) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          darkTheme = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          darkTheme = true
                        }
                      }
                    }
                    if (darkTheme) {
                      Card(p: 14, rounded: 12, bg: "#171A21", border: "#2A3040") {
                        Row(gap: 12, align: center) {
                          Column(gap: 4, width: 240) {
                            Text("Dark palette", size: 13, color: "#E6E9EF")
                            Text("Graphite surfaces, one indigo accent", size: 12, color: "#9AA3B2")
                          }
                          Spacer(width: 8)
                          Image(src: "", width: 28, height: 28, rounded: 8, bg: "#6366F1")
                        }
                      }
                    } else {
                      Card(p: 14, rounded: 12, bg: "#E6E9EF", border: "#C9CFDD") {
                        Row(gap: 12, align: center) {
                          Column(gap: 4, width: 240) {
                            Text("Light palette", size: 13, color: "#171A21")
                            Text("Pale surfaces, indigo accent", size: 12, color: "#4E53B5")
                          }
                          Spacer(width: 8)
                          Image(src: "", width: 28, height: 28, rounded: 8, bg: "#171A21")
                        }
                      }
                    }
                  }
                }
                Card(p: 16, rounded: 14, glass: true) {
                  Column(gap: 10) {
                    Text("Sources", size: 16, color: "#E6E9EF")
                    Row(gap: 12, align: center) {
                      Text("Aurora FM", size: 13, color: "#E6E9EF")
                      Spacer(width: 8)
                      if (sourceEnabled0) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          sourceEnabled0 = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          sourceEnabled0 = true
                        }
                      }
                    }
                    Row(gap: 12, align: center) {
                      Text("Lumen Sound", size: 13, color: "#E6E9EF")
                      Spacer(width: 8)
                      if (sourceEnabled1) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          sourceEnabled1 = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          sourceEnabled1 = true
                        }
                      }
                    }
                    Row(gap: 12, align: center) {
                      Text("Northwave Radio", size: 13, color: "#E6E9EF")
                      Spacer(width: 8)
                      if (sourceEnabled2) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          sourceEnabled2 = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          sourceEnabled2 = true
                        }
                      }
                    }
                    Row(gap: 12, align: center) {
                      Text("Echo Cache", size: 13, color: "#E6E9EF")
                      Spacer(width: 8)
                      if (sourceEnabled3) {
                        Button("On", bg: "#2E3155", border: "#454B85") {
                          sourceEnabled3 = false
                        }
                      } else {
                        Button("Off", bg: "#232833", border: "#2A3040") {
                          sourceEnabled3 = true
                        }
                      }
                    }
                    Divider(border: "#2A3040")
                    Text("Enabled sources appear in the online library.", size: 12, color: "#7C8595")
                  }
                }
              }
            }
          }
        }
      }

      // Tab flags keep the right panel on lyrics or the queue.
      Column(width: 320, gap: 12, p: 14) {
        Card(p: 14, rounded: 16, glass: true) {
          Row(gap: 12, align: center) {
            Container(p: 10, rounded: 10, bg: "#6366F1") {
              Column(align: center, width: 16) {
                Icon(name: "play", color: "#E6E9EF")
              }
            }
            Column(gap: 3, width: 180) {
              Text("Now Playing", size: 12, color: "#7C8595")
              Text("{npTitle}", size: 15, color: "#E6E9EF")
              Text("{npArtist} · {npAlbum}", size: 12, color: "#9AA3B2")
            }
          }
        }
        Row(gap: 8, align: center) {
          if (panelLyrics) {
            Button("Lyrics", bg: "#2E3155", border: "#454B85") {
              panelLyrics = true
              panelQueue = false
            }
          } else {
            Button("Lyrics", bg: "#1F232C", border: "#2A3040") {
              panelLyrics = true
              panelQueue = false
            }
          }
          if (panelQueue) {
            Button("Queue", bg: "#2E3155", border: "#454B85") {
              panelQueue = true
              panelLyrics = false
            }
          } else {
            Button("Queue", bg: "#1F232C", border: "#2A3040") {
              panelQueue = true
              panelLyrics = false
            }
          }
        }
        if (panelLyrics) {
          LyricsPanel()
        }
        if (panelQueue) {
          QueuePanel()
        }
      }
    }

    // The bar is outside the branch column so no screen hides it.
    NowBar()
  }
}
