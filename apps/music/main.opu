              Chip("{onlineSource}")
            }
            Row(gap: 8, align: center) {
              Text("Browse", size: 12, color: "#7C8595")
              Button("Category", bg: "#232833", border: "#2A3040") {
                browseCategory = true
                browseHot = false
                browseNew = false
              }
              Button("Hot", bg: "#232833", border: "#2A3040") {
                browseCategory = false
                browseHot = true
                browseNew = false
              }
              Button("New", bg: "#232833", border: "#2A3040") {
                browseCategory = false
                browseHot = false
                browseNew = true
              }
              if (browseCategory) {
                Chip("category")
              }
              if (browseHot) {
                Chip("hot")
              }
              if (browseNew) {
                Chip("new")
              }
            }
            Row(gap: 8, align: center) {
              Text("Genre", size: 12, color: "#7C8595")
              Button("Pop", bg: "#232833", border: "#2A3040") {
                onlineCategory = "Pop"
              }
              Button("Rock", bg: "#232833", border: "#2A3040") {
                onlineCategory = "Rock"
              }
              Button("Jazz", bg: "#232833", border: "#2A3040") {
                onlineCategory = "Jazz"
              }
              Button("Electronic", bg: "#232833", border: "#2A3040") {
                onlineCategory = "Electronic"
              }
