// Entry application for the desktop music player skeleton.
// A standalone app is required for the compiler to check a file, so this entry
// carries the merged declarations that a production build splits across modules.

component TrackRow(title: string, artist: string, album: string, mark: string) {
  Card(p: 12, rounded: 12, shadow: 2, bg: "#FFFFFF", border: "#DCE4F2") {
    Column(gap: 4, bg: "#FFFFFF") {
      Row(gap: 8, align: center) {
        Text("{title}", size: 14, color: "#101828")
        Spacer(width: 8)
        Container(width: 54) {
          Badge(label: "{mark}")
        }
      }
      Text("{artist} - {album}", size: 11, color: "#5A6B8C")
    }
  }
}

component PlaylistRow(name: string, count: string) {
  Card(p: 12, rounded: 12, shadow: 2, bg: "#FFFFFF", border: "#DCE4F2") {
    Column(gap: 4, bg: "#FFFFFF") {
      Row(gap: 8, align: center) {
        Container(width: 22, height: 22, rounded: 6, bg: "#EEF3FC") {
          Icon(name: "folder", color: "#2A5BD7")
        }
        Text("{name}", size: 13, color: "#101828")
        Spacer(width: 8)
        Text("{count} tracks", size: 11, color: "#5A6B8C")
      }
    }
  }
}

app MusicPlayer {
  state filter = "aurora"
  state nowPlaying = "Aurora Lights"
  state artist = "Northwind"
  state album = "First Light"
  state duration = 214
  state position = 62
  state volume = 40
  state playing = true
  state mode = "sequence"
  state alwaysOnTop = true
  state trayHidden = false
  state hotkeyEnabled = true
  state globalHotkey = "Ctrl+Shift+P"

  // Parallel compile-time lists model the library records read by the list.
  state libraryTitles = ["Aurora Lights", "Coastal Drift", "Ember Field", "Harbor Line", "Northern Mark", "Quiet Current"]
  state libraryArtists = ["Northwind", "Cinder Row", "The Pale Choir", "Harbor Light", "Marlowe", "Sable and Co"]
  state libraryAlbums = ["First Light", "Tidal", "Ember Field", "Harbor Line", "Northern Mark", "Quiet Current"]
  state playlists = ["Road Trip", "Focus Loop", "Late Night"]

  computed remaining = duration - position

  model Track {
    id: int primary
    title: string
    artist: string
    album: string
    duration: int
    path: string
  }

  model Playlist {
    id: int primary
    name: string
    trackId: int
  }

  api "/music/library" {
    list Track
    create Track
  }

  api "/music/playlists" {
    list Playlist
    create Playlist
  }

  theme { mode: dark, accent: "#2A5BD7", radius: 14, fontScale: 1.0 }

  // One shell for every width: a wide viewport shows three panes and a compact
  // viewport stacks the library, the player and the playlist vertically.
  Column(p: 0, gap: 0) {
    Container(p: 20, shadow: 4, gradient: "#2A5BD7,#123C8C",
              particles: "count=40,seed=21,radius=2,alpha=800,color=#C9DCFF") {
      Column(gap: 4, bg: "#2A5BD7") {
        Text("Music Player", size: 26, color: "#FFFFFF")
        Text("{nowPlaying} - {artist} - {mode} mode", size: 12, color: "#C9DCFF")
      }
    }

    Row(gap: 16, p: 16) {
      // Library pane: filter field plus the scrollable track list.
      Column(width: 340, gap: 12) {
        Text("Library", size: 18, color: "#101828")
        Input(bind: filter, placeholder: "filter library")
        Scroll(height: 620, bg: "#F4F7FB", border: "#E4E9F2", rounded: 16) {
          Column(gap: 10, p: 12) {
            for (i in 6) {
              TrackRow("{libraryTitles[i]}", "{libraryArtists[i]}", "{libraryAlbums[i]}", "track")
            }
          }
        }
      }

      // Now-playing pane: media surface, transport, seek, volume and mode.
      Column(width: 560, gap: 14) {
        Container(p: 16, rounded: 16, shadow: 3, gradient: "#123C8C,#2A5BD7") {
          Column(gap: 6, bg: "#123C8C") {
            Text("Now Playing", size: 18, color: "#FFFFFF")
            Text("{nowPlaying}", size: 22, color: "#FFFFFF")
            Text("{artist} - {album}", size: 12, color: "#C9DCFF")
            Text("{position} / {duration} - {remaining} remaining", size: 12, color: "#C9DCFF")
          }
        }

        Container(p: 16, rounded: 16, shadow: 3, bg: "#FFFFFF", border: "#DCE4F2") {
          Column(gap: 10) {
            Player(src: "media/aurora.opumedia", width: 528, height: 180)
            Waveform(value: 90, width: 528, height: 56)
            Equalizer(value: 45, width: 528, height: 48)

            Row(gap: 10, align: center) {
              Container(width: 36, height: 36, rounded: 10, bg: "#2A5BD7") {
                Icon(name: "arrow_back", color: "#FFFFFF")
              }
              Button("Play", p: 12, rounded: 12, shadow: 2, bg: "#2A5BD7", animate: spring) {
                playing = false
              }
              Container(width: 36, height: 36, rounded: 10, bg: "#2A5BD7") {
                Icon(name: "arrow_forward", color: "#FFFFFF")
              }
            }

            Slider(bind: position, min: 0, max: 240)
            Text("seek {position}s", size: 11, color: "#5A6B8C")
            Slider(bind: volume, min: 0, max: 100)
            Text("volume {volume}%", size: 11, color: "#5A6B8C")

            Row(gap: 8, align: center) {
              Radio(bind: mode, value: "sequence")
              Text("sequence", size: 11, color: "#5A6B8C")
              Radio(bind: mode, value: "loop")
              Text("loop", size: 11, color: "#5A6B8C")
              Radio(bind: mode, value: "shuffle")
              Text("shuffle", size: 11, color: "#5A6B8C")
            }

            Badge(label: "{mode} mode")
          }
        }
      }

      // Playlist pane plus the desktop capability placeholders.
      Column(width: 280, gap: 12, p: 14) {
        Text("Playlists", size: 18, color: "#101828")
        Scroll(height: 360, bg: "#F4F7FB", border: "#E4E9F2", rounded: 16) {
          Column(gap: 10, p: 12) {
            for (item in playlists) {
              PlaylistRow("{item}", "12")
            }
          }
        }

        Container(p: 14, rounded: 14, shadow: 2, bg: "#EEF3FC") {
          Column(gap: 8) {
            Text("Desktop", size: 12, color: "#5A6B8C")
            Switch(bind: alwaysOnTop)
            Text("always on top", size: 11, color: "#5A6B8C")
            Switch(bind: trayHidden)
            Text("minimize to tray", size: 11, color: "#5A6B8C")
            Switch(bind: hotkeyEnabled)
            Text("global hotkey", size: 11, color: "#5A6B8C")
            Text("{globalHotkey}", size: 12, color: "#101828")
          }
        }

        if (trayHidden) {
          Container(p: 14, rounded: 14, shadow: 2, gradient: "#2A5BD7,#123C8C") {
            Text("Running in the background tray", size: 12, color: "#FFFFFF")
          }
        }
      }
    }
  }
}
