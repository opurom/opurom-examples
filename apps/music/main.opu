                          Chip("{pl2Extra}")
                          Button("Remove", bg: "#232833", border: "#2A3040") {
                            pl2HasExtra = false
                            pl2Extra = ""
                            pl2Count -= 1
                          }
                        }
                      }
                      Row(gap: 8, align: center) {
                        Button("Add track", bg: "#2E3155", border: "#454B85") {
                          pl2Extra = addPick
                          pl2HasExtra = true
                          pl2Count += 1
                        }
                        Button("Remove track", bg: "#232833", border: "#2A3040") {
                          pl2HasT1 = false
                          pl2T1 = ""
                          pl2Count -= 1
                        }
                        Button("Move up", bg: "#232833", border: "#2A3040") {
                          pl2First = true
                        }
                        Button("Move down", bg: "#232833", border: "#2A3040") {
                          pl2First = false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }

        if (viewFavorites) {
          Column(gap: 12) {
            Column(gap: 4) {
              Text("Favorites", size: 22, color: "#E6E9EF")
              Text("Songs you keep close", size: 12, color: "#9AA3B2")
            }
            Row(gap: 8, align: center) {
              Button("Clear favorites", bg: "#3A2430", border: "#553540") {
                fav0 = false
                fav1 = false
                fav2 = false
                fav3 = false
                fav4 = false
                fav5 = false
              }
              Button("Restore selection", bg: "#232833", border: "#2A3040") {
                fav0 = true
                fav2 = true
                fav4 = true
              }
              Chip("favorite songs")
            }
            Grid(columns: 3) {
              StatTile("Favorites", "3")
              StatTile("Artists", "6")
              StatTile("Albums", "6")
            }
            Scroll(height: 460, rounded: 16, glass: true) {
              Column(gap: 8, p: 12) {
                if (fav0) {
                  TrackRow("Aurora Lights", "Northwind", "First Light", 214, "3:34", "A", "#39415C", 0, true, false, false, false, false, false)
                }
                if (fav1) {
                  TrackRow("Coastal Drift", "Cinder Row", "Tidal", 198, "3:18", "C", "#335058", 1, false, true, false, false, false, false)
                }
                if (fav2) {
                  TrackRow("Ember Field", "The Pale Choir", "Ember Field", 245, "4:05", "E", "#4E4440", 2, false, false, true, false, false, false)
                }
