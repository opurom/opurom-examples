            Row(gap: 8, align: center) {
              Button("Clear history", bg: "#3A2430", border: "#553540") {
                hist0 = false
                hist1 = false
                hist2 = false
                hist3 = false
                hist4 = false
                hist5 = false
              }
              Button("Restore selection", bg: "#232833", border: "#2A3040") {
                hist0 = true
