// Standardized Material 3 Colors page. Palettes are Flutter Material demo data.
component Swatch(tone: string, bg: string, hexText: string, safeGap: int, ink: string) {
  // Each swatch carries its own bg and label; 48px right safety margin.
  Container(width: 1080, height: 144, color: "{bg}", border: "{bg}", p: 0, gesture: "tap") {
    Row(p: 0, gap: 0, align: start, color: "{bg}", border: "{bg}") {
      Spacer(width: 48)
      Text("{tone}", size: 42, fontPx: 42, weight: "normal", color: "{ink}", label: "colors/name_{tone}")
      Spacer(width: safeGap)
      Text("{hexText}", size: 42, fontPx: 42, weight: "normal", color: "{ink}", label: "colors/hex_{tone}")
    }
  }
}

app GalleryColors {
  // msaa: 4 enables the deterministic 4x integer edge coverage on rounded corners.
  quality { msaa: 4 }
  // Dynamic tabs: 'if' takes a bare bool state; IR has no int equality.
  state tabRed = true
  state tabPink = false
  state tabPurple = false
  state tabDeep = false

  // md-sys-color-surface
  Container(width: 1080, height: 2400, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
    Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
      // md-sys-color-surface
      Container(width: 1080, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "arrow-left", width: 72, height: 72, color: "#000000", label: "colors/topbar_back")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "info-circle", width: 72, height: 72, color: "#000000", label: "colors/topbar_info")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "code", width: 72, height: 72, color: "#000000", label: "colors/topbar_code")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "devices", width: 72, height: 72, color: "#000000", label: "colors/topbar_devices")
            }
          }
          Spacer(width: 24)
          Container(width: 648, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface; engLike2021 uses w400, brief says 500
              Text("Colors", size: 66, fontPx: 66, weight: "bold", color: "#000000", label: "colors/title")
            }
          }
        }
      }
      // onTabSelected/onIndicatorMoved/onContentChanged bound via tabRed/... bool states.
      // onDragUpdate/onDragEnd await A2/B3 gesture lerp; no static placeholder.
      Container(width: 1080, height: 144, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          // md-sys-color-surface; selected RED tab
          Container(width: 200, height: 144, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: center, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 40)
              if (tabRed) {
                // md-sys-color-primary; native Button five-state press feedback
                Button("RED", width: 200, fontScale: 2.6, color: "#FFFFFF", variant: "text") {
                  tabRed = true
                  tabPink = false
                  tabPurple = false
                  tabDeep = false
                }
              } else {
                // md-sys-color-on-surface-variant
                Button("RED", width: 200, fontScale: 2.6, color: "#FFFFFF", variant: "ghost") {
                  tabRed = true
                  tabPink = false
                  tabPurple = false
                  tabDeep = false
                }
              }
              if (tabRed) {
                // md-sys-color-primary; indicator width = label text width (opacity keeps row height stable)
                Container(width: 90, height: 6, color: "#6200EE", border: "#6200EE", p: 0)
              } else {
                Container(width: 90, height: 6, color: "#FFFFFF", border: "#FFFFFF", p: 0)
              }
            }
          }
          // md-sys-color-surface; unselected PINK tab
          Container(width: 220, height: 144, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: center, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 40)
              if (tabPink) {
                // md-sys-color-primary; native Button five-state press feedback
                Button("PINK", width: 220, fontScale: 2.6, color: "#FFFFFF", variant: "text") {
                  tabRed = false
                  tabPink = true
                  tabPurple = false
                  tabDeep = false
                }
              } else {
                // md-sys-color-on-surface-variant
                Button("PINK", width: 220, fontScale: 2.6, color: "#FFFFFF", variant: "ghost") {
                  tabRed = false
                  tabPink = true
                  tabPurple = false
                  tabDeep = false
                }
              }
              if (tabPink) {
                // md-sys-color-primary; indicator width = label text width (opacity keeps row height stable)
                Container(width: 120, height: 6, color: "#6200EE", border: "#6200EE", p: 0)
              } else {
                Container(width: 120, height: 6, color: "#FFFFFF", border: "#FFFFFF", p: 0)
              }
            }
          }
          // md-sys-color-surface; unselected PURPLE tab
          Container(width: 250, height: 144, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: center, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 40)
              if (tabPurple) {
                // md-sys-color-primary; native Button five-state press feedback
                Button("PURPLE", width: 250, fontScale: 2.6, color: "#FFFFFF", variant: "text") {
                  tabRed = false
                  tabPink = false
                  tabPurple = true
                  tabDeep = false
