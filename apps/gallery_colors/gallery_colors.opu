              } else {
                Container(width: 180, height: 6, color: "#FFFFFF", border: "#FFFFFF", p: 0)
              }
            }
          }
          // md-sys-color-surface; unselected DEEP PURPLE tab
          Container(width: 362, height: 144, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: center, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 40)
              if (tabDeep) {
                // md-sys-color-primary; native Button five-state press feedback
                Button("DEEP PURPLE", width: 362, fontScale: 2.6, color: "#FFFFFF", variant: "text") {
