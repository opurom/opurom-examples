            // material purple palette, demo data 900 #4A148C
            Swatch("900", "#4A148C", "#FF4A148C", 624, "#FFFFFF")
            // material purple palette, demo data A100 #EA80FC
            Swatch("A100", "#EA80FC", "#FFEA80FC", 594, "#FFFFFF")
            // material purple palette, demo data A200 #E040FB
