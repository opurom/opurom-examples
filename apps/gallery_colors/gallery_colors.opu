              } else {
                Container(width: 330, height: 6, color: "#FFFFFF", border: "#FFFFFF", p: 0)
              }
            }
          }
        }
      }
      Scroll(height: 2088) {
        // 14 full 144px rows per palette; A700 is a complete row, not a viewport-clipped strip.
