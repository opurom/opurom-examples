// Glass five-state exhibits. Each state is a literal prop on an official
// opurom-ui component; these are static exhibits, not runtime interactions.
import "components/section_header.opu";
import "components/text.opu";
import "components/glass_primary_button.opu";
import "components/glass_secondary_button.opu";
import "components/glass_ghost_button.opu";
import "components/glass_card.opu";
import "components/glass_input.opu";
import "components/glass_fab.opu";
import "components/glass_switch_off.opu";
import "components/glass_switch_on.opu";

component GlassStateMatrix() {
  Column(gap: 8) {
    SectionHeader("Glass five-state matrix")
    CaptionText("Primary / default")
    GlassPrimaryButton("Primary", "default")
    CaptionText("Primary / hover")
    GlassPrimaryButton("Primary", "hover")
    CaptionText("Primary / active")
    GlassPrimaryButton("Primary", "active")
    CaptionText("Primary / focus")
    GlassPrimaryButton("Primary", "focus")
    CaptionText("Primary / disabled")
    GlassPrimaryButton("Primary", "disabled")
    CaptionText("Secondary / default")
    GlassSecondaryButton("Secondary", "default")
    CaptionText("Secondary / hover")
    GlassSecondaryButton("Secondary", "hover")
    CaptionText("Secondary / active")
    GlassSecondaryButton("Secondary", "active")
    CaptionText("Secondary / focus")
    GlassSecondaryButton("Secondary", "focus")
    CaptionText("Secondary / disabled")
    GlassSecondaryButton("Secondary", "disabled")
    CaptionText("Ghost / default")
    GlassGhostButton("Ghost", "default")
    CaptionText("Ghost / hover")
    GlassGhostButton("Ghost", "hover")
    CaptionText("Ghost / active")
    GlassGhostButton("Ghost", "active")
    CaptionText("Ghost / focus")
    GlassGhostButton("Ghost", "focus")
    CaptionText("Ghost / disabled")
    GlassGhostButton("Ghost", "disabled")
    CaptionText("Card / default")
    GlassCard("Card", "default")
    CaptionText("Card / hover")
    GlassCard("Card", "hover")
    CaptionText("Card / active")
    GlassCard("Card", "active")
    CaptionText("Card / focus")
    GlassCard("Card", "focus")
    CaptionText("Card / disabled")
    GlassCard("Card", "disabled")
    CaptionText("Input / default")
    GlassInput("Input", "default")
    CaptionText("Input / hover")
    GlassInput("Input", "hover")
    CaptionText("Input / active")
    GlassInput("Input", "active")
    CaptionText("Input / focus")
    GlassInput("Input", "focus")
    CaptionText("Input / disabled")
    GlassInput("Input", "disabled")
    CaptionText("Fab / default")
    GlassFab("Fab", "default")
    CaptionText("Fab / hover")
    GlassFab("Fab", "hover")
    CaptionText("Fab / active")
    GlassFab("Fab", "active")
    CaptionText("Fab / focus")
    GlassFab("Fab", "focus")
    CaptionText("Fab / disabled")
    GlassFab("Fab", "disabled")
    CaptionText("Switch off / default")
    GlassSwitchOff("default")
    CaptionText("Switch off / hover")
    GlassSwitchOff("hover")
    CaptionText("Switch off / active")
    GlassSwitchOff("active")
    CaptionText("Switch off / focus")
    GlassSwitchOff("focus")
    CaptionText("Switch off / disabled")
    GlassSwitchOff("disabled")
    CaptionText("Switch on / default")
    GlassSwitchOn("default")
    CaptionText("Switch on / hover")
    GlassSwitchOn("hover")
    CaptionText("Switch on / active")
    GlassSwitchOn("active")
    CaptionText("Switch on / focus")
    GlassSwitchOn("focus")
    CaptionText("Switch on / disabled")
    GlassSwitchOn("disabled")
  }
}
