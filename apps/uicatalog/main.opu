// UI component catalog demo: one screen exercising the opurom-ui library.
// Batch 1 covers forms, data and layout; batch 2 covers navigation and states.
import "pkg-theme/default.opu";
import "components/data_table.opu";
import "components/section_header.opu";
import "components/form_field.opu";
import "components/chip.opu";
import "components/progress.opu";
import "components/stat_card.opu";
import "components/breadcrumb.opu";
import "components/segmented.opu";
import "components/stepper.opu";
import "components/pagination.opu";
import "components/empty_state.opu";
import "components/skeleton.opu";
import "components/search.opu";
import "components/banner.opu";
import "components/timeline.opu";
import "components/filetree.opu";
import "components/chart_card.opu";
import "components/avatar_group.opu";
import "components/number_flow.opu";
import "components/rating.opu";
import "components/code_block.opu";
import "components/button.opu";
import "components/card.opu";
import "components/text.opu";
import "components/list.opu";
import "components/navbar.opu";
import "components/dialog.opu";
import "components/toast.opu";
import "components/badge.opu";
import "components/avatar.opu";
import "components/hero_header.opu";
import "components/profile_header.opu";
import "components/detail_row.opu";
import "components/toolbar.opu";
import "components/secure_field.opu";
import "components/status_pill.opu";
import "components/grid_tile.opu";
import "components/glass_input.opu";
import "components/glass_switch_on.opu";
import "components/glass_switch_off.opu";
import "components/glass_card.opu";
import "components/glass_fab.opu";
import "components/glass_ghost_button.opu";
import "components/glass_secondary_button.opu";
import "components/glass_primary_button.opu";

app UiCatalog {
  state page: int = 3
  state loading: bool = true
  state active: bool = true

  ScrollView(p: 16) {
    Column(gap: 14) {
      SectionHeader("Overview")
      MetricCard("Deploys", "128", "+12%", "success")
      MetricCard("Failures", "3", "-2", "warning")
      ProgressTrack(64)

      SectionHeader("Filters")
      Row(gap: 8) {
        SearchField("Search runs")
        FilterChip("Passed", "primary")
        FilterChip("Flaky", "ghost")
      }

      SectionHeader("Form")
      FormField("Workspace ID", "acme-prod")

      SectionHeader("Data")
      DataTable("Recent runs", "Branch,Status,Time", "main,ok,1m", "dev,ok,2m", "fix,fail,3m", "main,ok,1m")

      SectionHeader("Navigation")
      Breadcrumb("Home", "Workspace", "Catalog")
      SegmentedControl("Day", "Week", "Month", 1)
      StepBar(4, 2)
      PaginationBar(3, 12)

      SectionHeader("States")
      Skeleton(280, 64)
      EmptyState("folder", "No runs yet", "Trigger a build to see it here")

      SectionHeader("Insights")
      Banner("Deploys paused", "Pipelines resume after the incident review", "warning")
      ChartCard("Throughput", "bar")
      NumberFlow("42", "builds")
      StarRating("Release quality", 80, 5)
      AvatarGroup("ada", "linus", "grace")
      Timeline("Pipeline", "09:12 Queued", "09:14 Building", "09:20 Shipped")
      FileTree("src", "main.opu", "render.opu", "theme.opu")
      CodeSnippet("Build", "opurom build --src app.opu", "--target web", "--out dist")

      SectionHeader("Legacy primitives")
      NavBar("Console", "Edit")
      Row(gap: 8) {
        ActionButton("Deploy", "primary")
        ActionButton("Promote", "secondary")
        ActionButton("Archive", "ghost")
      }
      SurfaceCard("Runner pool")
      TitleHeading("Workspace")
      BodyText("Every surface below draws from the same token baseline.")
      CaptionText("Catalog build 42")
      ListPanel("Queued jobs")
      Row(gap: 8) {
        BadgePill("7")
        AvatarDisc("OP")
      }
      ToastNote("Catalog refreshed")
      DialogPanel("Run details")

      SectionHeader("Fourth batch")
      HeroHeader("Opurom Console", "Ship from one place")
      ProfileHeader("OP", "Opurom Team", "Release engineering")
      DetailRow("lock", "Access", "Admin only")
      DetailRow("calendar", "Window", "Tue 09:00-11:00")
      Toolbar("Deploy", "Cancel")
      SecureField("Access token")
      Row(gap: 8) {
        StatusPill("Healthy", "success")
        StatusPill("Degraded", "warning")
      }
      Row(gap: 12) {
        GridTile("assets/photo1.png", "Dawn")
        GridTile("assets/photo2.png", "Tide")

      SectionHeader("Premium glass")
      GlassPrimaryButton("Deploy", "default")
      GlassSecondaryButton("Cancel", "hover")
      GlassGhostButton("Skip", "focus")
      GlassFab("+", "active")
      GlassCard("Surface", "disabled")
      Row(gap: 12) {
        GlassSwitchOff("default")
        GlassSwitchOn("default")
      }
      GlassInput("Search", "default")
      }
    }
  }
}
