// UI component catalog demo: one screen exercising the opurom-ui library.
import "pkg-theme/default.opu";
import "components/stat_card.opu";
import "components/section_header.opu";
import "components/form_field.opu";
import "components/chip.opu";
import "components/progress.opu";
import "components/data_table.opu";

app UiCatalog {
  ScrollView(p: 16) {
    Column(gap: 14) {
      SectionHeader("Workspace overview")
      Row(gap: 12) {
        MetricCard("Open tasks", "42", "+12% this week", "success")
        MetricCard("Blocked", "3", "-1 since Monday", "warning")
      }
      Row(gap: 8) {
        FilterChip("All", "primary")
        FilterChip("Active", "ghost")
        FilterChip("Done", "ghost")
      }
      ProgressTrack(64)
      FormField("Assignee", "Search people")
      DataTable("Recent runs", "JOB / STATUS / TIME", "build-12 / ok / 4s", "build-11 / ok / 5s", "build-10 / failed / 2s", "build-12 / ok / 4s")
    }
  }
}
