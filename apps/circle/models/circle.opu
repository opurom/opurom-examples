// One model per entity keeps every screen and the lowered service reading one field set.

model Post {
  id: int primary
  title: string
  content: string
  author: string
  authorHandle: string
  topic: string
  cover: string
  images: string
  time: string
  likes: int = 0
  comments: int = 0
  liked: bool = false
  saved: bool = false
}

model Comment {
  id: int primary
  postId: int
  author: string
  body: string
  replyTo: string
  time: string
  likes: int = 0
}

model User {
  id: int primary
  name: string
  handle: string
  bio: string
  posts: int = 0
  followers: int = 0
  following: int = 0
}

model Circle {
  id: int primary
  name: string
  description: string
  cover: string
  members: int = 0
  created: string
}

model Activity {
  id: int primary
  title: string
  category: string
  startTime: string
  endTime: string
  location: string
  organizer: string
  content: string
  cover: string
  price: int = 0
  participants: int = 0
  capacity: int = 0
  status: string
}

model Bookmark {
  id: int primary
  postId: int
  owner: string
  savedAt: string
}

model Notification {
  id: int primary
  actor: string
  kind: string
  text: string
  time: string
  read: bool = false
}

// Routes mirror the entities so each screen calls one path per operation.
api "/orbit/posts" {
  list Post
  create Post
}

api "/orbit/posts/:id" {
  get Post
  update Post
  delete Post
}

api "/orbit/posts/:id/comments" {
  list Comment
  create Comment
}

api "/orbit/circles" {
  list Circle
  create Circle
}

api "/orbit/circles/:id" {
  get Circle
  update Circle
}

api "/orbit/circles/:id/members" {
  list User
}

api "/orbit/activities" {
  list Activity
  create Activity
}

api "/orbit/activities/:id" {
  get Activity
  update Activity
  delete Activity
}

api "/orbit/activities/:id/comments" {
  list Comment
  create Comment
}

api "/orbit/users" {
  list User
  create User
}

api "/orbit/users/:id" {
  get User
  update User
}

api "/orbit/users/:id/follow" {
  update User
}

api "/orbit/bookmarks" {
  list Bookmark
  create Bookmark
}

api "/orbit/bookmarks/:id" {
  delete Bookmark
}

api "/orbit/notifications" {
  list Notification
}

api "/orbit/search" {
  list Post
}

// Feed cards share one reaction counter because list state is read by position only.
state refreshCount = 0
state feedStatus = "idle"

state liked = false
state likeCount = 26
state saved = false
state saveCount = 9
state following = false
state followCount = 180
state commentCount = 6
state commentDraft = ""
state replyActive = false
state replyName = ""
state reported = false
state reportReason = "spam"
state shareCount = 5

state joined = false
state circleMembers = 320
state isFav = false
state isParticipant = false
state participantCount = 24
state isOrganizer = false
state activityCommentCount = 3
state activityCommentDraft = ""

state notifCount = 8
state unreadCount = 3
state latestNotif = ""
state postCount = 24
state composerDone = false
