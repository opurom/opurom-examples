// One typed declaration per entity keeps the UI and the lowered service boundary aligned.
model Account {
  id: int primary
  name: string
  handle: string
  avatar: string
  note: string
  online: bool = false
}

model Conversation {
  id: int primary
  peer: string
  kind: string
  preview: string
  stamp: string
  unread: int = 0
  pinned: bool = false
  muted: bool = false
  draft: string
}

model Message {
  id: int primary
  conversation: int
  author: string
  body: string
  stamp: string
  direction: string
  state: string
  expanded: bool = false
}

model Contact {
  id: int primary
  name: string
  handle: string
  avatar: string
  note: string
  online: bool = false
  blocked: bool = false
}

model Group {
  id: int primary
  name: string
  avatar: string
  memberCount: int = 0
  notice: string
}

model Member {
  id: int primary
  group: int
  name: string
  avatar: string
  role: string
}

model CallRecord {
  id: int primary
  peer: string
  kind: string
  stamp: string
  outcome: string
}

model Notification {
  id: int primary
  title: string
  body: string
  stamp: string
  kind: string
  read: bool = false
}

model Setting {
  id: int primary
  key: string
  value: string
}

