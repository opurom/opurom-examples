// One typed declaration per entity keeps the UI and the lowered service boundary aligned.
model Account {
  id: int primary
  name: string
  handle: string
  avatar: string
  note: string
  online: bool = false
}

model Conversation {
  id: int primary
  peer: string
  kind: string
  preview: string
  stamp: string
  unread: int = 0
  pinned: bool = false
  muted: bool = false
  draft: string
}

model Message {
  id: int primary
  conversation: int
  author: string
  body: string
  stamp: string
  direction: string
  state: string
  expanded: bool = false
}

model Contact {
  id: int primary
  name: string
  handle: string
  avatar: string
  note: string
  online: bool = false
  blocked: bool = false
}

model Group {
  id: int primary
  name: string
  avatar: string
  memberCount: int = 0
  notice: string
}

model Member {
  id: int primary
  group: int
  name: string
  avatar: string
  role: string
}

model CallRecord {
  id: int primary
  peer: string
  kind: string
  stamp: string
  outcome: string
}

model Notification {
  id: int primary
  title: string
  body: string
  stamp: string
  kind: string
  read: bool = false
}

model Setting {
  id: int primary
  key: string
  value: string
}

api "/account/:id" {
  get Account
  update Account
}

api "/conversations" {
  list Conversation
  create Conversation
}

api "/conversations/:id" {
  get Conversation
  update Conversation
}

api "/conversations/:id/messages" {
  list Message
  create Message
}

api "/messages/:id" {
  get Message
  update Message
  delete Message
}

api "/contacts" {
  list Contact
  create Contact
}

api "/contacts/:id" {
  get Contact
  update Contact
}

api "/groups" {
  list Group
  create Group
}

api "/groups/:id" {
  get Group
  update Group
}

api "/groups/:id/members" {
  list Member
  create Member
}

api "/members/:id" {
  delete Member
}

api "/calls" {
  list CallRecord
  create CallRecord
}

api "/notifications" {
  list Notification
}

api "/notifications/:id" {
  update Notification
}

api "/settings/:id" {
  list Setting
  update Setting
}

// Compile-time list unrolling keeps each list screen populated without a runtime data source.
