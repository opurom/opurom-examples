// Session and view state the entry screen reads. Encryption and persistence are
// modeled as state here; the primitives that operate on them are supplied by the
// platform adapter and planned in the design document.
state peerAddress = "192.168.1.20"
state peerPort = "5555"
state connected = false
state connectionState = "offline"
state encrypted = true
state persistHistory = true
state keyVersion = 1
state sessionKeyId = "lan-chat-k1"
state fingerprint = "A1:B2:C3:D4"
state draft = ""
state activeTab = "Chats"
state panel = "session"

state showChats = true
state showThread = false
state showPeers = false
state showStatus = false
