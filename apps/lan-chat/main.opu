import "models/chat.opu";
import "views/state.opu";

// Modules carry declarations only, so every component and the app tree live here.

// --- Design tokens -----------------------------------------------------------
// Calm light palette: warm paper surface, white cards, ink text, one restrained
// teal accent. Colors and spacing stay as literals the framework can inline.

component AvatarCircle(label: string, tint: string, size: int) {
  Image(src: "avatar", width: size, height: size, rounded: 999, gradient: "{tint},{tint}")
}

// Unread / status pill: a rounded tinted Card with accent-coloured text,
// because Badge paints its fill and its label in one colour.
component Chip(label: string, fill: string, ink: string) {
  Card(p: 6, rounded: 999, bg: "{fill}", border: "{fill}") {
    Text("{label}", size: 11, color: "{ink}")
  }
}

component BackBar(title: string, sub: string) {
  Row(gap: 10, align: center) {
    Button("Back", p: 8, rounded: 10, bg: "#FFFFFF", border: "#E6E8EC") {
      screenChat = false
      screenNewChat = false
      screenProfile = false
      screenGroup = false
      screenNewGroup = false
      screenCall = false
      screenNotifs = false
      screenSettings = false
      rootNow = true
      emojiOpen = false
      msgActions = false
    }
    Column(gap: 2) {
      Text("{title}", size: 16, color: "#101828")
      Text("{sub}", size: 11, color: "#8A91A0")
    }
  }
}

component SectionLabel(title: string) {
  Text("{title}", size: 12, color: "#8A91A0")
}

// --- Conversations -----------------------------------------------------------

component ConversationRow(avatar: string, tint: string, name: string, kind: string,
                          preview: string, stamp: string, unread: string,
                          peer: string, initials: string, status: string) {
  Card(p: 12, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
    Row(gap: 12, align: center) {
      AvatarCircle("{avatar}", "{tint}", 46)
      Column(gap: 3, width: 190) {
        Text("{name}", size: 15, color: "#101828")
        Text("{preview}", size: 12, color: "#8A91A0")
      }
      Column(gap: 6, align: center) {
        Text("{stamp}", size: 10, color: "#A6ACB8")
        Chip("{unread}", "#EDF4F1", "#1F6F5C")
      }
      Button("Open", p: 7, rounded: 9, bg: "#F2F5F4") {
        chatPeer = peer
        chatAvatar = initials
        chatStatus = status
        screenChat = true
        rootNow = false
      }
    }
  }
}

// --- Chat thread -------------------------------------------------------------

component OutBubble(body: string, meta: string, receipt: string) {
  Row(gap: 8) {
    Spacer(width: 96)
    Column(gap: 5, align: end) {
      Card(p: 12, rounded: 16, bg: "#1F6F5C") {
        Text("{body}", size: 14, color: "#FFFFFF")
      }
      Row(gap: 6, align: center) {
        Text("{meta}", size: 9, color: "#A6ACB8")
        Text("{receipt}", size: 9, color: "#1F6F5C")
      }
    }
  }
}

component InBubble(avatar: string, tint: string, body: string, meta: string) {
  Row(gap: 8) {
    AvatarCircle("{avatar}", "{tint}", 30)
    Column(gap: 5) {
      Card(p: 12, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
        Text("{body}", size: 14, color: "#101828")
      }
      Text("{meta}", size: 9, color: "#A6ACB8")
    }
    Spacer(width: 96)
  }
}

// --- Contacts ----------------------------------------------------------------

component ContactRow(avatar: string, tint: string, name: string, handle: string,
                     note: string, presence: string, peer: string, initials: string) {
  Card(p: 12, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
    Row(gap: 12, align: center) {
      AvatarCircle("{avatar}", "{tint}", 42)
      Column(gap: 3, width: 170) {
        Text("{name}", size: 15, color: "#101828")
        Text("{handle} - {note}", size: 11, color: "#8A91A0")
      }
      Text("{presence}", size: 11, color: "#1F6F5C")
      Button("View", p: 7, rounded: 9, bg: "#F2F5F4") {
        chatPeer = peer
        chatAvatar = initials
        chatStatus = presence
        screenProfile = true
        rootNow = false
      }
      Button("Chat", p: 7, rounded: 9, bg: "#1F6F5C") {
        chatPeer = peer
        chatAvatar = initials
        chatStatus = presence
        screenChat = true
        rootNow = false
      }
    }
  }
}

// --- Small shared rows -------------------------------------------------------

component MemberRow(avatar: string, name: string, role: string) {
  Card(p: 10, rounded: 12, bg: "#FFFFFF", border: "#EEF0F3") {
    Row(gap: 10, align: center) {
      AvatarCircle("{avatar}", "#5B6AD0", 32)
      Column(gap: 2, width: 220) {
        Text("{name}", size: 13, color: "#101828")
        Text("{role}", size: 10, color: "#8A91A0")
      }
      Icon(name: "user", color: "#C2C7D1")
    }
  }
}

component NotificationRow(title: string, body: string, stamp: string) {
  Card(p: 12, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
    Row(gap: 12, align: center) {
      Container(width: 34, height: 34, rounded: 11, bg: "#EDF4F1") {
        Icon(name: "bell", color: "#1F6F5C")
      }
      Column(gap: 3, width: 250) {
        Text("{title}", size: 13, color: "#101828")
        Text("{body}", size: 11, color: "#8A91A0")
      }
      Column(gap: 4, align: center) {
        Text("{stamp}", size: 9, color: "#A6ACB8")
        if (notifAllRead) {
          Text("read", size: 9, color: "#A6ACB8")
        } else {
          Chip("new", "#EDF4F1", "#1F6F5C")
        }
      }
    }
  }
}

component CallRow(name: string, kind: string, stamp: string, outcome: string) {
  Card(p: 12, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
    Row(gap: 12, align: center) {
      Container(width: 32, height: 32, rounded: 10, bg: "#EDF4F1") {
        Icon(name: "play", color: "#1F6F5C")
      }
      Column(gap: 2, width: 230) {
        Text("{name}", size: 13, color: "#101828")
        Text("{kind} - {stamp}", size: 10, color: "#8A91A0")
      }
      Text("{outcome}", size: 10, color: "#B45309")
    }
  }
}

component DiscoverCard(title: string, note: string) {
  Card(p: 14, rounded: 18, bg: "#FFFFFF", border: "#EEF0F3") {
    Column(gap: 8) {
      Container(width: 34, height: 34, rounded: 11, bg: "#EDF4F1") {
        Icon(name: "star", color: "#1F6F5C")
      }
      Text("{title}", size: 14, color: "#101828")
      Text("{note}", size: 11, color: "#8A91A0")
    }
  }
}

component SettingRow(label: string, note: string) {
  Card(p: 12, rounded: 14, bg: "#FFFFFF", border: "#EEF0F3") {
    Row(gap: 10, align: center) {
      Column(gap: 2, width: 240) {
        Text("{label}", size: 13, color: "#101828")
        Text("{note}", size: 10, color: "#8A91A0")
      }
      Text("open", size: 10, color: "#A6ACB8")
    }
  }
}

// --- Tab bar -----------------------------------------------------------------

component TabBar() {
  Card(p: 8, rounded: 0, bg: "#FFFFFF", border: "#E6E8EC") {
    Column(gap: 8) {
      Row(gap: 8, align: center) {
        Button("Chats", p: 8, rounded: 10, bg: "#F2F5F4") {
          tabChats = true
          tabContacts = false
          tabDiscover = false
          tabMe = false
          showChats = true
          showContacts = false
          showDiscover = false
          showMe = false
          rootNow = true
          screenChat = false
          screenNewChat = false
          screenProfile = false
          screenGroup = false
          screenNewGroup = false
          screenCall = false
          screenNotifs = false
          screenSettings = false
        }
        Button("Contacts", p: 8, rounded: 10, bg: "#F2F5F4") {
          tabChats = false
          tabContacts = true
          tabDiscover = false
          tabMe = false
          showChats = false
          showContacts = true
          showDiscover = false
          showMe = false
          rootNow = true
          screenChat = false
          screenNewChat = false
          screenProfile = false
          screenGroup = false
          screenNewGroup = false
          screenCall = false
          screenNotifs = false
          screenSettings = false
        }
        Button("Discover", p: 8, rounded: 10, bg: "#F2F5F4") {
          tabChats = false
          tabContacts = false
          tabDiscover = true
          tabMe = false
          showChats = false
          showContacts = false
          showDiscover = true
          showMe = false
          rootNow = true
          screenChat = false
          screenNewChat = false
          screenProfile = false
          screenGroup = false
          screenNewGroup = false
          screenCall = false
          screenNotifs = false
          screenSettings = false
        }
        Button("Me", p: 8, rounded: 10, bg: "#F2F5F4") {
          tabChats = false
          tabContacts = false
          tabDiscover = false
          tabMe = true
          showChats = false
          showContacts = false
          showDiscover = false
          showMe = true
          rootNow = true
          screenChat = false
          screenNewChat = false
          screenProfile = false
          screenGroup = false
          screenNewGroup = false
          screenCall = false
          screenNotifs = false
          screenSettings = false
        }
      }
    }
  }
}


app Relay {
  theme { mode: light, accent: "#1F6F5C", radius: 18 }

  Column(p: 0, gap: 0) {
    // Top bar: brand mark, title and a live unread summary.
    Container(p: 16, bg: "#FFFFFF") {
      Row(gap: 10, align: center) {
        Container(width: 34, height: 34, rounded: 11, bg: "#1F6F5C") {
          Icon(name: "chat", color: "#FFFFFF")
        }
        Column(gap: 1) {
          Text("Relay", size: 20, color: "#101828")
          Text("Connected - {profileHandle}", size: 11, color: "#8A91A0")
        }
        Spacer(width: 8)
        Chip("{unreadTotal}", "#EDF4F1", "#1F6F5C")
      }
    }
    Divider(color: "#EEF0F3")

    // ---- Root screens --------------------------------------------------
    if (showChats) {
      Column(p: 16, gap: 12) {
        Row(gap: 8, align: center) {
          Text("Chats", size: 20, color: "#101828")
          Spacer(width: 8)
          Button("New chat", p: 8, rounded: 10, bg: "#F2F5F4") {
            screenNewChat = true
            rootNow = false
          }
          Button("Read all", p: 8, rounded: 10, bg: "#1F6F5C") {
            chatAllRead = true
            unreadTotal = 0
            chatNotice = "all read"
          }
        }
        Row(gap: 8, align: center) {
          Input(bind: chatSearch, placeholder: "Search conversations")
          Button("Search", p: 8, rounded: 10, bg: "#1F6F5C") {
            chatHasQuery = true
          }
        }
        if (chatHasQuery) {
          Card(p: 12, rounded: 14, bg: "#F2F5F4", border: "#E6E8EC") {
            Row(gap: 8, align: center) {
              Text("Results for {chatSearch}", size: 12, color: "#101828")
              Spacer(width: 8)
              Button("Clear", p: 6, rounded: 9, bg: "#FFFFFF", border: "#E6E8EC") {
                chatHasQuery = false
                chatSearch = ""
              }
            }
          }
        }
        ConversationRow("AL", "#1F6F5C", "Alice", "direct", "On my way to the studio", "09:41", "3", "Alice", "AL", "online")
        ConversationRow("DG", "#3F7D8C", "Design Guild", "group", "Dana shared a new mockup", "09:32", "0", "Design Guild", "DG", "8 members")
        ConversationRow("MA", "#8A6D3B", "Marcus", "direct", "Thanks, that worked", "Yesterday", "1", "Marcus", "MA", "offline")
        ConversationRow("PR", "#6B5BD6", "Priya", "direct", "Photos from the trip are ready", "Mon", "0", "Priya", "PR", "online")
        ConversationRow("NS", "#4E6B7D", "Night Shift", "group", "Shift handover notes posted", "Sun", "2", "Night Shift", "NS", "5 members")
        Row(gap: 8, align: center) {
          Button("New group", p: 8, rounded: 10, bg: "#F2F5F4") {
            screenNewGroup = true
            rootNow = false
          }
          Button("Group info", p: 8, rounded: 10, bg: "#F2F5F4") {
            screenGroup = true
            rootNow = false
          }
        }
      }
    }

    if (showContacts) {
      Column(p: 16, gap: 12) {
        Row(gap: 8, align: center) {
          Text("Contacts", size: 20, color: "#101828")
          Spacer(width: 8)
          Button("Add", p: 8, rounded: 10, bg: "#1F6F5C") {
            screenNewChat = true
            rootNow = false
          }
        }
        Row(gap: 8, align: center) {
          Input(bind: contactSearch, placeholder: "Search contacts")
          Button("Search", p: 8, rounded: 10, bg: "#1F6F5C") {
            contactHasQuery = true
          }
        }
        if (contactHasQuery) {
          Card(p: 12, rounded: 14, bg: "#F2F5F4", border: "#E6E8EC") {
            Row(gap: 8, align: center) {
              Text("Matching {contactSearch}", size: 12, color: "#101828")
              Spacer(width: 8)
              Button("Clear", p: 6, rounded: 9, bg: "#FFFFFF", border: "#E6E8EC") {
                contactHasQuery = false
                contactSearch = ""
              }
            }
          }
        }
        SectionLabel("All contacts")
        ContactRow("AL", "#1F6F5C", "Alice", "@alice", "Studio lead", "online", "Alice", "AL")
        ContactRow("MA", "#8A6D3B", "Marcus", "@marcus", "Build engineer", "offline", "Marcus", "MA")
        ContactRow("PR", "#6B5BD6", "Priya", "@priya", "Product", "online", "Priya", "PR")
        ContactRow("DA", "#3F7D8C", "Dana", "@dana", "Designer", "online", "Dana", "DA")
        ContactRow("OW", "#4E6B7D", "Owen", "@owen", "Ops", "offline", "Owen", "OW")
        ContactRow("SA", "#7A6A4B", "Sara", "@sara", "QA", "online", "Sara", "SA")
      }
    }

    if (showDiscover) {
      Column(p: 16, gap: 12) {
        Text("Discover", size: 20, color: "#101828")
        Grid(columns: 2) {
          DiscoverCard("Moments", "Short updates from friends")
          DiscoverCard("Channels", "Topic-based group feeds")
          DiscoverCard("Files", "Shared documents and media")
          DiscoverCard("Events", "Plan a meetup together")
        }
        Row(gap: 8, align: center) {
          Button("Notifications", p: 8, rounded: 10, bg: "#1F6F5C") {
            screenNotifs = true
            rootNow = false
          }
          Button("Settings", p: 8, rounded: 10, bg: "#F2F5F4") {
            screenSettings = true
            rootNow = false
          }
        }
        SectionLabel("Recent calls")
        CallRow("Alice", "voice", "09:12", "missed")
        CallRow("Marcus", "video", "Yesterday", "answered")
        CallRow("Priya", "voice", "Mon", "missed")
      }
    }

    if (showMe) {
      Column(p: 16, gap: 12) {
        Card(p: 16, rounded: 18, bg: "#FFFFFF", border: "#EEF0F3") {
          Row(gap: 14, align: center) {
            AvatarCircle("{profileAvatar}", "#1F6F5C", 56)
            Column(gap: 3, width: 180) {
              Text("{profileName}", size: 18, color: "#101828")
              Text("{profileHandle}", size: 12, color: "#8A91A0")
              Text("{profileNote}", size: 11, color: "#4B5563")
            }
            Chip("online", "#EDF4F1", "#1F6F5C")
          }
        }
        Grid(columns: 2) {
          Card(p: 12, rounded: 14, bg: "#FFFFFF", border: "#EEF0F3") {
            Column(gap: 2) {
              Text("{unreadTotal}", size: 18, color: "#101828")
              Text("Unread", size: 11, color: "#8A91A0")
            }
          }
          Card(p: 12, rounded: 14, bg: "#FFFFFF", border: "#EEF0F3") {
            Column(gap: 2) {
              Text("6", size: 18, color: "#101828")
              Text("Contacts", size: 11, color: "#8A91A0")
            }
          }
        }
        SettingRow("Edit profile", "Name, handle and about")
        SettingRow("Appearance", "Theme, accent and radius")
        SettingRow("Privacy", "Read receipts and presence")
        Row(gap: 8, align: center) {
          Button("Settings", p: 8, rounded: 10, bg: "#1F6F5C") {
            screenSettings = true
            rootNow = false
          }
          Button("Notifications", p: 8, rounded: 10, bg: "#F2F5F4") {
            screenNotifs = true
            rootNow = false
          }
        }
      }
    }


    // ---- Chat thread ---------------------------------------------------
    if (screenChat) {
      Column(p: 16, gap: 12) {
        Row(gap: 10, align: center) {
          Button("Back", p: 8, rounded: 10, bg: "#FFFFFF", border: "#E6E8EC") {
            screenChat = false
            rootNow = true
            emojiOpen = false
            msgActions = false
          }
          AvatarCircle("{chatAvatar}", "#1F6F5C", 40)
          Column(gap: 2, width: 150) {
            Text("{chatPeer}", size: 16, color: "#101828")
            if (chatTyping) {
              Text("typing...", size: 10, color: "#1F6F5C")
            } else {
              Text("{chatStatus}", size: 10, color: "#8A91A0")
            }
          }
          Button("Call", p: 8, rounded: 10, bg: "#F2F5F4") {
            callPeerName = chatPeer
            callPeerAvatar = chatAvatar
            callActive = true
            callSeconds = 0
            screenCall = true
            rootNow = false
          }
          Button("Info", p: 8, rounded: 10, bg: "#F2F5F4") {
            screenGroup = true
            rootNow = false
          }
        }

        Card(p: 10, rounded: 16, bg: "#F2F5F4", border: "#EEF0F3") {
          Column(gap: 12) {
            Text("Today", size: 10, color: "#A6ACB8")
            InBubble("AL", "#1F6F5C", "Morning! Are we still on for the review?", "09:38")
            OutBubble("Yes, running five minutes late.", "09:39", "read")
            InBubble("AL", "#1F6F5C", "No problem, I will hold the room.", "09:40")
            OutBubble("The build is green again.", "09:20", "delivered")
            if (expandLong) {
              OutBubble("Can we move the review to Thursday? The design team needs one more day for the mockups.", "Yesterday", "sending")
              Button("Collapse", p: 6, rounded: 9, bg: "#FFFFFF", border: "#E6E8EC") {
                expandLong = false
              }
            } else {
              Button("Show longer message", p: 6, rounded: 9, bg: "#FFFFFF", border: "#E6E8EC") {
                expandLong = true
              }
            }
            if (msgDeleted) {
              Card(p: 10, rounded: 12, bg: "#EDEFF2") {
                Text("This message was deleted", size: 11, color: "#A6ACB8")
              }
            }
            if (msgRecalled) {
              Card(p: 10, rounded: 12, bg: "#EDEFF2") {
                Text("You recalled a message", size: 11, color: "#A6ACB8")
              }
            }
            InBubble("PR", "#6B5BD6", "Already rescheduled it for Thursday.", "Yesterday")
            OutBubble("Perfect, thank you.", "Yesterday", "delivered")
          }
        }

        if (msgActions) {
          Card(p: 12, rounded: 14, bg: "#FFFFFF", border: "#E6E8EC") {
            Column(gap: 8) {
              Text("{actionBody}", size: 12, color: "#101828")
              Row(gap: 8, align: center) {
                Button("Copy", p: 7, rounded: 9, bg: "#1F6F5C") {
                  copied = true
                  msgActions = false
                }
                Button("Delete", p: 7, rounded: 9, bg: "#F2F5F4") {
                  msgDeleted = true
                  msgActions = false
                }
                Button("Recall", p: 7, rounded: 9, bg: "#F2F5F4") {
                  msgRecalled = true
                  msgActions = false
                }
                Button("Close", p: 7, rounded: 9, bg: "#FFFFFF", border: "#E6E8EC") {
                  msgActions = false
                }
              }
            }
          }
        }

        Card(p: 12, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            if (emojiOpen) {
              Card(p: 10, rounded: 12, bg: "#F2F5F4", border: "#EEF0F3") {
                Row(gap: 8, align: center) {
                  Button("smile", p: 6, rounded: 8, bg: "#FFFFFF", border: "#E6E8EC") {
                    draft = "smile"
                    emojiOpen = false
                  }
                  Button("wave", p: 6, rounded: 8, bg: "#FFFFFF", border: "#E6E8EC") {
                    draft = "wave"
                    emojiOpen = false
                  }
                  Button("heart", p: 6, rounded: 8, bg: "#FFFFFF", border: "#E6E8EC") {
                    draft = "heart"
                    emojiOpen = false
                  }
                  Button("Close", p: 6, rounded: 8, bg: "#F2F5F4") {
                    emojiOpen = false
                  }
                }
              }
            }
            Row(gap: 8, align: center) {
              Button("+", p: 8, rounded: 10, bg: "#F2F5F4") {
                emojiOpen = true
              }
              Input(bind: draft, placeholder: "Message")
              Button("Send", p: 9, rounded: 10, bg: "#1F6F5C") {
                sentCount += 1
                draft = ""
                sendState = "sent"
              }
            }
            Row(gap: 8, align: center) {
              Text("sent {sentCount} - delivery {sendState}", size: 10, color: "#A6ACB8")
              Spacer(width: 8)
              Button("Actions", p: 6, rounded: 8, bg: "#F2F5F4") {
                actionBody = "Running five minutes late."
                msgActions = true
              }
            }
          }
        }
      }
    }

    // ---- New chat ------------------------------------------------------
    if (screenNewChat) {
      Column(p: 16, gap: 12) {
        BackBar("New chat", "Start a conversation")
        Row(gap: 8, align: center) {
          Input(bind: newChatSearch, placeholder: "Search people")
          Button("Search", p: 8, rounded: 10, bg: "#1F6F5C") {
            newChatHasQuery = true
          }
        }
        if (newChatHasQuery) {
          Card(p: 12, rounded: 14, bg: "#F2F5F4", border: "#E6E8EC") {
            Text("People matching {newChatSearch}", size: 12, color: "#101828")
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Add a contact")
            Input(bind: newContactName, placeholder: "Name")
            Input(bind: newContactHandle, placeholder: "Handle")
            Button("Add contact", p: 8, rounded: 10, bg: "#1F6F5C") {
              contactAdded = true
            }
            if (contactAdded) {
              Text("{newContactName} joined your contacts", size: 11, color: "#1F6F5C")
            } else {
              Text("New peers appear in Contacts", size: 11, color: "#8A91A0")
            }
          }
        }
        SectionLabel("Start a conversation")
        ContactRow("AL", "#1F6F5C", "Alice", "@alice", "Studio lead", "online", "Alice", "AL")
        ContactRow("MA", "#8A6D3B", "Marcus", "@marcus", "Build engineer", "offline", "Marcus", "MA")
        ContactRow("PR", "#6B5BD6", "Priya", "@priya", "Product", "online", "Priya", "PR")
      }
    }

    // ---- Contact profile ----------------------------------------------
    if (screenProfile) {
      Column(p: 16, gap: 12) {
        BackBar("Profile", "{chatPeer}")
        Card(p: 18, rounded: 18, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 12) {
            Row(gap: 14, align: center) {
              AvatarCircle("{chatAvatar}", "#1F6F5C", 56)
              Column(gap: 3, width: 200) {
                Text("{chatPeer}", size: 18, color: "#101828")
                Text("{chatStatus}", size: 11, color: "#1F6F5C")
              }
            }
            Divider(color: "#EEF0F3")
            Row(gap: 8, align: center) {
              Button("Start chat", p: 8, rounded: 10, bg: "#1F6F5C") {
                screenProfile = false
                screenChat = true
                rootNow = false
              }
              Button("Call", p: 8, rounded: 10, bg: "#F2F5F4") {
                callPeerName = chatPeer
                callPeerAvatar = chatAvatar
                callActive = true
                callSeconds = 0
                screenCall = true
                rootNow = false
              }
              Button("Block", p: 8, rounded: 10, bg: "#F2F5F4") {
                contactBlocked = true
              }
            }
            if (contactBlocked) {
              Text("{chatPeer} is blocked", size: 11, color: "#B45309")
            } else {
              Text("{chatPeer} can reach you", size: 11, color: "#8A91A0")
            }
          }
        }
      }
    }

    // ---- Group info ---------------------------------------------------
    if (screenGroup) {
      Column(p: 16, gap: 12) {
        BackBar("Group info", "Design Guild - 8 members")
        Card(p: 16, rounded: 18, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Group name")
            Input(bind: groupNameEdit, placeholder: "Group name")
            SectionLabel("Notice")
            Input(bind: groupNoticeEdit, placeholder: "Group notice")
            Button("Save", p: 8, rounded: 10, bg: "#1F6F5C") {
              chatNotice = "group saved"
            }
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Members")
            MemberRow("DA", "Dana", "Owner")
            MemberRow("OW", "Owen", "Admin")
            MemberRow("SA", "Sara", "Member")
            MemberRow("AL", "Alice", "Member")
            Row(gap: 8, align: center) {
              Button("Add member", p: 8, rounded: 10, bg: "#1F6F5C") {
                memberAdded = true
              }
              Button("Remove", p: 8, rounded: 10, bg: "#F2F5F4") {
                memberGone = true
              }
            }
            if (memberAdded) {
              Text("Member added", size: 11, color: "#1F6F5C")
            }
            if (memberGone) {
              Text("Member removed", size: 11, color: "#B45309")
            }
          }
        }
      }
    }

    // ---- Create group -------------------------------------------------
    if (screenNewGroup) {
      Column(p: 16, gap: 12) {
        BackBar("Create group", "Name and members")
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Group name")
            Input(bind: groupNameEdit, placeholder: "Group name")
            SectionLabel("Notice")
            Input(bind: groupNoticeEdit, placeholder: "Notice")
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 10) {
            SectionLabel("Choose members")
            Row(gap: 8, align: center) {
              Checkbox(bind: pickAlice)
              Text("Alice", size: 12, color: "#101828")
            }
            Row(gap: 8, align: center) {
              Checkbox(bind: pickMarcus)
              Text("Marcus", size: 12, color: "#101828")
            }
            Row(gap: 8, align: center) {
              Checkbox(bind: pickPriya)
              Text("Priya", size: 12, color: "#101828")
            }
            Row(gap: 8, align: center) {
              Checkbox(bind: pickDana)
              Text("Dana", size: 12, color: "#101828")
            }
            Button("Create group", p: 9, rounded: 12, bg: "#1F6F5C") {
              groupCreated = true
              screenNewGroup = false
              screenGroup = true
              rootNow = false
            }
          }
        }
      }
    }

    // ---- Call ---------------------------------------------------------
    if (screenCall) {
      Column(p: 16, gap: 12) {
        Card(p: 22, rounded: 20, bg: "#1F6F5C") {
          Column(gap: 12) {
            Row(gap: 8, align: center) {
              Spacer(width: 70)
              Text("In call", size: 14, color: "#D8E7E3")
            }
            Row(gap: 8, align: center) {
              Spacer(width: 70)
              AvatarCircle("{callPeerAvatar}", "#3F7D8C", 96)
            }
            Row(gap: 8, align: center) {
              Spacer(width: 40)
              Text("{callPeerName}", size: 22, color: "#FFFFFF")
            }
            Row(gap: 8, align: center) {
              Spacer(width: 40)
              Text("connected - {callSeconds}s", size: 12, color: "#D8E7E3")
            }
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 10) {
            Row(gap: 8, align: center) {
              Button("Mute", p: 8, rounded: 10, bg: "#F2F5F4") {
                callMuted = true
              }
              Button("Speaker", p: 8, rounded: 10, bg: "#F2F5F4") {
                callSpeaker = true
              }
              Button("End call", p: 8, rounded: 10, bg: "#B45309") {
                callActive = false
                screenCall = false
                rootNow = true
              }
            }
            Row(gap: 8, align: center) {
              Button("Add second", p: 8, rounded: 10, bg: "#F2F5F4") {
                callSeconds += 1
              }
              Button("Back to chat", p: 8, rounded: 10, bg: "#1F6F5C") {
                screenCall = false
                screenChat = true
                rootNow = false
              }
            }
          }
        }
      }
    }

    // ---- Notifications ------------------------------------------------
    if (screenNotifs) {
      Column(p: 16, gap: 12) {
        BackBar("Notifications", "{unreadTotal} unread")
        Row(gap: 8, align: center) {
          Button("Mark all read", p: 8, rounded: 10, bg: "#1F6F5C") {
            notifAllRead = true
            unreadTotal = 0
          }
          Button("Open", p: 8, rounded: 10, bg: "#F2F5F4") {
            chatPeer = "Alice"
            chatAvatar = "AL"
            chatStatus = "online"
            screenNotifs = false
            screenChat = true
            rootNow = false
          }
        }
        NotificationRow("New message", "Alice sent a message.", "09:41")
        NotificationRow("Group update", "Dana added a mockup.", "09:32")
        NotificationRow("Call missed", "Marcus called you.", "09:12")
        NotificationRow("New contact", "Owen accepted your request.", "Yesterday")
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 10) {
            SectionLabel("Delivery")
            Row(gap: 10, align: center) {
              Switch(bind: pushNotifications)
              Text("Push notifications", size: 12, color: "#101828")
            }
            Row(gap: 10, align: center) {
              Switch(bind: groupInvites)
              Text("Group invites", size: 12, color: "#101828")
            }
          }
        }
      }
    }

    // ---- Settings -----------------------------------------------------
    if (screenSettings) {
      Column(p: 16, gap: 12) {
        BackBar("Settings", "Profile, privacy and theme")
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Profile")
            Input(bind: profileName, placeholder: "Display name")
            Input(bind: profileHandle, placeholder: "Handle")
            Input(bind: profileNote, placeholder: "About")
            Button("Save profile", p: 8, rounded: 10, bg: "#1F6F5C") {
              profileSaved = true
            }
            if (profileSaved) {
              Text("Profile saved", size: 11, color: "#1F6F5C")
            }
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 10) {
            SectionLabel("Privacy")
            Row(gap: 10, align: center) {
              Switch(bind: readReceipts)
              Text("Read receipts", size: 12, color: "#101828")
            }
            Row(gap: 10, align: center) {
              Switch(bind: typingIndicators)
              Text("Typing indicators", size: 12, color: "#101828")
            }
            Row(gap: 10, align: center) {
              Switch(bind: presence)
              Text("Online status", size: 12, color: "#101828")
            }
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Theme")
            Text("accent {themeAccent}", size: 11, color: "#4B5563")
            Row(gap: 8, align: center) {
              Button("Teal", p: 7, rounded: 9, bg: "#1F6F5C") {
                themeAccent = "#1F6F5C"
                darkPreview = false
              }
              Button("Violet", p: 7, rounded: 9, bg: "#F2F5F4") {
                themeAccent = "#6B5BD6"
                darkPreview = false
              }
              Button("Dark", p: 7, rounded: 9, bg: "#F2F5F4") {
                darkPreview = true
                themeMode = "Dark"
              }
            }
            Slider(bind: themeRadius, min: 8, max: 28)
            Slider(bind: themeSpacing, min: 4, max: 24)
          }
        }
        Card(p: 14, rounded: 16, bg: "#FFFFFF", border: "#EEF0F3") {
          Column(gap: 8) {
            SectionLabel("Storage")
            Text("cache {cacheBytes} MB", size: 12, color: "#101828")
            Progress(value: 58)
            Row(gap: 8, align: center) {
              Button("Clear cache", p: 8, rounded: 10, bg: "#F2F5F4") {
                cacheBytes = 0
                cacheCleared = true
              }
              Button("Save settings", p: 8, rounded: 10, bg: "#1F6F5C") {
                settingsSaved = true
              }
            }
            if (cacheCleared) {
              Text("Cache cleared", size: 11, color: "#1F6F5C")
            }
            if (settingsSaved) {
              Text("Preferences stored", size: 11, color: "#1F6F5C")
            }
          }
        }
      }
    }

    // Persistent tab bar, only on the three root destinations.
    if (rootNow) {
      TabBar
    }
  }
}
