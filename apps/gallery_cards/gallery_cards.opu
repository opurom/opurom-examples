// Standardized Material 3 Cards page. All colours are token values.
app GalleryCards {
  // md-sys-color-surface
  Container(width: 1080, height: 2400, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
    Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
      // md-sys-color-surface
      Container(width: 1080, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
        Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(width: 48)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "arrow-left", width: 72, height: 72, color: "#000000", label: "cards/topbar_back")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "info-circle", width: 72, height: 72, color: "#000000", label: "cards/topbar_info")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "code", width: 72, height: 72, color: "#000000", label: "cards/topbar_code")
            }
          }
          Spacer(width: 24)
          Container(width: 72, height: 168, color: "#FFFFFF", border: "#FFFFFF", p: 0) {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Spacer(height: 48)
              // md-sys-color-on-surface
              Icon(name: "devices", width: 72, height: 72, color: "#000000", label: "cards/topbar_devices")
            }
          }
          Spacer(width: 48)
          // md-sys-color-on-surface
          Text("Cards", size: 66, fontPx: 66, weight: "normal", color: "#000000", label: "cards/title")
        }
      }
      Scroll(height: 2232) {
        Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
          Spacer(height: 48)
          // md-sys-color-surface-container-low; md-elev-1 single-layer approximation (M2 dual-layer pending)
          Container(width: 984, height: 900, color: "#FFFFFF", border: "#FFFFFF", rounded: 36, shadow: 1, p: 48, gesture: "tap") {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Image(src: "data:image/png;base64,", width: 888, height: 486, fit: "cover", label: "cards/photo_thanjavur")
              Spacer(height: 48)
              // md-sys-color-on-surface
              Text("Top 10 Cities to Visit in Tamil Nadu", size: 48, fontPx: 48, weight: "normal", color: "#000000", label: "cards/title_thanjavur")
              Spacer(height: 24)
              // md-sys-color-on-surface-variant
              Text("Number 10", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "cards/desc_1a")
              Spacer(height: 8)
              // md-sys-color-on-surface-variant
              Text("Thanjavur", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "cards/desc_1b")
              Spacer(height: 8)
              // md-sys-color-on-surface-variant
              Text("Thanjavur, Tamil Nadu", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "cards/desc_1c")
              Spacer(height: 48)
              Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
                // A3/M4: press feedback static placeholder
                // md-sys-color-primary
                Text("Action 1", size: 42, fontPx: 42, weight: "normal", color: "#6200EE", gesture: "tap", label: "cards/action_1")
                Spacer(width: 48)
                // A3/M4: press feedback static placeholder
                // md-sys-color-primary
                Text("Action 2", size: 42, fontPx: 42, weight: "normal", color: "#6200EE", gesture: "tap", label: "cards/action_2")
              }
            }
          }
          Spacer(height: 48)
          // md-sys-color-surface-container-low; md-elev-1 single-layer approximation (M2 dual-layer pending)
          Container(width: 984, height: 800, color: "#FFFFFF", border: "#FFFFFF", rounded: 36, shadow: 1, p: 48, gesture: "tap") {
            Column(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
              Image(src: "data:image/png;base64,", width: 888, height: 479, fit: "cover", label: "cards/photo_artisans")
              Spacer(height: 48)
              // md-sys-color-on-surface
              Text("Artisans of Southern India", size: 48, fontPx: 48, weight: "normal", color: "#000000", label: "cards/title_artisans")
              Spacer(height: 24)
              // md-sys-color-on-surface-variant
              Text("Silk Spinners", size: 42, fontPx: 42, weight: "normal", color: "#000000", label: "cards/desc_2")
              Spacer(height: 48)
              Row(p: 0, gap: 0, align: start, color: "#FFFFFF", border: "#FFFFFF") {
                // A3/M4: press feedback static placeholder
                // md-sys-color-primary
                Text("Action 1", size: 42, fontPx: 42, weight: "normal", color: "#6200EE", gesture: "tap", label: "cards/action_1b")
                Spacer(width: 48)
                // A3/M4: press feedback static placeholder
                // md-sys-color-primary
                Text("Action 2", size: 42, fontPx: 42, weight: "normal", color: "#6200EE", gesture: "tap", label: "cards/action_2b")
              }
            }
          }
        }
      }
    }
  }
}
