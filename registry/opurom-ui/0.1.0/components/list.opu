// List surface: a titled column of items. Item rows are added by the consumer
// inside the list body; this pins the container chrome.
component ListPanel(title: string) {
  Container(p: 12, rounded: 12, shadow: 2, bg: "#FFFFFF", border: "#DCE4EF") {
    Column(gap: 8) {
      Text("{title}", size: 13, color: "#5A6478")
    }
  }
}
