// NavBar: a top bar with a leading title and a trailing action label.
component NavBar(title: string, action: string) {
  Container(p: 12, rounded: 12, shadow: 2, variant: "secondary") {
    Row(gap: 12, align: center) {
      Text("{title}", size: 18)
      Spacer()
      Text("{action}", size: 13, tone: "info")
    }
  }
}
