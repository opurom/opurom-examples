// M3 card surfaces: elevated (elevation 1) and outlined. Flutter cards are
// inert, so the five states are container placeholders until A3 binds a gesture
// to a state layer; the tap event is a no-op fallback and never crashes.
// API   R: title. O: subtitle, state, animate.
//       X: content slots (M7), three-layer elevation shadow (M2), exact state
//       layer alpha (A3/M4), md-sys color token references (compiler prop limit).
// State default/hover/active/focus/disabled; normal maps to default, pressed to active.
// Events gesture = tap, empty action until a state binding exists.
// Bounds radius 12, padding 16, shadow 1; title clipped to 1 line, subtitle to
//       2; empty subtitle renders a title-only card; bad state is compiler-rejected.
// Example ElevatedCardM3("Cards", "Browse the catalog", "default", "ease")
component ElevatedCardM3(title: string, subtitle: string, state: string, animate: string) {
  Container(p: 16, rounded: 12, shadow: 1, state: "{state}", animate: "{animate}", gesture: tap, label: "elevated card") {
    Column(gap: 4) {
      Text("{title}", size: 16, maxLines: 1)
      Text("{subtitle}", size: 14, maxLines: 2)
    }
  }
}

// Outlined card: same surface and radius, 1px outline from the secondary variant.
// Example OutlinedCardM3("Colors", "Swatch list", "default", "ease")
component OutlinedCardM3(title: string, subtitle: string, state: string, animate: string) {
  Container(p: 16, rounded: 12, variant: "secondary", state: "{state}", animate: "{animate}", gesture: tap, label: "outlined card") {
    Column(gap: 4) {
      Text("{title}", size: 16, maxLines: 1)
      Text("{subtitle}", size: 14, maxLines: 2)
    }
  }
}
