// GlassCard(title, state): T2 card with glass lamina, soft shadow and one
// radius token; state is default/hover/active/focus/disabled.
component GlassCard(title: string, state: string) {
  Container(p: 16, rounded: 14, shadow: 2, glass: true, variant: "secondary", state: "{state}", animate: "ease") {
    Text("{title}", size: 16)
  }
}
