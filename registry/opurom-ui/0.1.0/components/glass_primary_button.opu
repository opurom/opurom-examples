// GlassPrimaryButton(label, state): T2 primary with the 180deg cyan-to-blue
// gradient, glass lamina and shadow; state is default/hover/active/focus/disabled.
component GlassPrimaryButton(label: string, state: string) {
  Container(p: 12, rounded: 12, shadow: 2, glass: true, gradient: "#2DD8FF,#006EFF", state: "{state}", animate: "ease") {
    Text("{label}", size: 16)
  }
}
