// Seeded particle field: a gradient panel scattered with deterministic dots.
import "pkg-theme/default.opu";

app Particles {

  ScrollView(p: 16) {
    Column(gap: 14) {
      Container(p: 20, rounded: 18, shadow: 4, gradient: "#097FEB,#005FCC", animate: ease) {
        Text("Particle field", size: 22, color: "#FFFFFF")
        Text("64 seeded dots over a two-stop gradient", size: 12, color: "#FFFFFF")
      }
      Container(height: 150, p: 14, rounded: 16, shadow: 3,
                gradient: "#097FEB,#101828",
                particles: "count=64,seed=7,radius=3,alpha=1024,color=#F2F6FF") {
        Text("seed = 7", size: 18, color: "#FFFFFF")
      }
    }
  }
}
